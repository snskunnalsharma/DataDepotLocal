<div id="dialog" title="Basic dialog">
    <p>This is the default dialog which is useful for displaying information. The dialog window can be moved, resized and closed with the 'x' icon.</p>
</div>

@{if (Model.AspNetRolePermissions.Count == 0)
{
    <h2><font color="red">No Associated Roles...</font></h2>
    <br />
}
else
{
    <table id="PermissionTable" style="width: 65%">
        <thead>
        <th style="width:40%">
            Role
        </th>
       
        <th>
            Action
        </th>
        </thead>
        @foreach (GarronT.CMS.Model.AspNetRolePermission role in Model.AspNetRolePermissions)
        {
            <tr>
                <td>
                    @Html.ActionLink(role.AspNetRole.Name, "RoleDetails", new { id = role.AspNetRole.Id })
                </td>
             
                <td>
                    <center>
                        <a href="@Url.Action("DeletePermission", "Admin", new { id = role.AspNetRole.Id, permissionId = Model.Permission_Id })" class="deleteRole" permissionid=@Model.Permission_Id roleid=@role.AspNetRole.Id>
                            <img src="@Url.Content("~/Content/images/bin.png")" alt="Delete Permission" />
                        </a>
                    </center>
                </td>
            </tr>
        }
    </table>
    <br />
}}