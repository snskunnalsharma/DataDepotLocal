@model GarronT.CMS.Model.AspNetRole

@{if (Model.AspNetRolePermissions.Count == 0)
{
    <h2><font color="red">No Associated Permissions...</font></h2>
    <br />
}
else
{
    <table id="PermissionTable" style="width: 65%">
        <thead>
        <th style="width:90%">
            Permission
        </th>
        <th>
            Action
        </th>
        </thead>
        @foreach (GarronT.CMS.Model.AspNetRolePermission permission in Model.AspNetRolePermissions.OrderBy(n => n.Permission_Id))
        {
            <tr>
                <td>
                    @Html.ActionLink(permission.AspNetPermission.PermissionDescription, "PermissionDetails", new { id = permission.Permission_Id })
                </td>
                <td>
                    <center>
                        <button type="button" class="deletePermission" id=@Model.Id permissionid=@permission.Permission_Id>Delete</button>
                       
                    </center>
                </td>
            </tr>
        }
    </table>
    <br />
}
}


<script type="text/javascript">

    $('.deletePermission').click(function () {
        debugger;
        var _id = $(this)[0].id;
        var _permissionId = $($(this)[0]).attr("permissionid")

        var _parameters = { id: _id, permissionId: _permissionId };
        var urlDeletePermissionFromRole = $('#urlDeletePermissionFromRoleReturnPartialView').val();

        $.ajax({
            url: urlDeletePermissionFromRole,
            type: "GET",
            data: _parameters,
            success: function (data, textStatus, jqXHR) {
                $('#PermissionsTable').html(data);
            }
        });
    });



