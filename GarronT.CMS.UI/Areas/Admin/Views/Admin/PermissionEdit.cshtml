@model GarronT.CMS.Model.AspNetPermission
@*<link href="~/Content/jquery-ui.css" rel="stylesheet" />
<script src="~/Content/jquery-1.10.2.js"></script>
<script src="~/Content/jquery-ui.js"></script>*@

@{
    ViewBag.Title = "Permission Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@Html.Hidden("urlAddRole2PermissionReturnPartialView", Url.Action("AddRole2PermissionReturnPartialView", "Admin"))

@Html.Hidden("urlDeleteRoleFromPermissionReturnPartialView", Url.Action("DeleteRoleFromPermissionReturnPartialView", "Admin"))

<script type="text/javascript">
    $(document).ready(function () {
        $(":input[type='submit']").button();
        $(":input[type='button']").button();
    });
</script>


<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel">
                    <header class="panel-heading">
                        <b>Permission Edit</b>

                    </header>
                    <div class="panel-body">
                        <div class="adv-table">
                            <div class="panel">
                                <fieldset>
                                    <legend>
                                        <h3>Permission Details</h3>
                                    </legend>
                                    @using (Html.BeginForm())
                                    {
                                        @Html.ValidationSummary(true)

                                        @Html.HiddenFor(model => model.Permission_Id)
                                        <table style='width: 100%'>
                                            <tr>
                                                <td style='width: 120px;font-weight: bold'>
                                                    @Html.LabelFor(model => model.PermissionDescription, "Description")
                                                </td>
                                                <td>
                                                    @Html.TextBoxFor(model => model.PermissionDescription, new { style = "width:450px" })
                                                    @Html.ValidationMessageFor(model => model.PermissionDescription)
                                                </td>
                                            </tr>
                                        </table>
                                        <br />
                                        <input type="submit" value="Update Permission" />
                                        <br />
                                        <br />
                                    }
                                </fieldset>
                            </div>
                            <br />
                            <div>
                                <br />
                                <fieldset>
                                    <legend>
                                        <h3>
                                            Roles Associated with this Permission
                                        </h3>
                                    </legend>

                                    <div id="RolesTable">
                                        @Html.Partial("_ListRolesTable4Permission", Model)
                                    </div>
                                    <div>
                                        @Html.Partial("_AddRole4Permission", Model)
                                    </div>
                                    <br />
                                    <div>
                                        @Html.ActionLink("Go to Permissions", "PermissionIndex", "Admin")
                                    </div>
                                </fieldset>

                            </div>


                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>




