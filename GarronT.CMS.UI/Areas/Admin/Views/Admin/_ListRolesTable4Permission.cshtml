@{if (Model.AspNetRolePermissions.Count == 0)
    {
        <h2><font color="red">No Associated Roles...</font></h2>
        <br />
    }
    else
    {
        <table id="PermissionTable" style="width: 65%">
            <thead>
            <th style="width:40%">
                Role
            </th>

            <th>
                Action
            </th>
            </thead>
            @foreach (GarronT.CMS.Model.AspNetRolePermission role in Model.AspNetRolePermissions)
            {
                <tr>
                    <td>
                        @Html.ActionLink(role.AspNetRole.Name, "RoleDetails", new { id = role.AspNetRole.Id })
                    </td>

                    <td>
                        <center>
                            <button type="button" class="deleteRole" permissionid=@Model.Permission_Id roleid=@role.AspNetRole.Id>Delete</button>
                           
                        </center>
                    </td>
                </tr>
            }
        </table>
        <br />
    }}