@model GarronT.CMS.Model.AspNetPermission




<script type="text/javascript">
    $(document).ready(function () {

        $('.deleteRole').click(function () {
            var _permissionId = $($(this)[0]).attr('permissionId');
            var _roleId = $($(this)[0]).attr('roleId');

            var urlDeleteRoleFromPermission = $('#urlDeleteRoleFromPermissionReturnPartialView').val();

            var _parameters = { permissionId: _permissionId, id: _roleId };
            $.ajax({
                url: urlDeleteRoleFromPermission,
                type: "GET",
                data: _parameters,
                success: function (data, textStatus, jqXHR) {
                    $('#RolesTable').html(data);
                }
            });
        });


