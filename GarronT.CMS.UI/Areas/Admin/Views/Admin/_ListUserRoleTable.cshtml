@{if (Model.AspNetRoles.Count == 0)
{
    <h2><font color="red">No Associated Roles...</font></h2>
    <br />
}
else
{
    <table id="RoleTable" style="width: 65%"  class="table table-advance table-condensed table-hover table-bordered table-responsive ">
        <thead>
        <th style="width: 90%">
            Role
        </th>
        <th>
            Action
        </th>
        </thead>
        @foreach (var role in Model.AspNetRoles.OrderBy(r => r.Name))
        {
            <tr>
                <td>
                    @Html.ActionLink(role.Name, "RoleDetails", new { id = role.Id , @class = "btn btn-success" })
                </td>
                <td>
                    
                    <center><img class="bin" src="@Url.Content("~/Content/images/bin.png")" alt="Delete" id="@role.Id" /></center>
                </td>
            </tr>
        }
    </table>
    <br />
}
}

