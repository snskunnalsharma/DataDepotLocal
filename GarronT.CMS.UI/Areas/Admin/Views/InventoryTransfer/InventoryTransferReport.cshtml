<section id="main-content">
    <section class="wrapper">

        <!--progress bar start-->
        <section class="panel rep_panel">

            <header class="panel-heading rep_header" style="background: #80B2DF; color: #fff;">
                Inventory Transfer Report
                <span class="tools pull-right">
                    <a id="haha" class="fa fa-chevron-down clickdive" href="javascript:;" style="color: #fff; padding-right:10px;"></a>
                </span>
            </header>
            <br />
            <div class="panel-body">

                <div class="row mbot05 sm-mbot1 xs-mbot1 xxs-mbot2">

                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 mbot05 md-mbot1  sm-mbot1 lg-nopaddingright md-nopaddingright sm-nopaddingright xs-mbot1 xxs-mbot2">
                        @Html.DropDownList("UtilityId", (IEnumerable<SelectListItem>)ViewBag.UtilityListItem, new { @class = "form-control chosen-select" })
                    </div>

                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 mbot05 md-mbot1 sm-mbot1 lg-nopaddingright md-nopaddingright sm-nopaddingright xs-mbot1 xxs-mbot2">
                        @Html.DropDownList("ProjectId", (List<SelectListItem>)ViewBag.ProjectList, new { @class = "form-control chosen-select" })
                    </div>

                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 mbot05  sm-mbot1 lg-nopaddingright md-nopaddingright xs-mbot1 xs-clear xxs-mbot2">
                        @Html.DropDownList("WarehouseId", (IEnumerable<SelectListItem>)ViewBag.WarehouseList, new { @class = "form-control chosen-select", @title = "Select Warehouse" })
                    </div>

                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 mbot05 sm-nopaddingright xs-mbot1 xxs-mbot2">
                        @Html.DropDownList("ProductId", (IEnumerable<SelectListItem>)ViewBag.ProductList, new { @class = "form-control chosen-select", @title = "Select Product" })
                    </div>

                </div>

                <div class="row">

                    <div class="col-lg-12 col-sm-12 col-xs-12 col-xxs-12 text-center">
                        <button id="btnTransferInventory" class="btn btn-success" type="button">Transfer Inventory</button>
                        <button id="btnSave" class="btn btn-success" type="button">Save</button>
                        <button id="btnReset" class="btn btn-danger" type="button">Reset</button>
                    </div>
                </div>
                <br />
                <div class="row mbot05 sm-mbot1 xs-mbot1 xxs-mbot2">

                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 lg-nopaddingright md-nopaddingright md-clear sm-nopaddingright xs-clear">
                        <label for="name" class="col-lg-2 col-sm-2 control-label"><strong>From Select Location</strong></label>
                        <select data-placeholder="From Select Location" name="ddlLocationFrom" id="ddlLocationFrom" class="form-control chosen-select"></select>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 lg-nopaddingright md-nopaddingright md-clear sm-nopaddingright xs-clear">
                        <label for="name" class="col-lg-2 col-sm-2 control-label"><strong>Available Quantity</strong></label>
                        <input type="text" id="availableQty" class="form-control chosen-select" readonly />
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 lg-nopaddingright md-nopaddingright md-clear sm-nopaddingright xs-clear">
                        <label for="name" class="col-lg-2 col-sm-2 control-label"><strong>To Select Location</strong></label>
                        <select data-placeholder="To Select Location" name="ddlLocationTo" id="ddlLocationTo" class="form-control chosen-select "></select>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6 col-xxs-12 lg-nopaddingright md-nopaddingright md-clear sm-nopaddingright xs-clear">
                        <label for="name" class="col-lg-2 col-sm-2 control-label"><strong>Enter Quantity</strong></label>
                        <input type="number" id="enterQty" placeholder="0" class="form-control chosen-select" />
                    </div>
                </div>


                <div class="table-responsive  rep_dyn_table" id="inventryReceiveDiv112">
                    <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                        <thead>
                            <tr>
                                <th width="15%"><input type="checkbox" name="select_all" value="tblHeaderValue" id="select-all" style="display:none">Select</th>
                                <th width="85%">Inventory Number</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </section>


    </section>
</section>

<link href="~/jquery-confirm-master/css/jquery-confirm.css" rel="stylesheet" />
<script src="~/jquery-confirm-master/js/jquery-confirm.js"></script>

<script>
    $(document).ready(function () {

        $("#InventoryReports").addClass('active');
        $("#subReports").addClass('block');

        $('.sub').find("*").removeClass('active');
        $('#liInventoryTransfer').addClass("active");


        $("#UtilityId").chosen({ placeholder_text_single: "Select Utility", no_results_text: "Oops, nothing found!" });
        $('#UtilityId').trigger('chosen:updated');

        $("#ProjectId").chosen({ placeholder_text_single: "Select Project", no_results_text: "Oops, nothing found!" });
        $('#ProjectId').trigger('chosen:updated');


        $("#WarehouseId").chosen({ placeholder_text_single: "Select Warehouse", no_results_text: "Oops, nothing found!" });
        $('#WarehouseId').trigger('chosen:updated');



        $("#ProductId").chosen({ placeholder_text_single: "Select Product", no_results_text: "Oops, nothing found!" });
        $('#ProductId').val("0").attr("selected", "selected").trigger('chosen:updated');

        $("#ReportType").chosen();
        $('#ReportType').val("0").attr("selected", "selected").trigger('chosen:updated');

        $('#dynamic-table').DataTable({ "language": { "emptyTable": "No Data To Show" } });

        $('#dynamic-table').DataTable({
            "bDestroy": true,
            "bserverSide": true,
            "bDeferRender": true,
            "bPaginate": false, //hide pagination
        });

        $("#ddlLocationFrom").chosen({ placeholder_text_single: "From Select Location", no_results_text: "Oops, nothing found!" });
        $('#ddlLocationFrom').val("0").attr("selected", "selected").trigger('chosen:updated');

        $("#ddlLocationTo").chosen({ placeholder_text_single: "To Select Location", no_results_text: "Oops, nothing found!" });
        $('#ddlLocationTo').val("0").attr("selected", "selected").trigger('chosen:updated');

        $("#divDetail").hide();
        $("#divSummary").show();
    });

    //numeric only validation code
    @*$('body').on('keypress', '.numeric-only', function (e) {
        var regex = new RegExp("^[0-9\b]+$");

        if (event.charCode == 0) {
            return true;
        }
        else {
            var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            if (!regex.test(key)) {
                event.preventDefault();
                return false;
            }
        }
    });*@


    $('#UtilityId').change(function () {

        $('#ProjectId').empty().trigger('chosen:updated');
        $('#WarehouseId').empty().trigger('chosen:updated');
        $('#ProductId').empty().trigger('chosen:updated');
        $("#WarehouseId").trigger("chosen:updated");
        $("#ProductId").trigger("chosen:updated");
        $("#ddlLocationFrom").empty();
        $("#ddlLocationFrom").trigger("chosen:updated");
        $("#ddlLocationTo").empty();
        $("#ddlLocationTo").trigger("chosen:updated");
        document.getElementById("availableQty").value = "";
        document.getElementById("enterQty").value = "";
        $('#dynamic-table').dataTable().fnClearTable();//clear the DataTable

        var value = $("#UtilityId option:selected")

        waitingDialog.show('Please Wait Loading Contacts...');
        var urlGetProjectList = $('#urlGetProject').val();
        $.ajax({
            type: 'GET',
            data: { "UtilityId": value.val() },
            url: urlGetProjectList,
            success: function (data) {

                if (data != null) {
                    $.each(data, function (index, item) {
                        if (index == 0) { $('#ProjectId').append($('<option></option>').val('0').html("")); }
                        $('#ProjectId').append($('<option></option>').val(item.ProjectId).html(item.ProjectName));
                    });
                }
                $('#ProjectId').trigger('chosen:updated');


                waitingDialog.hide();
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    });

    $('#ProjectId').change(function () {
        $('#WarehouseId').empty().trigger('chosen:updated');
        $('#ProductId').empty().trigger('chosen:updated');
        $('#LocationType').empty().trigger('chosen:updated');
        var value = $("#ProjectId option:selected")

        waitingDialog.show('Please Wait Loading Contacts...');
        var urlGetWarehouseAndProduct = $('#urlGetWarehouseAndProduct').val();
        $.ajax({
            type: 'GET',
            data: { "ProjectId": value.val() },
            url: urlGetWarehouseAndProduct,
            success: function (data) {
                if (data.WarehouseList != null) {
                    $.each(data.WarehouseList, function (index, item) {
                        if (index == 0) { $('#WarehouseId').append($('<option></option>').val('0').html("")); }
                        $('#WarehouseId').append($('<option></option>').val(item.WarehouseId).html(item.WarehouseName));
                    });
                }
                $('#WarehouseId').trigger('chosen:updated');

                if (data.ProductList != null) {
                    $.each(data.ProductList, function (index, item) {
                        if (index == 0) { $('#ProductId').append($('<option></option>').val('0').html("")); }
                        $('#ProductId').append($('<option></option>').val(item.Id).html(item.FieldValue));
                    });
                }
                $('#ProductId').trigger('chosen:updated');
                waitingDialog.hide();
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    });

    $('#ProductId').change(function () {
        $("#ddlLocationFrom").empty();
        $("#ddlLocationFrom").trigger("chosen:updated");
        $("#ddlLocationTo").empty();
        $("#ddlLocationTo").trigger("chosen:updated");
        document.getElementById("availableQty").value = "";
        document.getElementById("enterQty").value = "";
        getFromLocation();
    });

    $('#btnReset').click(function () {

        ResetAllData();
    })

    function ResetAllData() {
        $("#UtilityId").val('0').trigger("chosen:updated");
        $("#ProjectId").empty();
        $("#ProjectId").trigger("chosen:updated");

        $("#WarehouseId").empty();
        $("#WarehouseId").trigger("chosen:updated");

        $("#ProductId").empty();
        $("#ProductId").trigger("chosen:updated");

        $("#ddlLocationFrom").empty();
        $("#ddlLocationFrom").trigger("chosen:updated");

        $("#ddlLocationTo").empty();
        $("#ddlLocationTo").trigger("chosen:updated");

        document.getElementById("availableQty").value = "";
        document.getElementById("enterQty").value = "";

        $('#dynamic-table').dataTable().fnClearTable();//clear the DataTable
    };

    function getFromLocation() {

        $('#ddlLocationFrom').empty().trigger('chosen:updated');
        var value = $("#ProjectId option:selected")
        var ProductId = $("#ProductId").val();
        waitingDialog.show('Please Wait Loading Contacts...');
        var urlFromLocationList = $('#urlFromLocationList').val();
        $.ajax({
            type: 'GET',
            data: { "ProjectId": value.val(), ProductId: ProductId },
            url: urlFromLocationList,
            success: function (data) {

                $('#ddlLocationFrom').empty();
                if (data.LocationList != null) {
                    $.each(data.LocationList, function (index, item) {
                        if (index == 0) { $('#ddlLocationFrom').append($('<option></option>').val('0').html("")); }
                        $('#ddlLocationFrom').append($('<option></option>').val(item.LocationId).html(item.Location));
                    });
                }
                $('#ddlLocationFrom').trigger('chosen:updated');
                waitingDialog.hide();
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    };

    $('#btnTransferInventory').click(function () {
        debugger;

        var UtilityId = $("#UtilityId").val();
        if (UtilityId === '0' || UtilityId === '') {
            var $toast = toastr["error"]("Please, select utility", "Notification");
            return;
        }

        var ProjectId = $("#ProjectId").val();
        if (ProjectId === '0' || ProjectId === '') {
            var $toast = toastr["error"]("Please, select project", "Notification");
            return;
        }

        var WarehouseId = $("#WarehouseId").val();
        if (WarehouseId === '0' || WarehouseId === '') {
            var $toast = toastr["error"]("Please, select warehouse", "Notification");
            return;
        }

        var ProductId = $("#ProductId").val();
        if (ProductId === '0' || ProductId === '') {
            var $toast = toastr["error"]("Please, select product", "Notification");
            return;
        }

        var LocationFromValue = $("#ddlLocationFrom").val();
        if (LocationFromValue === '0' || LocationFromValue === '') {
            var $toast = toastr["error"]("Please, select from location", "Notification");
            return;
        }

        var LocationToValue = $("#ddlLocationTo").val();
        if (LocationToValue === '0' || LocationToValue === '') {
            var $toast = toastr["error"]("Please, select to location", "Notification");
            return;
        }

        var availableQty = document.getElementById("availableQty").value;
        if (availableQty === '0') {
            var $toast = toastr["error"]("No available inventory", "Notification");
            return;
        }

        var enterQty = document.getElementById("enterQty").value;
        if (enterQty === '') {
            var $toast = toastr["error"]("Please enter quantity", "Notification");
            return;
        }
        else if (enterQty === '0') {
            var $toast = toastr["error"]("Please enter a valid quantity", "Notification");
            return;
        }
        else if (parseInt(availableQty) < parseInt(enterQty)) {
            var $toast = toastr["error"]("The number of entered quantity cannot be more than the available quantity.", "Notification");
            return;
        }


        waitingDialog.show('Loading Please Wait...');
        var urlGetInventoryData = $("#urlGetInventoryData").val();

        $.ajax({
            type: 'POST',
            url: urlGetInventoryData,
            async: true,
            data: { projectId: ProjectId, warehouseId: WarehouseId, productId: ProductId, locationFromValue: LocationFromValue, transferQty: enterQty },
            success: function (data) {
                waitingDialog.hide();
                // debugger;
                //console.log("result == " + JSON.stringify(data));
                if (data.success == "false") {
                    var $toast = toastr["error"](data.ErrorMessage, "Notification");
                }
                else {
                    BindData(data.WarehouseStockReportData);
                }

            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                console.log("error " + textStatus);
                console.log("incoming Text " + jqXHR.responseText);
                var $toast = toastr["error"]("something seems wrong", "Notification");
            }

        })
    });

    $('#ddlLocationFrom').change(function () {
        getInventoryQty();
        getToLocation();
    });

    function getInventoryQty() {

        debugger;

        var UtilityId = $("#UtilityId").val();
        if (UtilityId === '0' || UtilityId === '') {
            var $toast = toastr["error"]("Please, select utility", "Notification");
            return;
        }

        var ProjectId = $("#ProjectId").val();
        if (ProjectId === '0' || ProjectId === '') {
            var $toast = toastr["error"]("Please, select project", "Notification");
            return;
        }

        var WarehouseId = $("#WarehouseId").val();
        if (WarehouseId === '0' || WarehouseId === '') {
            var $toast = toastr["error"]("Please, select warehouse", "Notification");
            return;
        }

        var ProductId = $("#ProductId").val();
        if (ProductId === '0' || ProductId === '') {
            var $toast = toastr["error"]("Please, select product", "Notification");
            return;
        }

        var LocationFromValue = $("#ddlLocationFrom").val();
        if (LocationFromValue === '0' || LocationFromValue === '') {
            var $toast = toastr["error"]("Please, select from location", "Notification");
            return;
        }

        waitingDialog.show('Loading Please Wait...');
        var urlGetStockReport = $("#urlGetStockReport").val();

        $.ajax({
            type: 'POST',
            url: urlGetStockReport,
            async: true,
            data: { projectId: ProjectId, warehouseId: WarehouseId, productId: ProductId, LocationFromValue: LocationFromValue },
            success: function (data) {
                waitingDialog.hide();
                // debugger;
                if (data.success == "false") {
                    var $toast = toastr["error"](data.ErrorMessage, "Notification");
                }
                else {
                    document.getElementById("availableQty").value = data.ablInventory;
                }

            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                console.log("error " + textStatus);
                console.log("incoming Text " + jqXHR.responseText);
                var $toast = toastr["error"]("something seems wrong", "Notification");
            }

        })
    };


    function getToLocation() {
        debugger;
        $('#ddlLocationTo').empty().trigger('chosen:updated');
        var value = $("#ProjectId option:selected");
        var ProductId = $("#ProductId").val();
        var LocationFromValue = $("#ddlLocationFrom").val();
        waitingDialog.show('Please Wait Loading Contacts...');
        var urlToLocationList = $('#urlToLocationList').val();
        $.ajax({
            type: 'GET',
            data: { "ProjectId": value.val(), ProductId: ProductId, LocationFromValue: LocationFromValue },
            url: urlToLocationList,
            success: function (data) {
                debugger;
                $('#ddlLocationTo').empty();
                if (data.LocationList != null) {
                    $.each(data.LocationList, function (index, item) {
                        if (index == 0) { $('#ddlLocationTo').append($('<option></option>').val('0').html("")); }
                        $('#ddlLocationTo').append($('<option></option>').val(item.LocationId).html(item.Location));
                    });
                }
                $('#ddlLocationTo').trigger('chosen:updated');
                waitingDialog.hide();
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    };

    function BindData(varData) {

        oTable = $('#dynamic-table').dataTable(
            {

                "bDestroy": true,
                "bserverSide": true,
                "bDeferRender": true,
                "bPaginate": false, //hide pagination
                //"bFilter": false, //hide Search bar
                //"bInfo": false, // hide showing entries

                "oLanguage": {
                    "sLengthMenu": '_MENU_ Records per page'
                },
                "aaData": varData,
                // "aaSorting": [[3, "asc"]],
                "aoColumns": [

                    { "bSearchable": false, "mData": null },
                    @*{ "mData": "WarehouseName" },
                    { "mData": "Location" },
                    { "mData": "CategoryName" },
                    { "mData": "ProductName" },
                    { "mData": "ProductDescription" },
                    { "mData": "PartNumber" },
                    { "mData": "UPCCode" },
                    { "mData": "UtilityName" },
                    { "mData": "Make" },
                    { "mData": "MeterType" },
                    { "mData": "MeterSize" },*@
                    { "mData": "serialnumber" },
                    @*{ "mData": "BalanceQty" },
                    { "bSearchable": false, "mData": null },*@

                ],
                "aoColumnDefs": [
                    {
                        "mRender": function (data, type, full, row) {
                            return '<input type="checkbox" id=' + full.serialnumber + ' value=' + full.serialnumber + ' name="id[]"  checked>';
                        },
                        "aTargets": [0]
                    }
                ],

            }), $('.dataTables_filter input').attr('maxlength', 50);
    }

    $('#btnSave').click(function () {
        debugger;
        var invList = [];
        $("#dynamic-table input:checkbox:checked").map(function () {

            if ($(this).val() != "tblHeaderValue") // Removed this value because this is table header value
            {
                invList.push($(this).val());
            }
        }).get();

        if (invList.length > 0) {
            SaveTransferInventory(invList);
        }
    });


    function SaveTransferInventory(invList) {

        var value = $("#ProjectId option:selected");
        var ddlLocationTo = $("#ddlLocationTo").val();

        waitingDialog.show('Please Wait...');
        var urlTransferInventory = $('#urlTransferInventory').val();

        $.ajax({
            url: urlTransferInventory,
            data: { "ProjectId": value.val(), ToLocation: ddlLocationTo, TransferInventoryList: invList },
            type: 'POST',
            success: function (data) {
                waitingDialog.hide();
                if (data.Success) {
                    var $toast = toastr["success"](data.Message, "Success Notification");
                    ResetAllData();
                }
                else {
                    var $toast = toastr["error"](data.Message, "Error Notification");
                }
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });
    }
</script>
