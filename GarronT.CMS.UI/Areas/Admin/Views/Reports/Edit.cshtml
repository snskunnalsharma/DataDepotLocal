<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Responsive Step Wizard Form</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <style type="text/css">
        .stepwizard {
            display: table;
            width: 100%;
            position: relative;
            background: #80B2DF;
            padding: 10px 0;
        }

        .stepwizard-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            flex-wrap: wrap;
        }

        .stepwizard-step {
            text-align: center;
            position: relative;
            padding: 10px;
            flex: 1;
            min-width: 80px;
        }

        .stepwizard-step-circle {
            display: block;
            background: #eee;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid #d5d5da;
            margin: auto;
        }

        .stepwizard-step p {
            margin-top: 10px;
            color: #fff;
        }

        .btn-circle {
            width: 30px;
            height: 30px;
            text-align: center;
            padding: 6px 0;
            font-size: 12px;
            line-height: 1.428571429;
            border-radius: 15px;
            margin-top: -20px;
            color: #fff !important;
        }

        .multiselect {
            width: 100%;
            padding: 3px;
        }

        .labelcolor {
            color: #fff;
        }

        .next, .prev {
            background: #2196F3;
        }

        #loading {
            display: none;
        }

        .toast-top-center {
            margin-top: -50px;
        }

         (max-width: 768px) {
            .stepwizard-row {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }

            .form-horizontal .form-group {
                margin-left: 0;
                margin-right: 0;
            }

            .panel-body {
                overflow-x: auto;
            }

            .add-task-row {
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>

    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner">Searching things...</p>
        </div>
    </div>

    <section id="main-content">
        <section class="wrapper">
            <div class="row">
                <div class="col-xs-12">
                    <section class="panel">
                        <header class="panel-heading">
                            <b>Reports</b>
                        </header>

                        <div class="panel-body panel_top">
                            <div class="stepwizard">
                                <div class="stepwizard-row setup-panel">
                                    <div class="stepwizard-step stepwizard-step-circle">
                                        <select id="ss" name="ss" class="form-control"></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <form role="form" action="" id="fromsave" method="post" class="form-horizontal" style="background: rgb(190, 210, 230);">
                <div class="row setup-content" id="step-1">
                    <div class="col-xs-12">
                        <div class="col-xs-12 text-right">
                            <button class="btn btn-primary nextBtn btn-lg" type="button">Next</button>
                        </div>
                    </div>
                </div>

                <div class="row setup-content" id="stepS-2" style="display:none">
                    <div class="col-xs-12">
                        <div class="col-xs-6">
                            <button class="btn btn-primary previous btn-lg" type="button">Previous</button>
                        </div>
                        <div class="col-xs-6 text-right">
                            <button class="btn btn-primary nextBtn btn-lg" type="button">Next</button>
                        </div>
                    </div>
                </div>

                <div class="row setup-content" id="step-3" style="display: none; padding-top: 1%;">
                    <div class="col-xs-12">
                        <div class="form-group">
                            <div class="task-content col-md-offset-2">
                                <ul class="task-list" id="ulServicePrice"></ul>
                            </div>
                        </div>
                        <div class="col-xs-6">
                            <button class="btn btn-primary previous btn-lg" type="button">Previous</button>
                        </div>
                        <div class="col-xs-6 text-right">
                            <button class="btn btn-primary nextBtn btn-lg" type="button">Next</button>
                        </div>
                    </div>
                </div>

                <div class="row setup-content" id="step-4" style="display: none">
                    <div class="col-xs-12">
                        <div class="form-group">
                            <div class="row" style="margin-top:5px; margin-bottom:5px;">
                                <div class="col-sm-12 col-md-2">
                                    Select Standard Fields
                                </div>
                                <div class="col-sm-12 col-md-5 add-task-row">
                                    <button class="btn btn-success btn-sm pull-left" type="button" id="btnMoveAll">Move All Standard Fields</button>
                                </div>
                            </div>

                            <div id="fieldChooser" tabindex="1">
                                <div id="sourceFields"> </div>
                                <div class="row" style="margin-top:5px; margin-bottom:5px;">
                                    <div class="col-sm-12 col-md-4">
                                        Drop Standard Fields Here
                                    </div>
                                    <div id="destinationFields"> </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-6">
                            <button class="btn btn-primary previous btn-lg" type="button">Previous</button>
                        </div>
                        <div class="col-xs-6 text-right">
                            <button class="btn btn-primary nextBtn btn-lg" type="button">Next</button>
                        </div>
                    </div>
                </div>

                <div class="row setup-content" id="step-5" style="display: none">
                    <div class="col-xs-12">
                        <div class="form-group" style="margin-top:10px;">
                            <div class="panel-body">
                                <div class="adv-table table-responsive">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-8">
                                            <a class="btn btn-success" id="btnAddCustField" data-toggle="modal" data-backdrop="static" href="#myModalCustomField">
                                                Add New Custom Field <i class="fa fa-plus"></i>
                                            </a>
                                        </div>
                                        <div class="col-xs-12 col-sm-4 show_deactive">
                                            <label>
                                                <input type="checkbox" name="showDeactivate" id="chkShowDeactivate"> Show Deactivated Records
                                            </label>
                                        </div>
                                    </div>
                                    <table id="dynamic-table" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th width="25%">Custom Field Name</th>
                                                <th width="5%">Action</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-6">
                            <button class="btn btn-primary previous btn-lg" type="button">Previous</button>
                        </div>
                        <div class="col-xs-6 text-right">
                            <button class="btn btn-primary nextBtn btn-lg" type="button">Next</button>
                        </div>
                    </div>
                </div>
            </form>
        </section>
    </section>

    <!-- Bootstrap JS (optional but recommended) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
</body>
</html>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
<link href="~/Scripts/js/style.css" rel="stylesheet" />
<link href="~/Scripts/js/jquery-ui.css" rel="stylesheet" />
<script src="~/Scripts/js/jquery-ui.js"></script>
<script src="~/Scripts/js/fieldChooser.js"></script>
<link href="~/Content/MSTS/admin/css/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/Content/MSTS/admin/js/bootstrap-multiselect.js"></script>
<script src="~/Scripts/Admin/Reports.js"></script>
