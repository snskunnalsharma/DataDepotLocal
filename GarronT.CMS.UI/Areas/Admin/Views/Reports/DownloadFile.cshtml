@{
    ViewBag.Title = "ReportPDF";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutReport.cshtml";
}

@Html.Hidden("btnpdfPrev", Url.Action("DownloadFile", "Reports"), new { target = "_blank" })

@Html.Hidden("urlstoredPDFIDs", Url.Action("GetPDFDownloadID", "Reports"))
@Html.Hidden("urlGeneratePDFbyID", Url.Action("DownloadFile", "Reports"))




<style>
    .pdfdiv {
        /*margin-right: -11px;
        margin-left: -13px;*/
        margin: 0 auto;
    }

    iframe {
        /*overflow:visible;*/
    }

    .wrapper {
        overflow: hidden;
    }

    @@media (max-width:320px) {
        .wrapper {
            margin-bottom: -1% !important;
            overflow: hidden;
            height: 46em !important;
            margin-top: -8%;
        }

        iframe {
            height: 40em;
        }
    }

    @@media only screen and (min-width:321px)and (max-width:410px) {
        .wrapper {
            overflow: auto;
            height: 46.4em !important;
        }
    }

    @@media only screen and (min-width:321px)and (max-width:410px) {
        .wrapper {
            overflow: auto;
            height: 46.4em !important;
        }
    }

    @@media only screen and (min-width:768px) and (max-width:1023px) {
        .pdf-table-responsive {
            height: 30em !important;
            overflow-y: scroll !important;
        }
    }
    /*@@media only screen and (min-width:321px)and (max-width:767px) {
        .wrapper {

            overflow: hidden;
            height: 46.4em !important;
        }
    }*/
</style>

@*<section id="main-content">*@
<section class="wrapper" style="margin-top: 0px; padding: 0px;">
    <!-- page start-->
    <div class="row">
        <div class="col-lg-12">
            <section class="panel">

                <div class="panel-body">
                    <div class="row">
                        <div class="form-group" style="text-align:center;margin-top: 8px;">
                            @if (@ViewBag.Prevbutton == true)
                            {
                                <input type="button" class="btn btn-info" id="btnpdfPrev" onclick="GetPreviousRecord();" value="Previous" />
                            }

                            @if (@ViewBag.Nextbutton == true)
                            {
                                <input type="button" class="btn btn-info" id="btnpdfNext" onclick="GetNextRecord();" value="Next" />
                            }

                        </div>

                        <div class="form-group" style="text-align:right;margin-top: -20px;margin-top: -18px;margin-right: 97px;margin-bottom: 10px;">
                            @if (@ViewBag.CategoryType == "COMPLETED")
                            {
                                <input type="button" value="Download" class="btn btn-success" onclick="location.href='@Url.Action("DownloadSinglePDF", "Reports", new { FormID = @ViewBag.FormID, UploadID = @ViewBag.UploadID })'" />


                                <input type="button" id="PrintReport" value="Print" class="btn btn-success" />
                            }
                            else if (@ViewBag.CategoryType == "RTU" || @ViewBag.CategoryType == "SKIP")
                            {

                                <input type="button" value="Download" class="btn btn-success" onclick="location.href='@Url.Action("DownloadSinglePDF_SkipRTU", "Reports", new { UploadID = @ViewBag.UploadID })'" />
                                <input type="button" id="PrintReportSkipRTU" value="Print" class="btn btn-success" />
                            }
                        </div>

                    </div>

                    @if (@ViewBag.CategoryType == "COMPLETED")
                    {
                        <div class="row pdfdiv" style="width:1150px">
                            <iframe name="ifr" width="100%" id="pdfIframe" scrolling="auto" src="@Url.Action("GeneratePDF")" onload="resizeIframe(this)"></iframe>

                        </div>
                    }
                    else if (@ViewBag.CategoryType == "RTU" || @ViewBag.CategoryType == "SKIP")
                    {
                        <div class="row pdfdiv" style="width:1150px">
                            <iframe name="ifr" width="100%" id="pdfIframe" scrolling="auto" src="@Url.Action("GeneratePDF_SkipRTU")" onload="resizeIframe(this)"></iframe>
                        </div>
                    }

                </div>
            </section>
        </div>
    </div>
</section>
@*</section>*@

