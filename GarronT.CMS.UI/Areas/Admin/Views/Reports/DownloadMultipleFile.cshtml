    }

    #divsectionData {
    }


    .fieldname {
        text-align: left;
        width: 20%;
        padding: 5px;
        font-family: Arial;
        font-size: 14px;
    }

    .fieldData {
        width: 80%;
        padding: 5px;
    }

    .formname {
        font-family: Arial;
        font-size: 18px;
        color: #0094ff;
    }

    .sectionname {
        padding-left: 20px;
