<script>
    function transferData() {
        // Get input values dynamically
        const currentInstallerId = document.getElementById('InstallerId').value; // Fetch text content from the span
        const newInstallerId = document.getElementById('ddlReopenInstaller_modalAuditorAllocation').value; // New installer ID from the dropdown
        const uploadId = document.getElementById('FkUploadId').value; // Upload ID (hidden input)
        const ProjectId = document.getElementById('AUProjectId').value; // Project ID (hidden input)
        const FormId = document.getElementById('FormId').value; // Form ID (hidden input)

        // Validate if newInstallerId is selected (not 0 or null)
        if (!newInstallerId || newInstallerId === '0') {
          //  alert("Please select installer first!");
            var $toast = toastr["error"]('Please select installer first!', "Notification");
            return; // Stop further execution if no installer is selected
        }

        // Validate other fields
        if (!currentInstallerId || !uploadId || !ProjectId || !FormId) {
            alert("All fields are required!");
            return;
        }

        // Show an alert with the values of the input fields
       // alert(`Current Installer ID: ${currentInstallerId}\nNew Installer ID: ${newInstallerId}\nUpload ID: ${uploadId}\n Project ID: ${ProjectId} \n Form ID: ${FormId}`);

        // Prepare request data
        const requestData = {
            uploadId: parseInt(uploadId, 10),
            ProjectId: parseInt(ProjectId, 10),
            installerId: parseInt(currentInstallerId, 10),
            newInstallerId: parseInt(newInstallerId, 10),
            FormId: parseInt(FormId, 10),
        };

        // Perform AJAX request
        fetch('/Reports/TransferInstallerData', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(requestData),
        })
            .then((response) => response.json())
            .then((data) => {
                if (data.success) {
                 //   alert(data.message); // Display success message
                    var $toast = toastr["success"](data.message, "Notification");
                    $('#modalAuditorAllocation').modal('hide');
                    $('#btnSearch').click();
                } else {
                    alert("Error: " + data.message); // Display error message
                }
            })
            .catch((error) => {
                console.error('Error:', error);
                alert("An error occurred while transferring data. Please try again.");
            });
    }

    $(document).ready(function () {
        $('#ddlReopenInstaller_modalAuditorAllocation').chosen({
            placeholder_text_single: "Select Installer",
            allow_single_deselect: true,
            no_results_text: "No installer found!",
            width: "40%"
        });
    });
</script>

