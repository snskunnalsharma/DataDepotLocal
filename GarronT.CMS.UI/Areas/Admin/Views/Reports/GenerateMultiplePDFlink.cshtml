    }

    .FieldValuestd {
        padding: 5px;
        border-right: 1px solid #000;
        color: #000000;
        font-size: 14px;
    }

    .fieldvalue {
        font-weight: 500;
        font-size: 13px;
    }

    .wrapper {
        margin-top: 0px !important;
        padding: 0px 15px !important;
    }

    .latlongspan {
        font-size: 13px;
