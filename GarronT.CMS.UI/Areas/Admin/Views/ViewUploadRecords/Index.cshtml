<div id="loading">
    <div id="loadingcontent">
        <p id="loadingspinner">
            Searching things...
        </p>
    </div>
</div>



<!-- page start-->


<section id="main-content">
    <section class="wrapper site-min-height">
        <div class="row">
            <div class="col-lg-12">
                <!--progress bar start-->
                <section class="panel">
                    <header class="panel-heading">
                        <b>Inventory View</b>
                    </header>
                    <div class="row" style="">
                        <div class="col-lg-12">
                            <div class="container-fluid con_fluid_new">
                                <div class="panel-body panel_top">
                                    <div class="row setup-content" style="margin-bottom: 5px;">
                                        <div class="table-responsive col-lg-12 rep_dyn_table">
                                            <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                                <thead>
                                                    <tr>
                                                        <th width="5%">Request Id</th>
                                                        <th>Request Type</th>
                                                        <th>Project Name</th>
                                                        <th>Warehouse Name</th>
                                                        <th>Created Date</th>
                                                        <th>User Name</th>
                                                        <th width="5%">View Details</th>
                                                      
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                           
                                                            <td style="text-align: center;">
                                                                @item.RequestId
                                                            </td>
                                                            <td>
                                                                @item.uploadType
                                                            </td>
                                                            <td>
                                                                @item.ProjectName
                                                            </td>
                                                            <td>
                                                                @item.WarehouseName
                                                            </td>
                                                            <td>
                                                                @item.DeviceDateTime
                                                            </td>
                                                            <td>
                                                                @item.UserName
                                                            </td>
                                                           
                                                            <td style="text-align: center;">
                                                                <a href="@Url.Action("ViewUploadRecords", "ViewUploadRecords", new { Id = @item.RequestId })" class="btn btn-primary btn-xs"><i class="fa fa-eye"></i></a>
                                                               @*@Html.ActionLink("view", "ViewUploadRecords", "ViewUploadRecords", new { Id = @item.RequestId }, new { @class = "btn btn-primary btn-xs rep_btn_danger" })*@
                                                             </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>

<script>
    $(document).ready(function () {
        $("#InventoryManagement").addClass('active');
        $("#subInventoryManagement").addClass('block');

        $('.sub').find("*").removeClass('active');
        $('#liviewInventry').addClass("active");



        $('#dynamic-table').DataTable({
            "language": { "emptyTable": "No Data To Show" },
            "aaSorting": [],
            "order": [],
        });
    })



</script>

