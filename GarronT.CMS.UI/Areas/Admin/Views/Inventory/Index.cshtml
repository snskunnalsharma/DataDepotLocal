<!-- page start-->


<section id="main-content">
    <section class="wrapper site-min-height">
        <div class="row">
            <div class="col-lg-12">
                <!--progress bar start-->
                <section class="panel">
                    <header class="panel-heading">
                        <b> Inventory Management <label id="lblProjectName"></label> </b>
                    </header>
                    <div class="row" style="">
                        <div class="col-lg-12">
                            <div class="container-fluid con_fluid_new">

                                <div class="panel-body panel_top">
                                    <div class="row setup-content" style="margin-bottom: 5px;">

                                        @*<form role="form" action="" id="fromsave" method="post" style=" background rgb(190, 210, 230);" class="form-horizontal">*@


                                        <div class="col-lg-12">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-11">
                                                <span style="font-size:10px;">*Note - Only .xlsx files are supported for upload.</span>
                                                @{
                                                    var href = System.Configuration.ConfigurationManager.AppSettings["InventorySampleFile"].ToString();
                                                }
                                                <a href="@href" target="_blank">Download Sample File</a>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="col-md-12">

                                                <div class="col-md-1"></div>
                                                <div class="col-lg-12" style="margin-bottom:10px;">
                                                    <div class="form-group" style="margin-top:15px;">
                                                        <div class="col-lg-1"></div>
                                                        <div class="col-lg-3">
                                                            <select id="ddlWareHouse" data-placeholder="Select Warehouse" class="form-control chosen-select "></select>
                                                        </div>
                                                        <div class="col-lg-7">
                                                            <label class="control-label col-lg-3">Upload Data<span style="color:red">*</span></label>
                                                            <input maxlength="200" type="file" id="fileInput" required="required" placeholder="Upload Inventory Data" class="col-lg-4 col-sm-4 col-xs-12" />
                                                            <input class="btn btn-success " type="button" id="btn_Upload" value="Upload" style="margin-left:10px;" />
                                                        </div>
                                                        <div class="col-lg-1"></div>
                                                    </div>
                                                </div>


                                                <div class="table-responsive col-lg-12 rep_dyn_table">
                                                    <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                                        <thead>
                                                            <tr>
                                                                <th width="5%">Upload Number</th>
                                                                <th width="15%">Meter Make</th>
                                                                <th width="10%">Meter Type</th>
                                                                <th width="10%">Meter Size</th>
                                                                <th width="10%">Serial Number</th>
                                                                <th width="20%">Description</th>
                                                                <th width="10%">Quantity</th>
                                                                <th width="10%">Is Duplicate</th>
                                                                <th width="10%">Action</th>
                                                            </tr>
                                                        </thead>
                                                    </table>
                                                </div>



                                            </div>
                                        </div>
                                        @*</form>*@
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>

<div class="modal fade modal-dialog-center" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content-wrap">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Edit Record</h4>
                </div>
                <div class="modal-body">
                    <div class="panel-body">
                        <form id="UploadForm" class="cmxform form-horizontal tasi-form">
                            <input type="hidden" name="Id" id="txtId" class="inputclass form-control" />
                            <div class="form-group ">
                                <label for="name" class="col-lg-4 col-sm-3 col-xs-12 control-label">Meter Type</label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="MeterType" maxlength="50" id="txtMeterType" class="inputclass form-control  " />
                                </div>
                            </div>
                            <div class="form-group ">
                                <label for="name" class="col-lg-4 col-sm-3 col-xs-12 control-label">Meter Size</label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="MeterSize" maxlength="50" id="txtMeterSize" class="inputclass form-control Decimal-Only " />
                                </div>
                            </div>
                            <div class="form-group ">
                                <label for="name" class="col-lg-4 col-sm-3 col-xs-12 control-label">Serial Number</label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="SerialNo" maxlength="50" id="txtSerialNo" class="inputclass form-control Decimal-Only" />
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSave" class="btn btn-success" type="button">Save</button>
                    <button class="btn btn-danger" id="btnCancel" type="button">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

