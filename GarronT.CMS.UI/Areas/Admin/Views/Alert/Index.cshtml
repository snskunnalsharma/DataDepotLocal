@{
    ViewBag.Title = "Alert Master";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@Html.Hidden("urlAlertList", Url.Action("GetActiveDeactiveAlertList", "Alert"))
@Html.Hidden("urlGetEditData", Url.Action("GetOldData", "Alert"))
@Html.Hidden("urlUserList", Url.Action("GetUserName", "Alert"))
@Html.Hidden("urlGetuserDetails", Url.Action("GetUserDetails", "Alert"))
@Html.Hidden("urlCreateData", Url.Action("Create", "Alert"))
@Html.Hidden("urlOldData", Url.Action("GetEmailConfigureOldData", "Alert"))


<!-- page start-->

<section id="main-content">
    <section class="wrapper ">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12" id="m">

                <section class="panel">

                    <div class="row" style="">

                        <div class="col-lg-12">
                            <header class="panel-heading alrt-heading">
                                <b>Alert Master </b>

                            </header>
                            @*<div class="container-fluid con_fluid_new">*@
                            <div class="container-fluid ">

                                <div class="panel-body">

                                    @*<div class="row">

                    <div class="col-lg-8 col-md-8 col-xs-8 show_deactive deactivated_records">
                        <input type="checkbox" name="showDeactivate" id="chkShowDeactivate" />Show Deactivated Records
                    </div>
                </div>*@
                                    <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                        <thead>
                                            <tr>
                                                @*<th width="40%">Project Name</th>*@
                                                <th width="90%">Alert Name</th>

                                                <th width="10%">Action</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>

                        </div>

                        <div class="clearfix"></div>

                    </div>


                </section>
            </div>
        </div>
    </section>
</section>

<!-- Modal for Add /Edit Dialog -->
<div class="modal fade modal-dialog-center" id="myModal" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content-wrap">
            <div class="modal-content modal-md alert-mdlg">
                <div class="modal-header">
                    <button type="button" class="close" id="btnClose" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Configure Email</h4>
                </div>
                <div class="modal-body alert-mod-bdy">
                    <form id="form3" class="cmxform form-horizontal tasi-form">
                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label alert-nm" style="white-space:nowrap;">Alert Name <span style="color:red">*</span></label>
                            <div class="col-lg-8 col-xs-8 col-sm-8 clnt-err">
                                <input type="hidden" name="AlertId" id="AlertId" class="inputclass form-control" />
                                <input type="text" readonly="readonly" name="alertname" id="txtalertname" class="inputclass form-control " maxlength="200" />
                            </div>
                        </div>
                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label alert-subj">Subject <span style="color:red">*</span></label>
                            <div class="col-lg-8 col-xs-8 col-sm-8">
                                <input type="text" name="Subject" id="txtSubject" class="inputclass form-control " maxlength="200" />
                            </div>

                        </div>

                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label alert-msg">Message</label>
                            <div class="col-lg-8  col-xs-12 col-sm-8">
                                <textarea cols="25" name="Message" id="txtMessage" class="ckeditor form-control" maxlength="500" rows="7"></textarea>

                            </div>

                        </div>

                        <!--wysihtml5 start-->
                        @*<div class="row">
                                <div class="col-md-12">
                                    <section class="panel">

                                        <div class="panel-body">
                                            <form action="#" class="form-horizontal tasi-form">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3">WYSIHTML5 Editor</label>
                                                    <div class="col-md-9">
                                                        <textarea class="ckeditor form-control" rows="10"></textarea>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </section>
                                </div>
                            </div>*@
                        <!--wysihtml5 end-->

                        <div class="form-group adm-dv">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label alert-adm">Admin </label>

                            <div class="col-lg-6  col-xs-8 col-sm-8">
                                <div id="divuserlist">
                                    <div class="chosen-container chosen-container-single " style="width: 100%;" title="" id="ddluserlist">
                                        <a class="chosen-single chosen-default" id="ancUser_chosen" tabindex="-1"><span class="ddlHeader" id="userlistHeader">Select User</span><div><b></b></div></a>
                                        <div class="chosen-drop">
                                            @*<div class="chosen-search"><input type="text" class="txtfilterall" onkeyup="filteruserlist(this)" autocomplete="off"></div>*@

                                            <ul id="uluser" class="chosen-results " style="max-height: 118px;"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <button id="btnAdd" style="visibility:hidden" class="btn btn-success" type="button">ADD</button>
                            </div>
                        </div>
                    </form>
                    <form id="form4" class="cmxform form-horizontal tasi-form">

                        <div class="table-responsive tab-scrll">
                            <table id="dynamic-tableCategory" class="display table table-bordered table-striped dataTable model-table" aria-describedby="dynamic-table_info">
                                <thead>
                                    <tr>

                                        <th width="30%"> Name</th>

                                        <th width="30%">Mobile No.</th>
                                        <th width="40%">Email-Id</th>

                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button id="btnSave" class="btn btn-success" type="button">Save</button>
                    <button class="btn btn-danger" id="btnCancel" type="button">Cancel</button>
                    <button class="btn btn-default" id="btnReset" type="button">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>




