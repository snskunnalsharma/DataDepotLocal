@model GarronT.CMS.Model.BO.AspNetPermissionVM
@{
    ViewBag.Title = "User Role Rights";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}



@Html.Hidden("urlAssignPermissionsToRole", Url.Action("AssignPermissionRole", "Permission"))

<style>
    .permission-rights-page .panel-heading {
        border-bottom: 1px solid #e2e7ec;
        padding: 14px 18px;
    }

    .permission-rights-page .panel-heading b {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
    }

    .permission-rights-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .permission-rights-legend {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        font-size: 12px;
        color: #5c6c7c;
        padding: 8px 12px;
        background: #f4f6f8;
        border-radius: 4px;
        border: 1px solid #e8ecf0;
    }

    .permission-rights-legend i {
        margin-right: 4px;
        color: #607d8b;
    }

    .permission-table-wrap {
        border: 1px solid #dce2e8;
        border-radius: 6px;
        overflow-x: auto;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    #PermissionTable {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
        table-layout: auto;
        font-size: 13px;
    }

    #PermissionTable thead th {
        background: linear-gradient(180deg, #4a5f7a 0%, #3d5269 100%);
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        padding: 10px 8px;
        border: 1px solid #34495e;
        vertical-align: middle;
        white-space: nowrap;
        min-width: 132px;
    }

    #PermissionTable thead th:first-child {
        min-width: 200px;
        text-align: left;
        padding-left: 14px;
        position: sticky;
        left: 0;
        z-index: 2;
        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.08);
    }

    #PermissionTable .RName {
        font-size: 12px;
        line-height: 1.3;
        margin-bottom: 6px;
        white-space: normal;
        word-break: break-word;
    }

    #PermissionTable thead .role-crud-icons {
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 3px;
        display: flex;
        justify-content: space-around;
        align-items: center;
        padding: 4px 2px;
        background: rgba(0, 0, 0, 0.12);
    }

    #PermissionTable thead .role-crud-icons > div {
        flex: 1;
        text-align: center;
        border-right: 1px solid rgba(255, 255, 255, 0.2);
        padding: 2px 0;
    }

    #PermissionTable thead .role-crud-icons > div:last-child {
        border-right: none;
    }

    #PermissionTable tbody tr.members td {
        border-bottom: 1px solid #eef2f6;
    }

    #PermissionTable tbody tr.members:hover td.tdcells {
        background: #f5f8fb;
    }

    #PermissionTable tbody tr.members:hover td.tdheader {
        background: #edf2f7;
    }

    .gang-name td {
        font-family: "Segoe UI", Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fff;
        background: linear-gradient(90deg, #34495e 0%, #3d566e 100%);
        border-left: 4px solid #ef6c00;
        padding: 10px 14px;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s ease;
    }

    .gang-name td:hover {
        background: linear-gradient(90deg, #3d5269 0%, #465c73 100%);
    }

    .gang-name.collapsed td {
        opacity: 0.92;
    }

    .tdheader {
        padding: 10px 12px;
        background: #fff;
        min-width: 200px;
        max-width: 280px;
        border: 1px solid #e0e6ed;
        border-top: none;
        text-align: left;
        font-weight: 500;
        color: #2c3e50;
        position: sticky;
        left: 0;
        z-index: 1;
        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.04);
    }

    .tdcells {
        padding: 8px 6px;
        min-width: 132px;
        border: 1px solid #e0e6ed;
        border-top: none;
        text-align: center;
        vertical-align: middle;
    }

    .tdcells > div {
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: nowrap;
    }

    .tdcells > div > div {
        flex: 1;
        min-width: 0;
    }
</style>



<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel permission-rights-page">
                    <header class="panel-heading">
                        <b>User Role Rights</b>
                    </header>
                    <div class="panel-body">

                        @{
                            var vievmodel = Model;
                            var updatepermission = vievmodel.UpdatePermission;
                            var updatemessage = vievmodel.UpdateMessage;
