                                        <span><i class="fa fa-eye"></i>View</span>
                                        <span><i class="fa fa-plus"></i>Add</span>
                                        <span><i class="fa fa-pencil"></i>Edit</span>
                                        <span><i class="fa fa-trash" aria-hidden="true"></i>Delete</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-xxs-12 permission-table-wrap">



                                        @{
                                            var NoOfColumns = Model.AspNetRoleList.Where(a => a.IsSysAdmin != true).Count();
                                            NoOfColumns = NoOfColumns + 1;
                                        }

                                        <table id="PermissionTable" class="table table-condensed">


