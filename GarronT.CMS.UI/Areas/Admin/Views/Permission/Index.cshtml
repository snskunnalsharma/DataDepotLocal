<script>

    $('.gang-name').click(function () {
        if ($(this).hasClass("collapsed")) {
            $(this).nextUntil('tr.gang-name').attr('Style', 'display:block');
            $(this).removeClass("collapsed");
        } else {
            $(this).nextUntil('tr.gang-name').attr('Style', 'display:none');
            $(this).addClass("collapsed");
        }
    });


</script>


<script>
    $(document).ready(function () {
        $("#UserRights").addClass('active').css('background-color', '#EF6C00').css('border-radius', '6px');
        $("#UserRights").children().css('color', '#fff');



        //$('tbody').scroll(function (e) { //detect a scroll event on the tbody
        //    /*
        //    Setting the thead left value to the negative valule of tbody.scrollLeft will make it track the movement
        //    of the tbody element. Setting an elements left value to that of the tbody.scrollLeft left makes it maintain 			it's relative position at the left of the table.
        //    */
        //    $('thead').css("left", -$("tbody").scrollLeft()); //fix the thead relative to the body scrolling
        //    $('thead th:nth-child(1)').css("left", $("tbody").scrollLeft()); //fix the first cell of the header
        //    $('tbody td:nth-child(1)').css("left", $("tbody").scrollLeft()); //fix the first column of tdbody
        //});


    });



    $("#btnUpdate").live("click", function () {

        var PermissionList = [];

        var _permissionID = "";
        var _permissionName = "";



        var table = document.getElementById("PermissionTable");
        for (var i = 0, row; row = table.rows[i]; i++) {
            //iterate through rows
            //rows would be accessed using the "row" variable assigned in the for loop

            if (i > 0) {
                for (var j = 0, col; col = row.cells[j]; j++) {
                    //iterate through columns
                    //columns would be accessed using the "col" variable assigned in the for loop


                    if (j === 0) {
                        _permissionID = $(col).attr("permissionid")
                        _permissionName = $(col).attr("permissionname")
                    }

                    if (j > 0) {

                        var _RoleID = $(col).attr("roleid")
                        // input[name = 'Role']
                        //var ViewV = $(col).find(".ViewPermission")[0].checked;
                        //var ViewA = $(col).find(".EditPermission")[0].checked;
                        //var ViewE = $(col).find(".DeletePermission")[0].checked;
                        //var ViewD = $(col).find(".AddPermission")[0].checked;
                        var ViewV = $(col).find(".ViewPermission")[0].checked;
                        var ViewA = $(col).find(".AddPermission")[0].checked;
                        var ViewE = $(col).find(".EditPermission")[0].checked;
                        var ViewD = $(col).find(".DeletePermission")[0].checked;


                        var Permission = {
                            "PermissionID": _permissionID,
                            "PermissionName": _permissionName,
                            "RoleID": _RoleID,
                            "RoleViewChecked": ViewV,
                            "RoleAddChecked": ViewA,
                            "RoleEditChecked": ViewE,
                            "RoleDeleteChecked": ViewD
                        };


                        PermissionList.push(Permission)
                    }

                }

            }

        }


        debugger;



        var urlAssignPermissionsToRole = $('#urlAssignPermissionsToRole').val();

        $.ajax({
            url: urlAssignPermissionsToRole,
            type: "POST",
            // data: _parameters,
            data: JSON.stringify(PermissionList),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                waitingDialog.show('Loading Please Wait...');
            },
            complete: function (data) {
                if (data.statusText == "OK") {
                    var $toast = toastr["success"]("Record Updated", "Success Notification");
                }
                else {
                    var $toast = toastr["error"]("Unable to Update record", "Error Notification");
                }
                waitingDialog.hide();
            },
            success: function (data, textStatus, jqXHR) {
                // alert("success")
                // $('#PermissionsTable').html(data);
            }
        });
    });

</script>
