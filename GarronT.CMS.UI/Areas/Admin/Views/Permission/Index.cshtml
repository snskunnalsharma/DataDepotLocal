</section>
<script>

    $('.gang-name').click(function () {
        var $sectionRows = $(this).nextUntil('tr.gang-name');
        if ($(this).hasClass('collapsed')) {
            $sectionRows.css('display', '');
            $(this).removeClass('collapsed');
        } else {
            $sectionRows.css('display', 'none');
            $(this).addClass('collapsed');
        }
    });


</script>


<script>
    $(document).ready(function () {
        $("#UserRights").addClass('active').css('background-color', '#EF6C00').css('border-radius', '6px');
        $("#UserRights").children().css('color', '#fff');



        //$('tbody').scroll(function (e) { //detect a scroll event on the tbody
        //    /*
        //    Setting the thead left value to the negative valule of tbody.scrollLeft will make it track the movement
        //    of the tbody element. Setting an elements left value to that of the tbody.scrollLeft left makes it maintain 			it's relative position at the left of the table.
        //    */
        //    $('thead').css("left", -$("tbody").scrollLeft()); //fix the thead relative to the body scrolling
        //    $('thead th:nth-child(1)').css("left", $("tbody").scrollLeft()); //fix the first cell of the header
        //    $('tbody td:nth-child(1)').css("left", $("tbody").scrollLeft()); //fix the first column of tdbody
        //});


    });



    $(document).on('click', '#btnUpdate', function () {

        var PermissionList = [];
        var seenKeys = {};

        var _permissionID = "";
        var _permissionName = "";

        var table = document.getElementById("PermissionTable");
        for (var i = 0, row; row = table.rows[i]; i++) {
            if (i === 0) {
                continue;
            }

            var $firstCell = $(row.cells[0]);
            var pid = $firstCell.attr("permissionid");
            if (!pid) {
                continue;
            }

            _permissionID = pid;
            _permissionName = $firstCell.attr("permissionname") || "";

            for (var j = 1, col; col = row.cells[j]; j++) {
                var _RoleID = $(col).attr("roleid");
                if (!_RoleID) {
                    continue;
                }

                var vInp = $(col).find(".ViewPermission")[0];
                var aInp = $(col).find(".AddPermission")[0];
                var eInp = $(col).find(".EditPermission")[0];
                var dInp = $(col).find(".DeletePermission")[0];
                if (!vInp || !aInp || !eInp || !dInp) {
                    continue;
                }

                var ViewV = vInp.checked;
                var ViewA = aInp.checked;
                var ViewE = eInp.checked;
                var ViewD = dInp.checked;

                var dedupeKey = _permissionID + "|" + _RoleID;
                if (seenKeys[dedupeKey]) {
                    continue;
                }
                seenKeys[dedupeKey] = true;

                PermissionList.push({
                    "PermissionID": _permissionID,
                    "PermissionName": _permissionName,
                    "RoleID": _RoleID,
                    "RoleViewChecked": ViewV,
                    "RoleAddChecked": ViewA,
                    "RoleEditChecked": ViewE,
                    "RoleDeleteChecked": ViewD
                });
            }
        }

        var urlAssignPermissionsToRole = $('#urlAssignPermissionsToRole').val();

        $.ajax({
            url: urlAssignPermissionsToRole,
            type: "POST",
            // data: _parameters,
            data: JSON.stringify(PermissionList),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                waitingDialog.show('Loading Please Wait...');
            },
            complete: function () {
                waitingDialog.hide();
            },
            success: function (data) {
                if (data && data.result) {
                    toastr["success"](data.resultMessage || "Record Updated", "Success Notification");
                } else {
                    toastr["error"]((data && data.resultMessage) ? data.resultMessage : "Unable to update record", "Error Notification");
                }
            },
            error: function () {
                toastr["error"]("Unable to update record", "Error Notification");
            }
        });
    });

</script>
