<!DOCTYPE html>
<html>
<head id="layouthead">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Depot - @ViewBag.Title</title>
 
    @Scripts.Render("~/bundles/modernizr")
    @Html.Partial("_JsLayout")
    @Html.Partial("_cssLayout")
    <link rel="shortcut icon" href="~/images/logo_favicon.png" />

    @Html.Hidden("urlGetCityListHeader", Url.Action("GetCityListHeader", "Dashboard"))
    @Html.Hidden("urlGetProjectListbyCity", Url.Action("GetProjectByCityID", "Dashboard"))
    @Html.Hidden("urlDashboard", Url.Action("Index", "Dashboard"))
    @Html.Hidden("urlLogIn", @Url.Action("Index", "LogIn", new { Area = "Global" }))
</head>
<body>

    <section id="container">

        <!--header start-->
        @Html.Partial("_HeaderLayout")

        <!--header end-->

        <aside>
            <div id="sidebar" class="nav-collapse ">
              
                
                @if (@User.IsInRole("Admin"))
                {

                    @Html.Partial("_AdminMenuLayout")
                }
                else
                {
                    @Html.Partial("_InstallerMenuLayout")
                }
            </div>         
        </aside>

        <div id="sidebar1" class="nav-collapse ">
            <aside class="control-sidebar control-sidebar-dark" style="margin-top:65px;">
                <!-- Create the tabs -->
                <ul class="nav nav-tabs nav-justified control-sidebar-tabs">

                    <li></li>
                    <li></li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <!-- Home tab content -->
                    <div class="tab-pane" id="control-sidebar-home-tab">




                    </div><!-- /.tab-pane -->


                </div>
            </aside><!-- /.control-sidebar -->

        </div>

        @RenderBody()


    

        <!--footer end-->



        <footer class="site-footer">
            <ul class="footer_smalllogo">
                <footer>
                    @{
                        var version = new GarronT.CMS.Model.DAL.VersionDAL().getVersionDetials();                      
                    }
                     <p style=" color: #fff; float: right; width: 50%; margin: 4px; text-align: right;"><a id="lblVersionId" href="#" style="color:white">@version  </a><img class="slide" src="~/images/bottom_clientlogo.png" /></p>
                </footer>
            </ul>

        </footer>


    </section>

  
     
    @RenderSection("scripts", required: false)

    <script src="@Url.Content("~/Content/MSTS/admin/js/jquery.shapeshift.js")"></script>
    <script src="@Url.Content("~/Content/MSTS/admin/js/common-scripts.js")"></script> 

    <script>
        jQuery(document).ready(function () {
           
            var is_ios = /(iPad|iPhone|iPod)/g.test(navigator.userAgent);

            if (is_ios) {
                $("#layouthead").append('<link href="../Content/MSTS/admin/css/style-ios.css" rel="stylesheet" />')               
            }});
    </script>
    <script>
        $(document).ready(function () {
            $(".clones").shapeshift({
                dragClone: true,
                enableCrossDrop: false
            });
            $(".droparea").shapeshift({
                colWidth: 100
            });
        })
    </script>
    <script>
        $(document).ready(function () {
            $(".Drag").shapeshift();
            $(".trash").shapeshift({
                autoHeight: false,
                colWidth: 80,
                enableTrash: true
            });
        })
    </script>
    <script>      

        $(document).on('click', '.close', function () {
            $('.ss-active-child').hide();
        });
    </script>
    <script>

        //owl carousel

        $(document).ready(function () {
            $("#owl-demo").owlCarousel({
                navigation: true,
                slideSpeed: 300,
                paginationSpeed: 400,
                singleItem: true,
                autoPlay: true

            });


            var sessionTimeoutWarning = @Session.Timeout - 1;
            var sTimeout = parseInt(sessionTimeoutWarning) * 60 * 1000;
            setTimeout('SessionEnd()', sTimeout);

            function SessionEnd() {
                window.location.hostname = "";
                var dashboardurl = $("#urlDashboard").val();
                location.href = dashboardurl;
            }
        });

        //custom select box

        $(function () {
            $('select.styled').customSelect();
        });


      
    </script>
</body>
</html>

<script type="text/javascript">
    $(document).ajaxError(function (xhr, props) {
        
        debugger;
        if (props.status === 306) {
            var dashboardurl = $("#urlLogIn").val();
            location.href = dashboardurl;
        }
    })
   
</script>
