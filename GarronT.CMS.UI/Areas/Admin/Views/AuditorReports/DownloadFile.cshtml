@{
    ViewBag.Title = "Auditor Report PDF";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutReport.cshtml";
}

@Html.Hidden("btnpdfPrev", Url.Action("DownloadFile", "AuditorReports"), new { target = "_blank" })

@Html.Hidden("urlstoredPDFIDs", Url.Action("GetPDFDownloadID", "AuditorReports"))
@Html.Hidden("urlGeneratePDFbyID", Url.Action("DownloadFile", "AuditorReports"))




<style>
    .pdfdiv {
        /*margin-right: -11px;
        margin-left: -13px;*/
        margin: 0 auto;
    }

    iframe {
        /*overflow:visible;*/
    }

    .wrapper {
        overflow: hidden;
    }

    @@media (max-width:320px) {
        .wrapper {
            margin-bottom: -1% !important;
            overflow: hidden;
            height: 46em !important;
            margin-top: -8%;
        }

        iframe {
            height: 40em;
        }
    }
    @@media only screen and (min-width:321px)and (max-width:410px) {
        .wrapper {
            overflow: auto;
            height: 46.4em !important;
        }
    }
     @@media only screen and (min-width:321px)and (max-width:410px) {
        .wrapper {
            overflow: auto;
            height: 46.4em !important;
        }
    }
    @@media only screen and (min-width:768px) and (max-width:1023px) {
        .pdf-table-responsive {
            height: 30em !important;
            overflow-y: scroll !important;
        }
    } 
    /*@@media only screen and (min-width:321px)and (max-width:767px) {
        .wrapper {
           
            overflow: hidden;
            height: 46.4em !important;
        }
    }*/
</style>

@*<section id="main-content">*@
<section class="wrapper">
    <!-- page start-->
    <div class="row">
        <div class="col-lg-12">
            <section class="panel">
                <header class="panel-heading"></header>
                <div class="panel-body">
                    <div class="row">
                        <div class="form-group" style="text-align:center;margin-top: 19px;">
                            @if (@ViewBag.Prevbutton == true)
                            {
                                <input type="button" class="btn btn-info" id="btnpdfPrev" onclick="GetPreviousRecord();" value="Previous" />
                            }

                            @if (@ViewBag.Nextbutton == true)
                            {
                                <input type="button" class="btn btn-info" id="btnpdfNext" onclick="GetNextRecord();" value="Next" />
                            }

                        </div>

                        <div class="form-group" style="text-align:right;margin-top: -20px;margin-right: 18px;">
                            @if (@ViewBag.CategoryType == "COMPLETED")
                            {
                                <input type="button" value="Download" class="btn btn-success" onclick="location.href='@Url.Action("DownloadSinglePDF", "AuditorReports", new { FormID = @ViewBag.FormID, UploadID = @ViewBag.UploadID })'" />
                            }
                            else if (@ViewBag.CategoryType == "RTU" || @ViewBag.CategoryType == "SKIP")
                            {
                                <input type="button" value="Download" class="btn btn-success" onclick="location.href='@Url.Action("DownloadSinglePDF_SkipRTU", "AuditorReports", new { UploadID = @ViewBag.UploadID })'" />
                            }
                        </div>

                    </div>

                    @if (@ViewBag.CategoryType == "COMPLETED")
                    {
                        <div class="row pdfdiv">
                            <iframe name="ifr" width="100%" id="pdfIframe" scrolling="auto" src="@Url.Action("GeneratePDF")" onload="resizeIframe(this)"></iframe>

                        </div>
                    }
                    else if (@ViewBag.CategoryType == "RTU" || @ViewBag.CategoryType == "SKIP")
                    {
                        <div class="row pdfdiv">
                            <iframe name="ifr" width="100%" id="pdfIframe" scrolling="auto" src="@Url.Action("GeneratePDF_SkipRTU")" onload="resizeIframe(this)"></iframe>
                        </div>
                    }

                </div>
            </section>
        </div>
    </div>
</section>
@*</section>*@

<script language="javascript" type="text/javascript">
    
    function resizeIframe(obj) {
        debugger;
        var contentheight = (obj.contentWindow.document.body.scrollHeight + 5) + 'px';
        obj.style.height = contentheight

    }
    
</script>
<script>

    function GetNextRecord() {
        var urlGetNextPreviousrecord = $("#btnpdfPrev").val();
        var urlGeneratePDFbyID = $('#urlGeneratePDFbyID').val();
        var urlstoredPDFIDs = $('#urlstoredPDFIDs').val();
        $.ajax({
            type: 'GET',
            url: urlstoredPDFIDs,
            async: false,
            //  data: { buttonclicked: "Next" },
            data: { id: null, frmID: null, buttonclicked: "Next" },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                location.href = urlGeneratePDFbyID;
            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                var $toast = toastr["error"](textStatus + "</br>" + errorThrown, "Error Notification");
                console.log('jqXHR:');
                console.log(jqXHR);
                console.log('textStatus:');
                console.log(textStatus);
                console.log('errorThrown:');
                console.log(errorThrown);
            }

        });
    }

    $("#btnpdfNext1").click(function () {
        var urlGetNextPreviousrecord = $("#btnpdfPrev").val();
        var urlGeneratePDFbyID = $('#urlGeneratePDFbyID').val();
        var urlstoredPDFIDs = $('#urlstoredPDFIDs').val();
        $.ajax({
            type: 'GET',
            url: urlstoredPDFIDs,
            async: false,
            //  data: { buttonclicked: "Next" },
            data: { id: null, frmID: null, buttonclicked: "Next" },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                location.href = urlGeneratePDFbyID;
            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                var $toast = toastr["error"](textStatus + "</br>" + errorThrown, "Error Notification");
                console.log('jqXHR:');
                console.log(jqXHR);
                console.log('textStatus:');
                console.log(textStatus);
                console.log('errorThrown:');
                console.log(errorThrown);
            }

        });

    })



</script>

