@{
    ViewBag.Title = "Audit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


@Html.Hidden("urlGetProjectData", Url.Action("GetProjectData", "ProjectAudit"))
@Html.Hidden("urlGoToIndex", Url.Action("Index", "ProjectAudit"))
@Html.Hidden("urlGetProjectDetails", Url.Action("GetProjectDetails", "ProjectAudit"))
@Html.Hidden("urlSaveAuditDetails", Url.Action("UpdateAuditDetails", "ProjectAudit"))
@Html.Hidden("urlGetProjectDataForUpdate", Url.Action("GetProjectDataForUpdate", "ProjectAudit"))
@Html.Hidden("urlGetInstallerAuditCycleData", Url.Action("GetInstallerAuditCycleData", "ProjectAudit"))
@Html.Hidden("urlGetCustData", Url.Action("GetCustData", "ProjectAudit"))

@Html.Hidden("urlUpdateInstallerAuditCycles", Url.Action("UpdateInstallerAuditCycles", "ProjectAudit"))


@Html.Hidden("urlAddNewAuditCycle", Url.Action("AddNewAuditCycle", "ProjectAudit"))
@Html.Hidden("urlEditAuditCycle", Url.Action("EditAuditCycle", "ProjectAudit"))
@Html.Hidden("urlAddNewFailCycle", Url.Action("AddNewFailCycle", "ProjectAudit"))
<style>
    form {
        padding: 20px 0px 0px 0px;
    }
</style>

<div id="loading">
    <div id="loadingcontent">
        <p id="loadingspinner"> Searching things... </p>
    </div>
</div>

<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel">
                    <header class="panel-heading"><strong> Audit Management - <label id="lblProjectName"></label> </strong> </header>
                    <div class="panel-body panel_top">
                        <form role="form" action="" id="fromsave" method="post" style=" background: rgb(190, 210, 230);" class="form-horizontal">
                            <div class="row setup-content">
                                <div class="col-xs-12 ">
                                    <div class="col-md-12 creproj_form_box">

                                        <div class="form-group">
                                            <div class="col-lg-2 col-sm-4 col-xs-12 label color_name control-label">
                                                <span>Utility type :- </span>
                                            </div>

                                            @*<div class="col-lg-3 col-sm-9 col-xs-10 internal ">*@
                                            <label class="col-lg-2 col-sm-2 col-xs-12" for="name" id="lblProjectUtility">-</label>
                                            @*</div>*@

                                            <label class="col-lg-2 col-sm-2 col-xs-12 label color_name control-label " style="white-space:nowrap;">Project Name :- </label>

                                            <div class="col-lg-4 col-sm-4 col-xs-4 ">
                                                <label for="name" id="lblProjectName1">-</label>
                                                <input type="hidden" name="ProjectId" id="txtProjectId" value="@ViewBag.ProjectId" />
                                                <input type="hidden" name="FKProjectId" id="FKProjectId" value="@ViewBag.FKProjectId" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="col-lg-2 col-sm-2 label color_name control-label">
                                                <span>Customer Name :- </span>
                                            </div>
                                            @*<label class="col-lg-2 col-sm-2 label color_name control-label " style="white-space:nowrap;">Customer Name<span style="color:red">*</span></label>*@
                                            <div class="col-lg-2 col-sm-2 col-xs-12">
                                                <label for="name" id="lblCustomerName">-</label>
                                            </div>
                                            <div class="col-lg-2 col-sm-2 label color_name control-label">
                                                <span>Project Start Date :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-2 col-xs-12 ">
                                                <label for="name" id="lblProjectStartDate">-</label>
                                            </div>
                                            <div class="col-lg-2 col-sm-2 label color_name control-label">
                                                <span>Project End Date :- </span>
                                            </div>
                                            @*<label class="col-lg-2 col-sm-2 col-xs-12 label color_name  control-label">Project End Date</label>*@
                                            <div class="col-lg-2 col-sm-2 col-xs-12 ">
                                                <label for="name" id="lblProjectEndDate">-</label>
                                            </div>
                                        </div>



                                        <div class="form-group">
                                            <div class="col-lg-2 col-sm-2 label color_name control-label">
                                                <span>Audit Start Date :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-4 col-xs-12">
                                                <input type="text" name="FromDate" id="txtFromDate" readonly="true" class="inputclass form-control input_shadow cre_inp_date">
                                            </div>

                                            <div class="col-lg-2 col-sm-2 label color_name control-label">
                                                <span>Audit End Date :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-2 col-xs-12 ">
                                                <input type="text" name="ToDate" id="txtToDate" readonly="true" class="inputclass form-control input_shadow cre_inp_enddate">
                                            </div>

                                            <label class="col-lg-2 col-sm-2 label color_name control-label  create_label" style="white-space:nowrap;">Select Auditor :- </label>
                                            <div class="col-lg-2 col-sm-4 col-xs-10 state_drp_btn">
                                                @*<select name="Auditor" id="ddlAuditor" data-placeholder="Select Auditor" type="text" class="required form-control input_shadow"></select>*@

                                                <div id="divroot">
                                                    <div id="divAuditor" class=" ">
                                                        <div class="chosen-container chosen-container-single " title="" id="ddlAuditor_chosen">
                                                            <a class="chosen-single chosen-default" id="ancAuditor_chosen" tabindex="-1"><span class="" id="AuditorHeader">Select Auditor</span><div><b></b></div></a>
                                                            <div class="chosen-drop">
                                                                <div class="chosen-search"><input type="text" id="txtfilterallAuditor" class="txtfilterall" onkeyup="filterAuditor(this)" autocomplete="off"></div>
                                                                <div class="InstallerFilter row">
                                                                    <label style="margin-left: 7px;" class="col-lg-2">
                                                                        <input type="checkbox" style="zoom:1.2;" class="chbSelectAll" id="Auditor_SelectAll" autocomplete="off" value=" "><span>Select All</span>
                                                                    </label>
                                                                </div>
                                                                <ul id="ulAuditor" class="chosen-results " style=""></ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <br />
                                        </div>
                                      



                                        <div class="form-group">
                                            <header class="panel-heading"><strong> Installer Audit Cycle Details </strong> </header>
                                            <div class="adv-table">
                                                <div class="row">
                                                    <div class="col-lg-4 col-md-4 col-xs-4 add_newbtn">
                                                        <a class="btn btn-success" id="btnAddCustomerPercent" data-toggle="modal" data-backdrop="static" href="#">
                                                            Add Audit Cycle <i class="fa fa-plus"></i>
                                                        </a>
                                                    </div>
                                                </div>

                                                <div class="col-xs-12 ">
                                                    <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                                        <thead>
                                                            <tr>
                                                                <th width="5%">Insaller Name</th>
                                                                <th width="4%">Audit Percent</th>
                                                                <th width="3%">Start Day</th>
                                                                <th width="3%">End Day</th>
                                                                <th width="3%">Audit Cycle Failed</th>
                                                                <th width="3%">Action</th>
                                                            </tr>
                                                        </thead>
                                                    </table>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <br />
                                        </div>

                                        <div class="form-group ">
                                            <header class="panel-heading"><strong> Fail Cycle Details For All Installers </strong> </header>
                                            <div class="adv-table">
                                                <div class="row">
                                                    <div class="col-lg-4 col-md-4 col-xs-4 add_newbtn">
                                                        <a class="btn btn-success" id="btnAddFailurePercent" data-toggle="modal" data-backdrop="static" href="#">
                                                            Add Fail Cycle <i class="fa fa-plus"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="col-xs-12 ">
                                                    <table id="dynamic-table1" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                                        <thead>
                                                            <tr>
                                                                <th width="5%">Fail Percent From</th>
                                                                <th width="5%">Fail Percent To</th>
                                                                <th width="5%">Increased Day</th>
                                                                <th width="5%">Action</th>
                                                            </tr>
                                                        </thead>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <br />
                                        </div>
                                        <div class="form-group">
                                            <div class="col-lg-12 col-sm-12 col-xs-12 text-center">
                                                <button id="btnSave" class="btn btn-success" type="button">Save</button>
                                                @*<button class="btn btn-danger" id="btnResetAudit" type="button">Reset</button>*@
                                                <button class="btn btn-danger" id="btnCancelAudit" type="button">Cancel</button>
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <br />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>


<!-- Modal for Add /Edit Dialog -->
<div class="modal fade modal-dialog-center" id="AddEditModel" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">

</div>


<link href="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.css")" rel="stylesheet" />
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.jquery.min.js")"></script>
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.proto.min.js")"></script>

<link href="~/Scripts/js/style.css" rel="stylesheet" />
<link href="~/Scripts/js/jquery-ui.css" rel="stylesheet">
<script src="~/Scripts/js/jquery-ui.js"></script>

<link href="~/jquery-confirm-master/css/jquery-confirm.css" rel="stylesheet" />
<script src="~/jquery-confirm-master/js/jquery-confirm.js"></script>

@System.Web.Optimization.Scripts.RenderFormat(GarronT.CMS.UI.SiteKeys.ScriptVersion, "~/bundles/AuditUpdate_js")  