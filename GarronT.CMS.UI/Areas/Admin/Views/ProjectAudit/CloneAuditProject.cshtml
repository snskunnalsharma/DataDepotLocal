<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel">
                    <header class="panel-heading"><strong> Audit Management - <label id="lblProjectName"></label> </strong> </header>
                    <div class="panel-body panel_top">
                        <form role="form" action="" id="fromsave" method="post" style="background: rgb(190, 210, 230);" class="form-horizontal">
                            <div class="row setup-content">
                                <div class="col-xs-12 ">
                                    @*<div class="col-md-12 creproj_form_box">*@
                                    <div class="col-md-12 ">
                                        <div class="form-group">
                                            <div class="col-lg-2 col-sm-4 col-xs-12 label color_name control-label">
                                                <input type="hidden" name="CloneAuditId" id="CloneAuditId" value="@ViewBag.CloneAuditId " />
                                                <span>Utility type<span style="color:red">*</span> :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-4 col-xs-10 ">
                                                <select id="ddlUtilitytype" name="Utilitytype" data-placeholder="Select Utility type" class="inputclass form-control input_shadow">
                                                    <option value="0"></option>
                                                    <option value="1">Electric</option>
                                                    <option value="2">Gas</option>
                                                    <option value="3">Water</option>
                                                </select>
                                            </div>
                                            <div class="col-lg-2 col-sm-4 col-xs-12 label color_name control-label">
                                                <span>Project Name<span style="color:red">*</span> :- </span>
                                            </div>
                                            <div class="col-lg-4 col-sm-4 col-xs-10 ">
                                                <select name="Project" id="ddlProject" data-placeholder="Select Project" typeof="text" class="required form-control input_shadow "></select>
                                            </div>
                                        </div>

                                        <div class="form-group">

                                            <div class="col-lg-2 col-sm-4 col-xs-12 label color_name control-label">
                                                <span>Customer Name :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-4 col-xs-10 ">
                                                <label for="name" id="lblCustomerName">-</label>
                                            </div>


                                            <div class="col-lg-2 col-sm-4 col-xs-12 label color_name control-label">
                                                <span>Project Start Date :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-4 col-xs-10 ">
                                                <label for="name" id="lblProjectStartDate">-</label>
                                            </div>

                                            <div class="col-lg-2 col-sm-4 col-xs-12 label color_name control-label">
                                                <span>Project End Date :- </span>
                                            </div>
                                            <div class="col-lg-2 col-sm-4 col-xs-10 ">
                                                <label for="name" id="lblProjectEndDate">-</label>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="col-lg-2 col-sm-4 col-xs-10  label color_name control-label">
                                                <span> Audit Start Date<span style="color:red">*</span> :- </span>
                                            </div>
