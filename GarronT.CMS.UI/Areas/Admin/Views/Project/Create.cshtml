<style type="text/css">
    .stepwizard-step p {
        margin-top: 10px;
        color: #fff;
        width: 128px;
        margin-left: -45px;
    }

    .stepwizard-row {
        display: table-row;
    }

    .stepwizard {
        display: table;
        width: 100%;
        position: relative;
        background: #80B2DF;
    }

    .stepwizard-step button[disabled] {
        opacity: 1 !important;
        filter: alpha(opacity=100) !important;
    }

    .stepwizard-row:before {
        top: 41px;
        bottom: 0;
        position: relative;
        content: " ";
        width: 100%;
        height: 1px;
        background-color: #f5f5f5;
        z-index: 0;
        position: absolute;
        height: 6px;
        border-right: none;
        border-radius: 0;
        border: 1px solid #d5d5da;
        left: 0;
    }

    .stepwizard-step {
        display: table-cell;
        text-align: center;
        position: relative;
        /*width: 20%;*/
        white-space: nowrap;
        padding-bottom: 20px;
    }

    .stepwizard-step-circle {
        display: block;
        background: #eee;
        width: 40px;
        height: 40px;
        border-radius: 40px;
        border: 1px solid #d5d5da;
        margin: 2% 4.5% 4% 6.7%;
        float: left;
    }

    .open > .dropdown-menu {
        /*display: block;
        min-height: 220px;
        overflow: auto;
        height: 220px;
        width: 100% !important;*/
    }

    .btn-circle {
        width: 30px;
