@{
    ViewBag.Title = "Project";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


@Html.Hidden("urlActiveRecords", Url.Action("getActiveOrDeactiveProjectList", "Project"))
@Html.Hidden("url_A_Or_D_Records", Url.Action("A_Or_D_Project", "Project"))
@Html.Hidden("urlsetEditId", Url.Action("setEditId", "Project"))

@Html.Hidden("urlChangeStatus", Url.Action("setProjectStatus", "Project"))

@Html.Hidden("urleditProject", Url.Action("Edit", "Project"))
@Html.Hidden("urlCloneProject", Url.Action("CloneProject", "Project"))

@Html.Hidden("urlCreateProject", Url.Action("create", "Project"))

@Html.Hidden("urlGetUploadedDatabyProjectID", Url.Action("GetUploadedDatabyProjectID", "Project"))

@Html.Hidden("urlRedirectToEditUploadedData", Url.Action("EditUploadedData", "Project"))

<style>
