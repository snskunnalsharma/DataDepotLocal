@{
    ViewBag.Title = "Project Edit Data";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


@Html.Hidden("GetActiveUploadedData", Url.Action("GetActiveUploadedData", "Project"))

@Html.Hidden("urlGetRecordsbyUploadedID", Url.Action("GetRecordsbyUploadedID", "Project"))

@Html.Hidden("urlUpdateUploadData", Url.Action("SaveRecord", "Project"))
@Html.Hidden("UrlCalculatePendingLatLon", Url.Action("CalculatePendingLatLon", "Project"))
@Html.Hidden("GetprojectIndex", Url.Action("Index", "Project"))

<div id="loading">
    <div id="loadingcontent">
        <p id="loadingspinner">
            Searching things...
        </p>
    </div>
</div>


<!-- page start-->

<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel">                    
                    <header class="panel-heading">
                        <h5 id="Pname"></h5> <br>
                        <h6>Edit Excel Data</h6>

                    </header>
                    <div class="panel-body">
                        <div class="adv-table">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="col-lg-3 col-md-4 col-xs-4 ">
                                        <a class="btn btn-success" target="_self" id="btnback" href="@Url.Action("Index", "Project", new { area = "Admin" })">
                                            Back to List
                                        </a>

                                    </div>
                                    <div class="col-lg-3 col-md-4 col-xs-4 ">
                                        <button class="btn btn-primary btn-lg" type="button" id="btnCalculate" style="margin-top:0px;">Calculate Pending Lat Lon Records</button>
                                    </div>
                                </div> 
                                </div>
                            <div class="table-responsive">
                                <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                    <thead>
                                        <tr>
                                            <th width="7%">Cycle</th>
                                            <th width="7%">Route</th>
                                            <th width="20%">Account</th>
                                            <th width="20%">Street</th>
                                            <th width="20%">Latitude</th>
                                            <th width="20%">Longitude</th>

                                            <th width="6%">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>


<!-- Modal for Edit -->
<div class="modal fade modal-dialog-center" id="myModal" role="dialog" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content-wrap">
            <div class="modal-content fom_dialog">
                <div class="modal-header">
                    <button type="button" class="close" id="btnclose" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Edit Record</h4>
                </div>
                <div class="modal-body">
                    <div class="panel-body">
                        <form id="UploadForm" class="cmxform form-horizontal tasi-form">
                            <input type="hidden" name="ID" id="txtUploadID" class="inputclass form-control" />
                            <div class="form-group ">
                                <label for="name" class="col-lg-2 col-sm-3 col-xs-12 control-label">Account</label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="Account" readonly maxlength="50" id="txtAccount" class="inputclass form-control  " />
                                </div>
                            </div>
                            <div class="form-group ">
                                <label for="name" class="col-lg-2 col-sm-3 col-xs-12 control-label">Latitude</label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="Latitude" maxlength="50" id="txtLatitude" class="inputclass form-control Decimal-Only " />
                                </div>
                            </div>
                            <div class="form-group ">
                                <label for="name" class=" col-lg-2 col-sm-3 col-xs-12 control-label">Longitude</label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="Longitude" maxlength="50" id="txtLongitude" class="inputclass form-control Decimal-Only" />
                                </div>
                            </div>
                            <div class="form-group ">
                                <label for="name" class=" col-lg-2 col-sm-3 col-xs-12 control-label">Street<span style="color:red">*</span> </label>
                                <div class="col-lg-8 col-sm-9 col-xs-9">
                                    <input type="text" name="Street" maxlength="500" id="txtStreet" class="inputclass form-control " />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSave" class="btn btn-success" type="button">Save</button>
                    <button class="btn btn-danger" id="btnCancel" type="button">Cancel</button>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- modal -->



<link href="~/Content/MSTS/admin/css/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/Content/MSTS/admin/js/bootstrap-multiselect.js"></script>
<script src="~/Scripts/Admin/ProjectUploadDataEdit.js"></script>


