@model GarronT.CMS.Model.BO.ProductMasterBO
@using GarronT.CMS.UI.CustomHelpers
<div class="modal-dialog modal-md">
    <div class="modal-content-wrap">
        <div class="modal-content metrmke_dialog ">
            <div class="modal-header">
                <button type="button" class="close" id="btnclose" data-dismiss="modal" aria-hidden="true">&times;</button>

                @if (@ViewBag.Status == "Create")
                {
                    <h4 class="modal-title">Add Product</h4>
                }
                else
                {
                    <h4 class="modal-title">Edit Product</h4>
                }

            </div>
            <div class="modal-body">
                <div class="panel-body">

                    @using (Html.BeginForm("", "", FormMethod.Get, new { @class = "form-horizontal", @id = "formAddEdit", role = "form" }))
                    {

                        <div class="form-group ">
                            <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label">Utility Type<span style="color:red">*</span></label>
                            <div class="col-lg-8 col-sm-8 col-xs-8">
                                @Html.EditorFor(model => model.Id, new { htmlAttributes = new { @class = "form-control", @type = "hidden" } })

                                <div id="divProduct" class=" ">
                                    <div class="chosen-container chosen-container-single " title="" id="Product_chosen">
                                        <a class="chosen-single chosen-default CurrentSelectedDropDown" id="ancProduct_chosen" tabindex="-1"><span class="" id="ProductHeader">Select Any Item</span><div><b></b></div></a>
                                        <div class="chosen-drop">
                                            <div class="chosen-search"><input type="text" id="txtfilterallProduct" class="txtfilterall" onkeyup="filterMultiSelectDropDown(this)" autocomplete="off"></div>
                                            <div class="ProductFilter row">
                                                <label style="margin-left: 7px;" class="col-lg-2">
                                                    <input type="checkbox" style="zoom:1.2;" class="chbSelectAll" id="Product_SelectAll" autocomplete="off" value=" "><span>Select All</span>
                                                </label>
                                            </div>
                                            <ul id="ulProduct" class="chosen-results " style=""></ul>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnSave" class="btn btn-success" type="button">Save</button>
                <button id="btnCancel" class="btn btn-danger" type="button">Cancel</button>

            </div>
        </div>
    </div>
</div>
<link href="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.css")" rel="stylesheet" />
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.jquery.min.js")"></script>
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.proto.min.js")"></script>
