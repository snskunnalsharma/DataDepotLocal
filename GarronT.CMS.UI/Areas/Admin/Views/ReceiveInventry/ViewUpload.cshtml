<div id="loading">
    <div id="loadingcontent">
        <p id="loadingspinner">
            Searching things...
        </p>
    </div>
</div>



<!-- page start-->


<section id="main-content">
    <section class="wrapper site-min-height">
        <div class="row">
            <div class="col-lg-12">
                <!--progress bar start-->
                <section class="panel">
                    <header class="panel-heading">
                        <b>Inventory Receive- Uploaded Record Details</b>
                    </header>
                    <br>
                    <div class="row" style="">
                        <div class="col-lg-12">

                            <div class="col-lg-4">
                                <label>RequestId - </label>
                                <label><strong>@Model.RequestId</strong></label>
                            </div>
                            <div class="col-lg-4">
                                <label>Created Date - </label>
                                <label><strong>@Model.DeviceDateTime</strong></label>
                            </div>
                            <div class="col-lg-4">
                                <label>Project Name - </label>
                                <label><strong>@Model.ProjectName</strong></label>
                            </div>

                        </div>
                        <div class="col-lg-12">
                            <div class="col-lg-4">
                                <label>Warehouse Name - </label>
                                <label><strong>@Model.WarehouseName</strong></label>
                            </div>
                            <div class="col-lg-4">
                                <label>Upload Type - </label>
                                <label><strong>@Model.uploadType</strong></label>
                            </div>
                            <div class="col-lg-4">
                                <label>Created By - </label>
                                <label><strong>@Model.UserName</strong></label>
                            </div>



                        </div>

                        <div class="col-lg-12">
                            <div class="container-fluid con_fluid_new">
                                <div class="panel-body panel_top">
                                    <div class="row setup-content" style="margin-bottom: 5px;">
                                        <div class="table-responsive col-lg-12 rep_dyn_table">
                                            <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                                <thead>
                                                    <tr>
                                                        <th width="5%">Generate Barcode</th>
                                                        <th width="5%">System Generated Serial No.</th>
                                                        @*<th width="5%">Warehouse</th>*@
                                                        <th width="15%">Product Name</th>

                                                        <th width="10%">Part Number</th>
                                                        <th width="10%">UPC Code</th>
                                                        <th width="10%">Utility Type</th>
                                                        <th width="10%">Category</th>
                                                        <th width="10%">Make</th>
                                                        <th width="10%">Type</th>
                                                        <th width="10%">Size</th>
                                                        <th width="5%">Serial Number</th>
                                                        <th width="5%">Quantity</th>
                                                        <th width="5%">File Download</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.ReceiveInvoiceSavedRecordList)
                                                    {
                                                        <tr>
                                                            @if (item.GenerateBarcode == 1)
                                                            {
                                                                <td>
                                                                    <input type="checkbox" disabled="disabled" checked="checked" name="name" />
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td>
                                                                    <input type="checkbox" disabled="disabled" name="name" />
                                                                </td>
                                                            }

                                                            <td>
                                                                @item.SystemGenBarcode
                                                            </td>
                                                            @*<td>
                                                                @item.WarehouseName
                                                            </td>*@
                                                            <td>
                                                                @item.ProductName
                                                            </td>

                                                            <td>
                                                                @item.PartNumber
                                                            </td>
                                                            <td>
                                                                @item.UPCCode
                                                            </td>
                                                            <td>
                                                                @item.UtilityName
                                                            </td>
                                                            <td>
                                                                @item.CategoryName
                                                            </td>
                                                            <td>
                                                                @item.Make
                                                            </td>
                                                            <td>
                                                                @item.MeterType
                                                            </td>
                                                            <td>
                                                                @item.MeterSize
                                                            </td>
                                                            <td>
                                                                @item.SerialNumber
                                                            </td>
                                                            <td>
                                                                @item.UploadQty
                                                            </td>

                                                            <td style="text-align: center;">
                                                                @if (item.GenerateBarcode == 1)
                                                                {
                                                                    <a href="@item.BarCodeFilePath" target="_blank" class="btn btn-primary btn-xs"><i class="fa fa-print"></i></a>
                                                                }
                                                                else
                                                                {

                                                                }


                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                        <div class="col-lg-12" style="text-align:center">
                            <a href="@Url.Action("Index", "ReceiveInventry")" class="btn btn-primary">Back</a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>



<script>
    $(document).ready(function () {
        $("#InventoryManagement").addClass('active');
        $("#subInventoryManagement").addClass('block');

        $('.sub').find("*").removeClass('active');
        $('#liWebInvenotryRecieve').addClass("active");


        $('#dynamic-table').DataTable({
            "language": { "emptyTable": "No Data To Show" },
            "aaSorting": [],
            "order": [],
        });
    })
</script>


