<link href="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.css")" rel="stylesheet" />
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.jquery.min.js")"></script>
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.proto.min.js")"></script>


@System.Web.Optimization.Scripts.RenderFormat(GarronT.CMS.UI.SiteKeys.ScriptVersion, "~/bundles/Dashboard_js")
<script src='@Url.Content("~/Scripts/jquery.canvasjs.min.js")'></script>

<script>
    var isChosenReinitializing = false;

    $(document).ready(function () {
        // Set initial placeholder text in charts to guide user
        setBudgetChartsPlaceholder();

        // Toggle Switch event handler
        $(".btn-toggle").click(function () {
            var target = $(this).attr("data-target");
            $(".btn-toggle").removeClass("active");
            $(this).addClass("active");

            if (target === "project") {
                $("#budgetDashboardView").fadeOut(300, function () {
                    $("#projectDashboardView").fadeIn(300);
                });
            } else {
                $("#projectDashboardView").fadeOut(300, function () {
                    $("#budgetDashboardView").fadeIn(300, function() {
                        // Re-initialize Chosen when visible to fix the 0px width bug
                        isChosenReinitializing = true;
                        $("#budgetFilterStatus, #budgetFilterUtility, #budgetFilterProject").chosen("destroy").chosen({
                            width: "100%"
                        });
                        isChosenReinitializing = false;
                    });
                });
            }
        });

        // Initialize Chosen dropdowns for budget filters
        $("#budgetFilterStatus, #budgetFilterUtility, #budgetFilterProject").chosen({
            width: "100%"
        });

        // Date pickers
        $("#budgetFromDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "mm/dd/yy",
            onSelect: function (selectedDate) {
                $("#budgetToDate").datepicker("option", "minDate", selectedDate);
                $("#spanBudgetFromDate").text(selectedDate || "From Date").css("color", selectedDate ? "#333" : "#999");
            }
        });

        $("#budgetToDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "mm/dd/yy",
            onSelect: function (selectedDate) {
                $("#budgetFromDate").datepicker("option", "maxDate", selectedDate);
                $("#spanBudgetToDate").text(selectedDate || "To Date").css("color", selectedDate ? "#333" : "#999");
            }
        });

        // Hover and Focus events to simulate Chosen dropdown highlighting on the custom date elements
        $("#budgetFromDate, #budgetToDate").on("focus", function () {
            $(this).parent().addClass("chosen-container-active chosen-with-drop");
        }).on("blur", function () {
            $(this).parent().removeClass("chosen-container-active chosen-with-drop");
        });

        $("#budgetFromDate, #budgetToDate").hover(
            function () {
                $(this).siblings(".chosen-single").css("border-color", "#999");
            },
            function () {
                $(this).siblings(".chosen-single").css("border-color", "#ccc");
            }
        );

        // Cascading filters for budget (only update projects dropdown, do not auto-load dashboard)
        $("#budgetFilterStatus, #budgetFilterUtility").change(function () {
            if (isChosenReinitializing) return;
            loadBudgetProjects();
        });

        // Search Button click handler
        $("#btnSearchBudget").click(function () {
            loadBudgetDashboard();
        });

        // PDF Export click
        $("#btnExportBudgetDashboardPDF").click(function () {
            exportBudgetDashboardToPDF();
        });

        // Populate initial budget projects dropdown
        loadBudgetProjects();
    });

    function setBudgetChartsPlaceholder() {
        var placeholderHtml = "<div style='text-align: center; color: #777; padding-top: 100px; font-style: italic; font-size: 13px;'>Please select filters and click Search to load chart.</div>";
        $("#chartBudgetAllocation, #chartBudgetVsActual, #chartMonthlyBudgetVsActual, #chartServiceLineBreakdown, #chartBudgetVariance").html(placeholderHtml);
    }

    function loadBudgetProjects() {
        var status = $("#budgetFilterStatus").val();
        var utility = $("#budgetFilterUtility").val();

        var getProjectUrl = $("#urlGetBudgetDashboardProjectList").val();

        $.ajax({
            type: "GET",
            url: getProjectUrl,
            data: { utilityType: utility, ProjectStatus: status },
            success: function (data) {
                var ddl = $("#budgetFilterProject");
                ddl.empty();
                ddl.append($("<option value='0'>All Projects</option>"));

                if (data && data.length > 0) {
                    $.each(data, function (index, item) {
                        ddl.append($("<option></option>").val(item.ProjectId).text(item.ProjectCityState || item.ProjectName));
                    });
                }
                ddl.trigger("chosen:updated");
            },
            error: function () {
                toastr["error"]("Unable to load project list.", "Error");
            }
        });
    }

    function loadBudgetDashboard() {
        var status = $("#budgetFilterStatus").val();
        var utility = $("#budgetFilterUtility").val();
        var projectId = $("#budgetFilterProject").val();
        var fromDate = $("#budgetFromDate").val();
        var toDate = $("#budgetToDate").val();

        var url = $("#urlGetBudgetDashboardData").val();

        waitingDialog.show('Loading Please Wait...');

        $.ajax({
            type: "GET",
            url: url,
            data: {
                projectStatus: status,
                utilityType: utility,
                projectId: projectId,
                fromDate: fromDate,
                toDate: toDate
            },
            success: function (res) {
                waitingDialog.hide();
                if (!res.success) {
                    toastr["error"](res.message || "Failed to load budget details.", "Error");
                    return;
                }

                // Update KPIs
                $("#kpiTotalBudget").text(formatCurrency(res.kpis.totalBudget));
                $("#kpiActualSpend").text(formatCurrency(res.kpis.actualSpend));
                $("#kpiRemainingBudget").text(formatCurrency(res.kpis.remainingBudget));
                $("#kpiServiceLineBudget").text(formatCurrency(res.kpis.serviceLineBudget));

                // Render Charts
                renderAllocationChart(res.allocation);
                renderBvAChart(res.budgetVsActual);
                renderMonthlyChart(res.monthlyTrend);
                renderServiceLineChart(res.serviceLineBreakdown);
                renderVarianceChart(res.budgetVariance);

                // Render Table
                renderSummaryTable(res.summaryTable);
            },
            error: function () {
                waitingDialog.hide();
                toastr["error"]("Something went wrong while loading budget dashboard.", "Error");
            }
        });
    }

    function formatCurrency(val) {
        return "$" + parseFloat(val || 0).toLocaleString("en-US", {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        });
    }

    function renderAllocationChart(data) {
        var dps = data.map(function (item) {
            var color = item.label === "Electric" ? "#1a73e8" : (item.label === "Water" ? "#34a853" : "#fbbc05");
            return { y: item.value, label: item.label, percentage: item.percentage, color: color };
        });

        var chart = new CanvasJS.Chart("chartBudgetAllocation", {
            animationEnabled: true,
            theme: "light2",
            data: [{
                type: "doughnut",
                startAngle: 60,
                indexLabel: "{label} - {percentage}%",
                toolTipContent: "<b>{label}:</b> ${y}",
                dataPoints: dps
            }]
        });
        chart.render();
    }

    function renderBvAChart(data) {
        var budgetDps = data.map(function (item) {
            return { y: item.budget, label: item.label };
        });
        var actualDps = data.map(function (item) {
            return { y: item.actual, label: item.label };
        });

        var chart = new CanvasJS.Chart("chartBudgetVsActual", {
            animationEnabled: true,
            theme: "light2",
            axisY: {
                prefix: "$",
                labelFormatter: function(e) {
                    return "$" + (e.value / 1000000) + "M";
                }
            },
            data: [
                {
                    type: "column",
                    name: "Budget",
                    showInLegend: true,
                    color: "#1a73e8",
                    dataPoints: budgetDps
                },
                {
                    type: "column",
                    name: "Actual",
                    showInLegend: true,
                    color: "#34a853",
                    dataPoints: actualDps
                }
            ]
        });
        chart.render();
    }

    function renderMonthlyChart(data) {
        var budgetDps = data.map(function (item) {
            return { y: item.budget, label: item.month };
        });
        var actualDps = data.map(function (item) {
            return { y: item.actual, label: item.month };
        });

        var chart = new CanvasJS.Chart("chartMonthlyBudgetVsActual", {
            animationEnabled: true,
            theme: "light2",
            axisY: {
                prefix: "$",
                labelFormatter: function(e) {
                    return "$" + (e.value / 1000000) + "M";
                }
            },
            data: [
                {
                    type: "line",
                    name: "Budget",
                    showInLegend: true,
                    color: "#1a73e8",
                    dataPoints: budgetDps
                },
                {
                    type: "line",
                    name: "Actual",
                    showInLegend: true,
                    color: "#34a853",
                    dataPoints: actualDps
                }
            ]
        });
        chart.render();
    }

    function renderServiceLineChart(data) {
        var dps = data.map(function (item) {
            return { y: item.value, label: item.label };
        }).reverse();

        var chart = new CanvasJS.Chart("chartServiceLineBreakdown", {
            animationEnabled: true,
            theme: "light2",
            axisX: {
                labelFontSize: 9
            },
            axisY: {
                prefix: "$",
                labelFormatter: function(e) {
                    return "$" + (e.value / 1000000) + "M";
                }
            },
            data: [{
                type: "bar",
                color: "#1a73e8",
                dataPoints: dps
            }]
        });
        chart.render();
    }

    function renderVarianceChart(data) {
        var dps = data.map(function (item) {
            var color = item.variance >= 0 ? "#34a853" : "#d9534f";
            return { y: item.variance, label: item.label, color: color };
        });

        var chart = new CanvasJS.Chart("chartBudgetVariance", {
            animationEnabled: true,
            theme: "light2",
            axisY: {
                prefix: "$",
                labelFormatter: function(e) {
                    return (e.value >= 0 ? "" : "-") + "$" + Math.abs(e.value / 1000000) + "M";
                }
            },
            data: [{
                type: "column",
                dataPoints: dps
            }]
        });
        chart.render();
    }

    function renderSummaryTable(data) {
        var tbody = $("#tblBudgetSummary tbody");
        tbody.empty();

        var totalBudget = 0;
        var totalSpend = 0;

        $.each(data, function (index, item) {
            totalBudget += item.totalBudget;
            totalSpend += item.actualSpend;

            var tr = $("<tr>");
            tr.append($("<td>").text(item.utilityType));
            tr.append($("<td>").text(formatCurrency(item.totalBudget)));
            tr.append($("<td>").text(formatCurrency(item.actualSpend)));
            tr.append($("<td>").text(formatCurrency(item.remainingBudget)));

            var tdProgress = $("<td>");
            tdProgress.append($("<span>").text(item.percentUsed + "%"));
            var progressContainer = $("<div class='progress-bar-container'>");
            var fill = $("<div class='progress-bar-fill'>").css("width", Math.min(item.percentUsed, 100) + "%");
            if (item.percentUsed > 90) fill.css("background-color", "#d9534f");
            else if (item.percentUsed > 75) fill.css("background-color", "#f0ad4e");
            progressContainer.append(fill);
            tdProgress.append(progressContainer);

            tr.append(tdProgress);
            tbody.append(tr);
        });

        var remainingTotal = totalBudget - totalSpend;
        var percentTotal = totalBudget > 0 ? Math.round((100 * totalSpend / totalBudget) * 10) / 10 : 0;

        var trTotal = $("<tr style='font-weight: bold; background: #f8f9fa;'>");
        trTotal.append($("<td>").text("Total"));
        trTotal.append($("<td>").text(formatCurrency(totalBudget)));
        trTotal.append($("<td>").text(formatCurrency(totalSpend)));
        trTotal.append($("<td>").text(formatCurrency(remainingTotal)));

        var tdProgressTotal = $("<td>");
        tdProgressTotal.append($("<span>").text(percentTotal + "%"));
        var progressContainerTotal = $("<div class='progress-bar-container'>");
        var fillTotal = $("<div class='progress-bar-fill'>").css("width", Math.min(percentTotal, 100) + "%");
        progressContainerTotal.append(fillTotal);
        tdProgressTotal.append(progressContainerTotal);

        trTotal.append(tdProgressTotal);
        tbody.append(trTotal);
    }

    function exportBudgetDashboardToPDF() {
        try {
            var c1 = $("#chartBudgetAllocation .canvasjs-chart-canvas").get(0);
            var c2 = $("#chartBudgetVsActual .canvasjs-chart-canvas").get(0);
            var c3 = $("#chartMonthlyBudgetVsActual .canvasjs-chart-canvas").get(0);
            var c4 = $("#chartServiceLineBreakdown .canvasjs-chart-canvas").get(0);
            var c5 = $("#chartBudgetVariance .canvasjs-chart-canvas").get(0);

            if (!c1 || !c2 || !c3 || !c4 || !c5) {
                toastr["warning"]("Charts are still rendering, please try again in a moment.", "Notification");
                return;
            }

            var d1 = c1.toDataURL("image/jpeg", 0.9);
            var d2 = c2.toDataURL("image/jpeg", 0.9);
            var d3 = c3.toDataURL("image/jpeg", 0.9);
            var d4 = c4.toDataURL("image/jpeg", 0.9);
            var d5 = c5.toDataURL("image/jpeg", 0.9);

            var docDefinition = {
                pageMargins: [30, 40, 30, 40],
                content: [
                    { text: "Budget Analysis Dashboard Report", style: "header" },
                    { text: "Date Range: " + ($("#budgetFromDate").val() || "All") + " To " + ($("#budgetToDate").val() || "All"), style: "subheader" },
                    { text: "Project Status: " + $("#budgetFilterStatus").val() + " | Utility: " + $("#budgetFilterUtility").val(), style: "meta" },
                    
                    { text: "\n1. Key Metrics Summary", style: "sectionHeader" },
                    {
                        table: {
                            widths: ["*", "*", "*", "*"],
                            body: [
                                [
                                    { text: "Total Project Budget", bold: true, fillColor: "#1a73e8", color: "#ffffff" },
                                    { text: "Total Actual Spend", bold: true, fillColor: "#34a853", color: "#ffffff" },
                                    { text: "Remaining Budget", bold: true, fillColor: "#fbbc05", color: "#ffffff" },
                                    { text: "Service Line Budget", bold: true, fillColor: "#8844ff", color: "#ffffff" }
                                ],
                                [
                                    $("#kpiTotalBudget").text(),
                                    $("#kpiActualSpend").text(),
                                    $("#kpiRemainingBudget").text(),
                                    $("#kpiServiceLineBudget").text()
                                ]
                            ]
                        },
                        layout: "lightHorizontalLines"
                    },

                    { text: "\n2. Budget Allocation by Utility", style: "sectionHeader" },
                    { image: d1, width: 400, alignment: "center" },

                    { text: "\n3. Budget vs Actual and variance", pageBreak: "before", style: "sectionHeader" },
                    {
                        columns: [
                            {
                                width: "50%",
                                text: "Budget vs Actual\n",
                                bold: true,
                                alignment: "center"
                            },
                            {
                                width: "50%",
                                text: "Budget Variance\n",
                                bold: true,
                                alignment: "center"
                            }
                        ]
                    },
                    {
                        columns: [
                            { image: d2, width: 250 },
                            { image: d5, width: 250 }
                        ]
                    },

                    { text: "\n4. Monthly Trend", pageBreak: "before", style: "sectionHeader" },
                    { image: d3, width: 480, alignment: "center" },

                    { text: "\n5. Service Line Budget Breakdown", pageBreak: "before", style: "sectionHeader" },
                    { image: d4, width: 480, alignment: "center" }
                ],
                styles: {
                    header: {
                        fontSize: 22,
                        bold: true,
                        color: "#1f4e69",
                        alignment: "center",
                        margin: [0, 0, 0, 5]
                    },
                    subheader: {
                        fontSize: 12,
                        alignment: "center",
                        color: "#5f6368",
                        margin: [0, 0, 0, 5]
                    },
                    meta: {
                        fontSize: 10,
                        alignment: "center",
                        color: "#777777",
                        margin: [0, 0, 0, 15]
                    },
                    sectionHeader: {
                        fontSize: 14,
                        bold: true,
                        color: "#202124",
                        margin: [0, 10, 0, 10]
                    }
                }
            };

            pdfMake.createPdf(docDefinition).download("BudgetDashboardReport.pdf");
        } catch (e) {
            toastr["error"]("Failed to export PDF: " + e.message, "Error");
        }
    }
</script>





