@model GarronT.CMS.Model.BO.AppointmentModel
@{
    ViewBag.Title = "Appointment";
    //Layout = "~/Areas/Admin/Views/Shared/_LayoutLogin.cshtml"; 
    Layout = "~/Areas/Global/Views/Shared/_AppointmentLayout.cshtml";

}

<!--Get Active Booking Appointment-->
@Html.Hidden("urlGetProject", Url.Action("GetPoject", "Appointment"))
@Html.Hidden("StateListUrl", Url.Action("GetStateList", "Appointment"))
@Html.Hidden("CityByStateIDListUrl", Url.Action("GetCityList", "Appointment"))
<!--For Inser/Create Old Form-->  
@Html.Hidden("UrlCreate",Url.Action("CreateAppointment","Appointment"))
<!--For check first date-->
@Html.Hidden("UrlChkFirstDate",Url.Action("CheckFirstDateTime","Appointment"))
<!--For check Second date-->
@Html.Hidden("UrlChkSecondDate", Url.Action("CheckSecondDateTime", "Appointment"))
<!--For check Third date-->
@Html.Hidden("UrlChkThirdDate", Url.Action("CheckThirdDateTime", "Appointment"))

<!--Modified method for appointment-->
@Html.Hidden("CreateUrlYcbm", Url.Action("CreateAppointmentUrl", "Appointment"))

@Html.Hidden("GetDetails", Url.Action("GetUserDetails", "Appointment"))

<style>
     #example-select-all {
         margin: 2px -8px 0px 0px !important;
     }


     .form-group-1 {
        /*padding: 13% 0%;*/
     }

     .chosen-select {
         /*width: auto;*/
     }


     .btn-exp {
         width: 14%;
         float: right;
         margin-right: 5px;
     }

     .text-success {
         color: yellow;
         background: yellow;
         /*border-radius: 3px;*/
         font-size: 13px;
         border: 2px solid #000;
     }


     .appnt_form .form-control{
             padding: 20px 5px;
            border-radius: 8px;
            border: 2px solid #565151;
     }
     .main-content {
         /*background: url('../../images/apprequest.jpg')no-repeat;*/
         margin-left:0px !important;
           background-image: url(../../../../images/appointment_bg.jpg);
             /*background-attachment: fixed;*/
             background-size: cover;
     }
     .instal-wrap {
         /*margin-top: -260px;*/

     }
     .panel{
         background:none !important;
     }
   
     .btn-group-lg > .btn, .btn-lg{
         margin-top:0px;
     }
     .white-bg {
         background: #f6f8f7;
         border-bottom: 1px solid #f1f2f7;

     }
     .appnt_form{
         padding: 10% 0% 6% 0%;
     }
     .appointment_bg{     
         background-color: #f6f8f7;
     }
     .bk-appnt-btn{
         padding: 10px 20px;
         border-radius: 8px;

     }
    @@media (max-width:320px) {
        .appnt_form {
             line-height: 5;
        }
         .bk-appnt-btn {
            margin-right: 12%;
            margin-left: 6%;
        }
    }

     @@media only screen and (min-width:321px)and (max-width:410px) and (orientation:portrait){
         .appnt_form {
             line-height: 5;
             text-align:center;
         }
         .bk-appnt-btn {
            margin-right: 12%;
            margin-left: 6%;
        }
          .form-group-1{
                 margin-left: 0%;
         }
     }
       @@media only screen and (min-width:411px)and (max-width:479px) and (orientation:portrait){
         .appnt_form {
             line-height: 5;
            float:right;
            text-align:center;
         }
         .bk-appnt-btn {
            margin-right: 12%;
            margin-left: 6%;
        }
          .form-group-1{
                 margin-left: 0%;
         }
     }
       @@media only screen and (min-width:480px)and (max-width:767px) and (orientation:portrait){
         .appnt_form {
             line-height: 5;
              text-align:center;
         }
         .bk-appnt-btn {
            margin-right: 12%;
            margin-left: 6%;
        }
         .form-group-1{
                 margin-left: 21%;
         }
        
     }

     @@media only screen and (max-width: 767px) and (min-width: 430px) and (orientation:landscape){
         .appnt_form {
             line-height: 5;
            padding: 0% !important;
         }
         .bk-appnt-btn {
            margin-right: 12%;
            margin-left: 6%;
        }
         .form-group-1{
                 margin-left: 21%;
         }
         
     }
    @@media only screen and (min-width:968px) and (max-width:1023px) {
    .rep_date_inp {

             margin-left: -20%;
             width: 120%;
         }

     }
</style>

