<!-- page start-->
<section id="main-content">
    <section class="wrapper instal-wrap">
        <!-- page start-->
        @*<div class="row">
            <div class="col-sm-12" id="m">*@
        <div  id="m">
            <section class="panel">

                <header class="panel-heading">
                    <b>Reason Master </b>

                </header>

                @*<div class="row" style="">

                    <div class="col-lg-12">
                        <div class="container-fluid con_fluid_new">*@
                            <div class="panel-body">
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-xs-4 add_newbtn">
                                        <a class="btn btn-success" id="btnAddReason" data-backdrop="static">
                                            Add New <i class="fa fa-plus"></i>
                                        </a>
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-xs-8 show_deactive deactivated_records">
                                        <input type="checkbox" name="showDeactivate" id="chkShowDeactivate" />Show Deactivated Records
                                    </div>
                                </div>
                                <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                    <thead>
                                        <tr>
                                            <th width="30%">Reason Type</th>
                                            <th width="60%">Reason</th>
                                            <th width="10s%">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        @*</div>

                    </div>*@

                    <div class="clearfix"></div>

                @*</div>*@


            </section>
        </div>
        @*</div>*@
    </section>
</section>

<!-- Modal for Add /Edit Dialog -->
<div class="modal fade modal-dialog-center" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content-wrap">
            <div class="modal-content rsn_dialog ">
                <div class="modal-header">
                    <button type="button" class="close" id="btnClose" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Add New Reason</h4>
                </div>
                <div class="modal-body">
                    <div class="panel-body">
                        <form id="form3" class="cmxform form-horizontal tasi-form">
                            <div class="form-group ">
                                <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label rsn-type-lab">Reason Type<span style="color:red">*</span></label>
                                <div class="col-lg-8 col-sm-8 col-xs-8">
                                    <input type="hidden" name="SkipId" id="SkipId" class="inputclass form-control" />
                                    <select id="ddlReasonType" name="CategoryType" data-placeholder="Select Reason Type" class="inputclass form-control">
                                        <option value="0"></option>
                                        <option value="1">SKIP</option>
                                        <option value="2">RTU</option>
                                        <option value="3">REOPEN</option>
                                    </select>

                                </div>
                            </div>
                            <div class="form-group ">
                                <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label reasn-lab">Reason <span style="color:red">*</span> </label>
                                <div class="col-lg-8 col-sm-8 col-xs-8">
                                    <input type="text" name="SkipReason" id="txtReason" maxlength="250" class="inputclass form-control des_txtbox1" />
                                </div>
                            </div>
                            <div class="form-group" id="divCaptureMedia1">
                                <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label reasn-lab"> </label>
                                <div class="col-lg-8 col-sm-8 col-xs-8">
                                    <input type="checkbox" name="mediaRequired" id="chkImageRequired" /> Capture Image
                                </div>
                            </div>
                            <div class="form-group" id="divCaptureMedia2">
                                <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label reasn-lab"> </label>
                                <div class="col-lg-8 col-sm-8 col-xs-8">
                                    <input type="checkbox" name="mediaRequired" id="chkAudioRequired" /> Capture Audio
                                </div>
                            </div>
                            <div class="form-group" id="divCaptureMedia3">
                                <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label reasn-lab"> </label>
                                <div class="col-lg-8 col-sm-8 col-xs-8">
                                    <input type="checkbox" name="mediaRequired" id="chkVideoRequired" /> Capture Video
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="name" class="col-lg-4 col-sm-4 col-xs-4 control-label reasn-lab">Form Type </label>
                                <div class="col-lg-8 col-sm-8 col-xs-8">
                                    @*<select id="ddlFormType" name="FormType" data-placeholder="Select Form Type" class="inputclass form-control"></select>*@
                                    <div id="divroot">
                                        <div id="divFormType" class=" ">
                                            <div class="chosen-container chosen-container-single " title="" id="ddlFormType_chosen">
                                                <a class="chosen-single chosen-default" id="ancFormType_chosen" tabindex="-1"><span class="" id="FormTypeHeader">Select Form Types</span><div><b></b></div></a>
                                                <div class="chosen-drop">
                                                    <div class="chosen-search"><input type="text" id="txtfilterallAuditor" class="txtfilterall" onkeyup="filterAuditor(this)" autocomplete="off"></div>
                                                    <div class="InstallerFilter row">
                                                        <label style="margin-left: 7px;" class="col-lg-2">
                                                            <input type="checkbox" style="zoom:1.2;" class="chbSelectAll" id="ddlFormType_SelectAll" autocomplete="off" value=" "><span>Select All</span>
                                                        </label>
                                                    </div>
                                                    <ul id="ulFormType" class="chosen-results " style=""></ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSave" class="btn btn-success" type="button">Save</button>
                    <button class="btn btn-danger" id="btnCancel" type="button">Cancel</button>
                    <button class="btn btn-default" id="btnReset" type="button">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- modal -->
<!-- Modal for deactivation -->
<div class="modal fade modal-dialog-center" id="confirmDeactivatedialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content-wrap">
            @*<div class="modal-content metrmke_dialog deact_mter">*@
            <div class="modal-content deactv_rec_mter">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Default Modal Tittle</h4>
                </div>
                <div class="modal-body">

                    <input type="hidden" id="SkipId" />
                    <p>Are you sure to deactivate this record ?</p>

                </div>
                <div class="modal-footer">
                    <button id="btnDeactivateYes" class="btn btn-success" type="button">Yes</button>
                    <button class="btn btn-danger" id="btnDeactivatNo" type="button">No</button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- modal -->
<!-- Modal for confirmActivatedialog -->
<div class="modal fade modal-dialog-center" id="confirmActivatedialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content-wrap modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Default Modal Tittle</h4>
                </div>
                <div class="modal-body">


                    <input type="hidden" id="activationID" />
                    <p>Are you sure to Activate this record ?</p>


                </div>
                <div class="modal-footer">
                    <button id="btnActivateYes" class="btn btn-success" type="button">Yes</button>
                    <button class="btn btn-danger" id="btnActivatNo" type="button">No</button>
                </div>
            </div>
        </div>
    </div>
</div>

