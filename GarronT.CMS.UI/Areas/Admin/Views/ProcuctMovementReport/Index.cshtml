<!-- page start-->


<section id="main-content">
    <section class="wrapper site-min-height">
        @*<div class="row">
            <div class="col-sm-12">*@
        <!--progress bar start-->
        <section class="panel rep_panel">

            <header class="panel-heading rep_header" style="background: #80B2DF; color: #fff;">
                Product Movement Report
                <span class="tools pull-right">
                    <a id="haha" class="fa fa-chevron-down clickdive" href="javascript:;" style="color: #fff; padding-right:10px;"></a>
                </span>
            </header>
            <div class="mbot05">

            </div>
            <div class="panel-body">
                @*<div class="row" style="margin-bottom: 5px;">
                    <div class="col-lg-12 col-sm-12 col-xs-12 rep-box">*@

                <div class="row mbot05">
                    <div class="col-lg-4 col-md-3 col-sm-6 col-xs-6 col-xxs-12 sm-mbot1 xs-mbot1 xxs-mbot2">
                        @Html.DropDownList("UtilityId", (IEnumerable<SelectListItem>)ViewBag.UtilityListItem, new { @class = "form-control chosen-select", @title = "Select Utility" })
                    </div>
                    <div class="col-lg-4 col-md-5 col-sm-6 col-xs-6 col-xxs-12 sm-mbot1 xs-mbot1 xxs-mbot2 md-nopaddingleft sm-nopaddingleft xs-nopaddingleft">
                        @Html.DropDownList("ProjectId", (List<SelectListItem>)ViewBag.ProjectList, new { @class = "form-control chosen-select", @title = "Select Project" })
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 col-xxs-12 flex xxs-mbot2 xxs-block">
                        <label class="control-label"><strong>Serial No. &nbsp;&nbsp;</strong></label>
                        @*<div class="col-lg-9 col-md-9 col-sm-8 col-xs-8">*@
                        <input type="text" name="SerialNumber" id="txtSerialNumber" class="form-control" value="" />
                        @*</div>*@
                    </div>
                </div>
                <div class="row mbot05">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 col-xxs-12 text-center">
                        <input type="button" id="btnSearch" class="btn btn-success" value="Search" />
                        <input type="button" id="btnReset" class="btn btn-danger" value="Reset" />
                    </div>
                </div>
                @*</div>
                    <div class="col-lg-12 col-sm-12 col-xs-12 ">*@
                <div class="table-responsive">

                    <table id="dynamic-table" class="display table table-bordered table-striped dataTable">
                        <thead>
                            <tr>
                                <th>Serial Number</th>
                                <th>Status</th>
                                <th>Location</th>
                                <th>Operation Date</th>
                                <th>LatLong</th>
                                <th>Account</th>
                                <th>Street</th>
                                <th>Project Name</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                    </table>
                </div>
                @*</div>
                    </div>*@
            </div>
        </section>
        @*</div>
            </div>*@


    </section>
</section>



