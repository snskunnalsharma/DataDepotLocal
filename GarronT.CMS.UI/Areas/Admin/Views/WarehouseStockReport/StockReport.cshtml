    function comparisonExportSix(productName, serialNumber, technicianName, status, remainingQty, installerEmail) {
        return {
            productName: productName || "",
            serialNumber: serialNumber || "",
            technicianName: technicianName || "",
            status: status || "",
            remainingQty: (remainingQty !== undefined && remainingQty !== null && remainingQty !== "") ? String(remainingQty) : "",
            installerEmail: installerEmail || ""
        };
    }

    function findStockRowsByNormalizedSerial(serialNorm) {
        var out = [];
        if (!stockDetailModel || stockDetailModel.length === 0 || !serialNorm) return out;
        for (var i = 0; i < stockDetailModel.length; i++) {
            if (normalizeSerial(stockDetailModel[i].serialnumber) === serialNorm) out.push(stockDetailModel[i]);
        }
        return out;
    }

    /** Six columns only; same categories/status text as the Compare popup; row colors in Excel. */
    function buildComparisonExportRows() {
        var rows = [];

        var greenSeen = {};
        (lastCompareGreen || []).forEach(function (g) {
            var sn = g.serialNumber;
            if (!sn || greenSeen[sn]) return;
            greenSeen[sn] = true;
            var stocks = findStockRowsByNormalizedSerial(sn);
            var tech = g.technicianName || "";
            var email = g.installerEmail || "";
            var fileProduct = g.productName || "";
            if (stocks.length === 0) {
                rows.push(comparisonExportSix(fileProduct, sn, tech, "Matched (Green)", "", email));
            } else {
                for (var j = 0; j < stocks.length; j++) {
                    var s = stocks[j];
                    var qty = (s.BalanceQty !== null && s.BalanceQty !== undefined) ? s.BalanceQty : "";
                    rows.push(comparisonExportSix(fileProduct || (s.ProductName || ""), sn, tech, "Matched (Green)", qty, email));
                }
            }
        });

        (lastCompareYellow || []).forEach(function (y) {
            var sn = y.serialNumber;
            if (!sn) return;
            var stocks = findStockRowsByNormalizedSerial(sn);
            if (stocks.length === 0) {
                rows.push(comparisonExportSix("", sn, "", "Inventory Unused (Yellow)", "", ""));
            } else {
                for (var k = 0; k < stocks.length; k++) {
                    var sy = stocks[k];
                    var qtyY = (sy.BalanceQty !== null && sy.BalanceQty !== undefined) ? sy.BalanceQty : "";
                    rows.push(comparisonExportSix(sy.ProductName || "", sn, "", "Inventory Unused (Yellow)", qtyY, ""));
                }
            }
        });

        var redSeen = {};
        (lastCompareRed || []).forEach(function (rItem) {
            var sn = rItem.serialNumber;
            if (!sn || redSeen[sn]) return;
            redSeen[sn] = true;
            rows.push(comparisonExportSix(rItem.productName || "", sn, rItem.technicianName || "", "Installed But Not In Warehouse (Silver)", "1", rItem.installerEmail || ""));
        });

        return rows;
    }

    function downloadComparisonExcel() {
        var pid = parseInt($("#ProjectId").val() || "0", 10);
        if (!comparisonCompareDone) {
            toastr.error("Please run Compare first");
            return;
        }
        var exportRows = buildComparisonExportRows();
        var url = $('#urlDownloadComparisonExcel').val();
        var defaultName = "Warehouse_Comparison_" + pid + "_" + new Date().toISOString().slice(0, 10).replace(/-/g, "") + ".xlsx";

        // Use raw XHR — jQuery $.ajax corrupts binary / blob responses via its data converters (triggers "Download failed").
        var body = $.param({
            projectId: pid,
            exportRowsJson: JSON.stringify(exportRows),
            greenJson: JSON.stringify(lastCompareGreen || []),
            yellowJson: JSON.stringify(lastCompareYellow || []),
            redJson: JSON.stringify(lastCompareRed || [])
        });

        waitingDialog.show("Preparing download...");
        var xhr = new XMLHttpRequest();
        xhr.open("POST", url, true);
        xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
        xhr.responseType = "blob";
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            waitingDialog.hide();
            if (xhr.status >= 200 && xhr.status < 300) {
                var blob = xhr.response;
                if (!blob || blob.size === 0) {
                    toastr.error("Empty file from server");
                    return;
                }
                var ct = (xhr.getResponseHeader("Content-Type") || "").toLowerCase();
                if (ct.indexOf("application/json") >= 0 || ct.indexOf("text/html") >= 0) {
                    var r = new FileReader();
                    r.onload = function () {
                        try {
                            var j = JSON.parse(r.result);
                            toastr.error(j.message || j.Message || "Download failed");
                        } catch (e) {
                            toastr.error("Download failed");
                        }
                    };
                    r.readAsText(blob);
                    return;
                }
                var fileName = defaultName;
                var cd = xhr.getResponseHeader("Content-Disposition");
                if (cd) {
                    var m = /filename\*?=(?:UTF-8''|)([^;\r\n]+)|filename="?([^";\r\n]+)"?/i.exec(cd);
                    var raw = (m && (m[1] || m[2])) ? (m[1] || m[2]).trim() : null;
                    if (raw) {
                        try { fileName = decodeURIComponent(raw.replace(/^"|"$/g, "")); } catch (e) { fileName = raw.replace(/^"|"$/g, ""); }
                    }
                }
                var link = document.createElement("a");
                link.href = window.URL.createObjectURL(blob);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                window.setTimeout(function () { window.URL.revokeObjectURL(link.href); }, 2500);
            } else {
                var errBlob = xhr.response;
                if (errBlob instanceof Blob && errBlob.size > 0 && errBlob.size < 65536) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        try {
                            var j = JSON.parse(reader.result);
                            toastr.error(j.message || j.Message || ("Download failed (" + xhr.status + ")"));
                        } catch (e) {
                            toastr.error("Download failed (" + xhr.status + ")");
                        }
                    };
                    reader.readAsText(errBlob);
                } else {
                    toastr.error("Download failed (" + xhr.status + ")");
                }
            }
        };
        xhr.onerror = function () {
            waitingDialog.hide();
            toastr.error("Network error while downloading");
        };
        xhr.send(body);
    }

