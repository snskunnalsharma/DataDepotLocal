<style>
    /* Toolbar polish for new compare controls */
    .compare-toolbar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-left: 12px;
        flex-wrap: wrap;
    }
    .compare-filename {
        max-width: 240px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #666;
        display:none;
    }
    .compare-legend {
        display:none;
        margin: 8px 0 0 0;
        text-align: left;
    }
    .compare-legend .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-right: 12px;
        margin-bottom: 6px;
        font-size: 12px;
    }
    .compare-legend .swatch {
        width: 14px;
        height: 14px;
        border: 1px solid #ccc;
        display: inline-block;
    }
    .swatch-green { background: #90EE90; }
    .swatch-yellow { background: #FFFF99; }
    .swatch-red { background: #C0C0C0; }

    /* Warehouse Stock Report detail grid column sizing */
    #dynamic-table {
        table-layout: auto;
        width: 100% !important;
    }
    #dynamic-table th,
    #dynamic-table td {
        vertical-align: middle;
        white-space: nowrap;
    }
    #dynamic-table th:nth-child(5),
    #dynamic-table td:nth-child(5),
    #dynamic-table-summary th:nth-child(5),
    #dynamic-table-summary td:nth-child(5) {
        white-space: normal;
        min-width: 120px;
        max-width: 220px;
    }
    #dynamic-table th:nth-child(14),
    #dynamic-table td:nth-child(14),
    #dynamic-table-summary th:nth-child(13),
    #dynamic-table-summary td:nth-child(13),
    #dynamic-table .nowrap-col,
    #dynamic-table-summary .nowrap-col {
        min-width: 110px;
        white-space: normal;
        line-height: 1.35;
        text-align: left;
    }
    #dynamic-table th:nth-child(15),
    #dynamic-table td:nth-child(15) {
        min-width: 70px;
        text-align: center;
        white-space: nowrap;
    }
    #dynamic-table-summary {
        table-layout: auto;
        width: 100% !important;
    }
    #dynamic-table-summary th,
    #dynamic-table-summary td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>
