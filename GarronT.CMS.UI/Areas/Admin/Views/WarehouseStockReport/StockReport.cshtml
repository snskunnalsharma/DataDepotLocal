    var IsSerialNumberRequired;
    function EditRecord(id) {
        var urlEditPermission = $('#urlEditPermission').val();

        $.ajax({
            url: urlEditPermission,
            datatype: "text",
            type: "GET",
            success: function (data) {

                if (data.success === true) {
                    var stockdetailid = id;
                    var stockRecordModel = searchStockRecord(stockdetailid, stockDetailModel);
                    if (stockRecordModel != undefined) {
                        var isserialnumberRequired = stockRecordModel.SerialNumberRequired;
                        IsSerialNumberRequired = isserialnumberRequired;
                        if (isserialnumberRequired) {

                            $("#txtSerialNumber").val(stockRecordModel.serialnumber);
                            $("#hndStockDetailid").val(stockRecordModel.StockDetailId);
                            $("#StockRequestModel").modal({
                                show: true,
                                backdrop: 'static',
                                keyboard: false
                            });
                        }
                        else {

                            $("#hndStockDetailid").val(stockRecordModel.StockDetailId);
                            $("#txtTotalQuantity").val(stockRecordModel.TotalQty);
                            $("#txtBalanceQuantity").val(stockRecordModel.BalanceQty);

                            $("#StockRequestQuantityModel").modal({
                                show: true,
                                backdrop: 'static',
                                keyboard: false
                            });
                        }

                    }
                }
                else {
                    var $toast = toastr["error"](data.returnMessage, "Notification !");
                }
            },
            error: function (request, status, error) {
                var $toast = toastr["error"](request.responseText, "Notification !");
                console.log(request.responseText)
            }
        });




    }

    $('#btnSave').click(function () {

        if (IsSerialNumberRequired) {
            var serialnumber = $("#txtSerialNumber").val();
            if (serialnumber === '') {
                var $toast = toastr["error"]("Please, enter serial number", "Notification");
                return;
            }
            else {
                SaveEditedRecord();
            }

        }
        else {
            var BalanceQuantity = $("#txtBalanceQuantity").val();
            if (BalanceQuantity === '') {
                var $toast = toastr["error"]("Please, enter quantity", "Notification");
                return;
            }
            else {
                SaveEditedRecord();
            }
        }
    });


    $('#btnSaveQuantity').click(function () {

        var BalanceQuantity = $("#txtBalanceQuantity").val();
        if (BalanceQuantity === '') {
            var $toast = toastr["error"]("Please, enter quantity", "Notification");
            return;
        }
        else {
            SaveEditedRecord();
        }
    });

    function SaveEditedRecord() {
        var serialnumber = $("#txtSerialNumber").val();
        var quantity = $("#txtBalanceQuantity").val() || 0;
        var stockDetailId = $("#hndStockDetailid").val();

        waitingDialog.show('Please Wait...');
        var UrlSaveEditedRecord = $('#UrlSaveEditedRecord').val();

        $.ajax({
            url: UrlSaveEditedRecord,
            data: { StockDetailId: stockDetailId, Serialnumber: serialnumber, Quantity: quantity },
            type: 'POST',
            // async: false,
            success: function (data) {
                waitingDialog.hide();
                if (data.Success) {
                    $("#StockRequestModel").modal('hide');
                    $("#StockRequestQuantityModel").modal('hide');

                    var $toast = toastr["success"](data.Message, "Success Notification");
                    LoadGrid()
                }
                else {
                    var $toast = toastr["error"](data.Message, "Error Notification");
                }

            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }

        });
    }


    function searchStockRecord(nameKey, myArray) {

        var stockdetailid = parseInt(nameKey);
        for (var i = 0; i < myArray.length; i++) {
            if (myArray[i].StockDetailId === stockdetailid) {

                return myArray[i];
            }
        }
    }

    function DeleteRecord(stockdetailid) {

        var urlDeletePermission = $('#urlDeletePermission').val();

        $.ajax({
            url: urlDeletePermission,
            datatype: "text",
            type: "GET",
            success: function (data) {

                if (data.success != undefined && data.success == true) {



                    $.confirm({
                        icon: 'fa fa-warning',
                        columnClass: 'col-md-6 col-md-offset-3',
                        closeIcon: true,
                        animationBounce: 2,
                        title: 'Delete Product!',
                        content: 'Do you want to delete the current product?',
                        buttons: {
                            Yes:
                                {
                                    text: 'Yes', //
                                    btnClass: 'btn-danger',
                                    action: function () {
                                        waitingDialog.show('Please Wait...');
                                        var UrlDeleteProductFromStock = $('#UrlDeleteProductFromStock').val();

                                        $.ajax({
                                            url: UrlDeleteProductFromStock,
                                            data: { StockDetailId: stockdetailid },
                                            type: 'GET',
                                            // async: false,
                                            success: function (data) {
                                                waitingDialog.hide();
                                                if (data.Success) {

                                                    var $toast = toastr["success"](data.returnMessage, "Success Notification");
                                                    LoadGrid()
                                                }
                                                else {
                                                    var $toast = toastr["error"](data.returnMessage, "Notification");
                                                }

                                            },
                                            error: function () {
                                                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                                                waitingDialog.hide();
                                            }

                                        });
                                    }
                                },
                            No: {
                                text: 'No',
                                btnClass: 'btn-blue',
                                action: function () {

                                }
                            }
                        }
                    });
                }
                else {
                    var $toast = toastr["error"](data.returnMessage, "Notification !");
                }
            },
            error: function (request, status, error) {
                var $toast = toastr["error"](request.responseText, "Notification !");
                console.log(request.responseText)
            }
        });

    }




</script>
