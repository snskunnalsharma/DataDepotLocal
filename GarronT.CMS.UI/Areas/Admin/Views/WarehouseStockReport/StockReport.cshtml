    var stockDetailModel;
    function LoadGrid() {

        debugger;

        var UtilityId = $("#UtilityId").val();
        if (UtilityId === '0' || UtilityId === '') {
            var $toast = toastr["error"]("Please, select utility", "Notification");
            return;
        }

        var ProjectId = $("#ProjectId").val();
        if (ProjectId === '0' || ProjectId === '') {
            var $toast = toastr["error"]("Please, select project", "Notification");
            return;
        }

        var ddlWarehouseList = [];
        var ulWarehouseList = $('#ulWarehouseId li.highlighted')
        ulWarehouseList.each(function (index, item) { ddlWarehouseList.push($(this).val()) });


        if (ddlWarehouseList.length === 0) {
            var $toast = toastr["error"]("Please, select warehouse", "Notification");
            return;
        }
        // var CategoryId = $("#CategoryId").val();
        var ProductId = $("#ProductId").val();
        var ReportType = $("#ReportType").val();


        if (ReportType == "0") {
            $("#divDetail").hide();
            $("#divSummary").show();
        }
        else {
            $("#divDetail").show();
            $("#divSummary").hide();
        }

        waitingDialog.show('Loading Please Wait...');
        var urlGetStockReport = $("#urlGetStockReport").val();

        $.ajax({
            type: 'POST',
            url: urlGetStockReport,
            async: true,
            data: { projectId: ProjectId, warehouseId: ddlWarehouseList, productId: ProductId, ReportType: ReportType },
            success: function (data) {
                waitingDialog.hide();
                // debugger;
                if (data.success == "false") {
                    var $toast = toastr["error"](data.ErrorMessage, "Notification");
                }
                else {
                    stockDetailModel = data.WarehouseStockReportList;
                    if (ReportType == "0") {
                        BindDataSummery(data.WarehouseStockReportList);
                    }
                    else {
                        BindData(data.WarehouseStockReportList);
                    }

                }

            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                console.log("error " + textStatus);
                console.log("incoming Text " + jqXHR.responseText);
                var $toast = toastr["error"]("something seems wrong", "Notification");
            }

        })
    }


