    function applyWarehouseComparisonIfReady() {
        var pid = parseInt($("#ProjectId").val() || "0", 10);
        if (pid !== 10135 && pid !== 10136) return;
        if ($("#ReportType").val() !== "1") return;

        if (!stockDetailModel || stockDetailModel.length === 0) {
            toastr.error("Please run Search before Compare");
            return;
        }

        var url = $('#urlGetCompletedInventoryForCompare').val();
        waitingDialog.show('Comparing...');
        $.ajax({
            url: url,
            type: 'POST',
            data: { projectId: pid },
            success: function (res) {
                waitingDialog.hide();
                if (!res || !res.success) {
                    toastr.error((res && res.message) ? res.message : "No uploaded inventory found to compare.");
                    return;
                }
                completedInventoryItems = (res.inventoryList || []).map(function (x) {
                    return {
                        productName: x.productName || "",
                        serialNumber: normalizeSerial(x.serialNumber),
                        technicianName: x.technicianName || "",
                        installerEmail: x.installerEmail || ""
                    };
                }).filter(function (x) { return x.serialNumber; });
                completedSerialSet = new Set(completedInventoryItems.map(function (x) { return x.serialNumber; }));

                var systemSet = getSystemSerialSet();
                var green = [];
                var yellow = [];
                var red = [];

                // green: intersection
                completedInventoryItems.forEach(function (x) {
                    if (systemSet.has(x.serialNumber)) green.push(x);
                });
                // yellow: in system only
                systemSet.forEach(function (s) {
                    if (!completedSerialSet.has(s)) {
                        yellow.push({ productName: "", serialNumber: s, technicianName: "", installerEmail: "" });
                    }
                });
                // red: in completed file but not in system
                completedInventoryItems.forEach(function (x) {
                    if (!systemSet.has(x.serialNumber)) red.push(x);
                });

                lastCompareGreen = green;
                lastCompareYellow = yellow;
                lastCompareRed = red;
                comparisonCompareDone = true;

                var greenSet = new Set(green.map(function (x) { return x.serialNumber; }));
                var yellowSet = new Set(yellow.map(function (x) { return x.serialNumber; }));
                colorDetailRows(greenSet, yellowSet);

                saveMissingInventory(pid, red);
                showCompareResultPopup();
                $("#btnDownloadComparison").prop("disabled", false);
            },
            error: function () {
                waitingDialog.hide();
                toastr.error("Compare failed");
            }
        });
    }

