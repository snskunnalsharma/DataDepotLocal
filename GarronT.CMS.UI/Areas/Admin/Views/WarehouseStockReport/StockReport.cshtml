    function normalizeSerial(v) {
        if (!v) return "";
        return v.toString().trim().replace(/\s+/g, "").toUpperCase();
    }

    function getSystemSerialSet() {
        var set = new Set();
        if (!stockDetailModel || stockDetailModel.length === 0) return set;
        for (var i = 0; i < stockDetailModel.length; i++) {
            var s = normalizeSerial(stockDetailModel[i].serialnumber);
            if (s) set.add(s);
        }
        return set;
    }

