                                     '<a  id=' + full.StockDetailId + ' onclick="DeleteRecord(' + full.StockDetailId + ');" class="btn btn-danger btn-xs" role="button" alt="Delete" title="Delete"><i class="fa fa-trash"></i></a>';
                             },
                             "aTargets": [11]
                         }
         ],

     })
        //, $('.dataTables_filter input').attr('maxlength', 50);


    }

    $("#CategoryId").change(function () {
        var categoryId = $("#CategoryId").val();

        waitingDialog.show('Please Wait...');
        var urlGetProductbyCategoryId = $("#urlGetProductbyCategoryId").val();

        $.ajax({
            type: 'GET',
            data: { categoryId: categoryId },
            async: true,
            url: urlGetProductbyCategoryId,
            success: function (data) {

                waitingDialog.hide();
                if (data.statusMessage.Success) {
                    $('#ProductId').empty();

                    var count = data.productList.length;
                    if (count > 0) {

                        $.each(data.productList, function (index, item) {
                            if (index == 0) {
                                $('#ProductId').append(
                                  $('<option></option>').val('0').text("All Product"));
                            }
                            $('#ProductId').append(
                                                  $('<option></option>').val(item.Id).html(item.ProductName)
                                            );

                        });

                    }
                    $('.chosen-select').trigger('chosen:updated');

                }
                else {
                    var $toast = toastr["error"](data.ErrorMessage, "Notification !");
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                console.log("error " + textStatus);
                console.log("incoming Text " + jqXHR.responseText);
                var $toast = toastr["error"]("something seems wrong", "Notification");
            }
        });
    })


