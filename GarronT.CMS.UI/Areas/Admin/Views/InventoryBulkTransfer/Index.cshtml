<link href="~/jquery-confirm-master/css/jquery-confirm.css" rel="stylesheet" />
<script src="~/jquery-confirm-master/js/jquery-confirm.js"></script>

<script>
    var isMobileBrowser = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

    function applyMobileNativePlaceholder($select, sentinelValue, label) {
        if (!isMobileBrowser || !$select || !$select.length) return;
        var v = String(sentinelValue);
        var $opt = $select.find("option").filter(function () { return String($(this).val()) === v; });
        if ($opt.length === 0) {
            $opt = $('<option></option>').val(v).text(label);
            $select.prepend($opt);
        } else {
            $opt = $opt.first();
            $opt.text(label);
            $opt.prependTo($select);
        }
        $select.find("option").prop("selected", false);
        $opt.prop({ hidden: true, selected: true });
    }

    function appendSentinelOptionVal0($select, mobileLabel) {
        var $o = $('<option></option>').val('0');
        if (isMobileBrowser) {
            $o.text(mobileLabel).prop({ hidden: true, selected: true });
        } else {
            $o.text('');
        }
        $select.append($o);
    }

    $(document).ready(function () {

        $("#InventoryReports").addClass('active');
        $("#subReports").addClass('block');

        $('.sub').find("*").removeClass('active');
        $('#liInventoryBulkTransfer').addClass("active");


        if (!isMobileBrowser) {
            $("#UtilityId").chosen({ placeholder_text_single: "Select Utility", no_results_text: "Oops, nothing found!" });
            $('#UtilityId').trigger('chosen:updated');

            $("#ProjectId").chosen({ placeholder_text_single: "Select Project", no_results_text: "Oops, nothing found!" });
            $('#ProjectId').trigger('chosen:updated');
        } else {
            $("#UtilityId option").filter(function () { return $.trim($(this).text()) === ""; }).remove();
            applyMobileNativePlaceholder($("#UtilityId"), "0", "Select Utility");
            applyMobileNativePlaceholder($("#ProjectId"), "0", "Select Project");
            applyMobileNativePlaceholder($("#ProductId"), "0", "Select Product");
            applyMobileNativePlaceholder($("#LocationType"), "0", "Select Location");
            applyMobileNativePlaceholder($("#ddlLocationTo"), "0", "Select Location");
        }

        //$("#WarehouseId").chosen({ placeholder_text_single: "Select Warehouse", no_results_text: "Oops, nothing found!" });
        //$('#WarehouseId').trigger('chosen:updated');



        if (!isMobileBrowser) {
            $("#ProductId").chosen({ placeholder_text_single: "Select Product", no_results_text: "Oops, nothing found!" });
            $('#ProductId').val("0").attr("selected", "selected").trigger('chosen:updated');

            $("#ReportType").chosen();
            $('#ReportType').val("0").attr("selected", "selected").trigger('chosen:updated');
        }

        $('#dynamic-table').DataTable({ "language": { "emptyTable": "No Data To Show" }, "sDom": '<"col-lg-12 drp-rec"lf><"col-lg-12 rep-shw-ent"ip>rt<ip><"clear">', });
        $('#dynamic-table-summary').DataTable({ "language": { "emptyTable": "No Data To Show" }, "sDom": '<"col-lg-12 drp-rec"lf><"col-lg-12 rep-shw-ent"ip>rt<ip><"clear">', });

        if (!isMobileBrowser) {
            $("#LocationType").chosen({ placeholder_text_single: "Select Location", no_results_text: "Oops, nothing found!" });
            $('#LocationType').val("0").attr("selected", "selected").trigger('chosen:updated');
        }

        //$("#ddlLocationFrom").chosen({ placeholder_text_single: "Select Location", no_results_text: "Oops, nothing found!" });
        //$('#ddlLocationFrom').val("0").attr("selected", "selected").trigger('chosen:updated');

        if (!isMobileBrowser) {
            $("#ddlLocationTo").chosen({ placeholder_text_single: "Select Location", no_results_text: "Oops, nothing found!" });
            $('#ddlLocationTo').val("0").attr("selected", "selected").trigger('chosen:updated');
        }

        $("#divDetail").hide();
        $("#divSummary").show();



        //#region warehouse dropdown

        $("#ulWarehouseId").selectable({

            start: function (event, ui) { var target = event.target || event.srcElement; },
            selected: function (event, ui) {
                if ($(ui.selected).hasClass('highlighted')) { $(ui.selected).removeClass('ui-selected click-selected highlighted'); }
                else { $(ui.selected).addClass('click-selected highlighted'); }
            },
            unselected: function (event, ui) { $(ui.unselected).removeClass('click-selected'); },
            stop: function (event, ui) { }
        });

        //#endregion

    })

    //numeric only validation code
    $('body').on('keypress', '.numeric-only', function (e) {
        var regex = new RegExp("^[0-9\b]+$");

        if (event.charCode == 0) {
            return true;
        }
        else {
            var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            if (!regex.test(key)) {
                event.preventDefault();
                return false;
            }
        }
    });

    //#region open/close warehouse dropdown
    $("#ancWarehouseId_chosen").click(function () {

        if ($("#ddlWarehouseId_chosen").hasClass('chosen-container-active')) {

            var selectedlivalue = $('#ulWarehouseId li.highlighted').map(function (i, el) { return $(el).val(); });
            var selectedlilength = selectedlivalue.length;

            if (selectedlilength == 0) {
                $("#VisitStatusHeader").removeClass("ddlHeader").text("Select Visit Status")
            } else {
                $("#VisitStatusHeader").addClass("ddlHeader").text(selectedlilength + " Visit Status selected")
            }

            //#region SelectAll checked/unchecked
            if ($('#ulWarehouseId .liWarehouseId:visible').length > 0 && $('#ulWarehouseId .highlighted:visible').length == $('#ulWarehouseId .liWarehouseId:visible').length) {
                $('#ddlWarehouseId_SelectAll').prop('checked', true);
            } else {
                $('#ddlWarehouseId_SelectAll').prop('checked', false);
            }
            //#endregion


            $("#ddlWarehouseId_chosen").toggleClass("chosen-with-drop chosen-container-active")
        }
        else {
            $("#ddlWarehouseId_chosen").toggleClass("chosen-with-drop chosen-container-active")
        }
    });


    function filterCycle(element) {

        var value = $(element).val().toLowerCase();

        $("#ulWarehouseId > li").each(function () {
            if ($(this).text().toLowerCase().search(value) > -1) { $(this).show(); }
            else { $(this).hide(); }
        });

        //#region SelectAll checked/unchecked
        if ($('#ulWarehouseId .liVisitStatus:visible').length > 0 && $('#ulWarehouseId .highlighted:visible').length == $('#ulWarehouseId .liWarehouseId:visible').length) {
            $('#ddlWarehouseId_SelectAll').prop('checked', true);
        } else {
            $('#ddlWarehouseId_SelectAll').prop('checked', false);
        }
        //#endregion
    }

    $('#ddlWarehouseId_SelectAll').on('click', function () {
        debugger;
        if ($('#ulWarehouseId .liWarehouseId').length > 0) {

            if (this.checked) {
                $("li.liWarehouseId:visible").addClass('ui-selected click-selected highlighted');

                var selectedlitext = $('#ulWarehouseId .highlighted').map(function (i, el) { return $(el)[0].text; });
                var selectedlilength = selectedlitext.length;
                if (selectedlilength == 0) { $("#WarehouseIdHeader").removeClass("ddlHeader").text("Select Warehouse") }
                else { $("#WarehouseIdHeader").addClass("ddlHeader").text(selectedlilength + " Warehouse Selected") }
            }
            else {
                $("li.liWarehouseId:visible").not('.disabledli').removeClass('ui-selected click-selected highlighted');

                var selectedlitext = $('#ulWarehouseId .highlighted').map(function (i, el) { return $(el)[0].text; });
                var selectedlilength = selectedlitext.length;
                if (selectedlilength == 0) { $("#WarehouseIdHeader").removeClass("ddlHeader").text("Select Warehouse") }
                else { $("#WarehouseIdHeader").addClass("ddlHeader").text(selectedlilength + " Warehouse Selected") }
            }


        }
    });

    $('body').on('click', function (e) {
        if (!$('#divWarehouseId').is(e.target)
            && $('#divWarehouseId').has(e.target).length === 0
        ) {

            var selectedlivalue = $('#ulWarehouseId li.highlighted').map(function (i, el) { return $(el).val(); });
            var selectedlilength = selectedlivalue.length;

            if (selectedlilength == 0) {
                $("#WarehouseIdHeader").removeClass("ddlHeader").text("Select Warehouse")
            } else {
                $("#WarehouseIdHeader").addClass("ddlHeader").text(selectedlilength + " Warehouse Selected")
            }

            //#region SelectAll checked/unchecked
            if ($('#ulWarehouseId .liWarehouseId:visible').length > 0 && $('#ulWarehouseId .highlighted:visible').length == $('#ulWarehouseId .liWarehouseId:visible').length) {
                $('#ddlWarehouseId_SelectAll').prop('checked', true);
            } else {
                $('#ddlWarehouseId_SelectAll').prop('checked', false);
            }
            //#endregion
            $('#ddlWarehouseId_chosen').removeClass('chosen-with-drop chosen-container-active');
        }
    });



    $('#UtilityId').change(function () {

        $('#ProjectId').empty().trigger('chosen:updated');
        //$('#WarehouseId').empty().trigger('chosen:updated');
        $('#ulWarehouseId').empty();
        $("#WarehouseIdHeader").removeClass("ddlHeader").text("Select Warehouse")
        $('#ProductId').empty().trigger('chosen:updated');
        $('#LocationType').empty().trigger('chosen:updated');

        var value = $("#UtilityId option:selected")

        waitingDialog.show('Please Wait Loading Contacts...');
        var urlGetProjectList = $('#urlGetProject').val();
        $.ajax({
            type: 'GET',
            data: { "UtilityId": value.val() },
            url: urlGetProjectList,
            success: function (data) {
                $('#ProjectId').empty();
                if (data != null) {
                    appendSentinelOptionVal0($('#ProjectId'), "Select Project");
                    $.each(data, function (index, item) {
                        $('#ProjectId').append($('<option></option>').val(item.ProjectId).html(item.ProjectName));
                    });
                } else if (isMobileBrowser) {
                    appendSentinelOptionVal0($('#ProjectId'), "Select Project");
                }
                $('#ProjectId').trigger('chosen:updated');


                waitingDialog.hide();
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    });


    $('#ProjectId').change(function () {


        //$('#WarehouseId').empty().trigger('chosen:updated');
        $('#ProductId').empty().trigger('chosen:updated');
        $('#LocationType').empty().trigger('chosen:updated');
        var value = $("#ProjectId option:selected")

        waitingDialog.show('Please Wait Loading Contacts...');
        var urlGetWarehouseAndProduct = $('#urlGetWarehouseAndProduct').val();
        $.ajax({
            type: 'GET',
            data: { "ProjectId": value.val() },
            url: urlGetWarehouseAndProduct,
            success: function (data) {


                $('#ulWarehouseId').empty();
                $("#WarehouseIdHeader").removeClass("ddlHeader").text("Select Warehouse")

                if (data.WarehouseList != null) {

                    $.each(data.WarehouseList, function (index, item) {
                        //if (index == 0) { $('#WarehouseId').append($('<option></option>').val('0').html("")); }
                        //$('#WarehouseId').append($('<option></option>').val(item.WarehouseId).html(item.WarehouseName));
                        $('#ulWarehouseId').append($('<li></li>').val(item.WarehouseId).addClass("liWarehouseId active-result").html(item.WarehouseName));
                    });
                }
                //$('#WarehouseId').trigger('chosen:updated');

                if (data.ProductList != null) {
                    appendSentinelOptionVal0($('#ProductId'), "Select Product");
                    $.each(data.ProductList, function (index, item) {
                        $('#ProductId').append($('<option></option>').val(item.Id).html(item.FieldValue));
                    });
                } else if (isMobileBrowser) {
                    appendSentinelOptionVal0($('#ProductId'), "Select Product");
                }
                $('#ProductId').trigger('chosen:updated');

                if (data.LocationType != null) {
                    appendSentinelOptionVal0($('#LocationType'), "Select Location");
                    $.each(data.LocationType, function (index, item) {
                        $('#LocationType').append($('<option></option>').val(item.LocationId).html(item.Location));
                    });
                } else if (isMobileBrowser) {
                    appendSentinelOptionVal0($('#LocationType'), "Select Location");
                }
                $('#LocationType').trigger('chosen:updated');
                waitingDialog.hide();
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    });


    //$("#WarehouseId").change(function () {
    //    // $('#CategoryId').val("0").attr("selected", "selected").trigger('chosen:updated');

    //    $('#ProductId').val("0").attr("selected", "selected").trigger('chosen:updated');


    //})


    $('#btnSearch').click(function () {
        debugger;
        LoadGrid();
    })

    var stockDetailModel;
    function LoadGrid() {

        debugger;

        var UtilityId = $("#UtilityId").val();
        if (UtilityId === '0' || UtilityId === '') {
            var $toast = toastr["error"]("Please, select utility", "Notification");
            return;
        }

        var ProjectId = $("#ProjectId").val();
        if (ProjectId === '0' || ProjectId === '') {
            var $toast = toastr["error"]("Please, select project", "Notification");
            return;
        }

        var ddlWarehouseList = [];
        var ulWarehouseList = $('#ulWarehouseId li.highlighted')
        ulWarehouseList.each(function (index, item) { ddlWarehouseList.push($(this).val()) });


        if (ddlWarehouseList.length === 0) {
            var $toast = toastr["error"]("Please, select warehouse", "Notification");
            return;
        }
        // var CategoryId = $("#CategoryId").val();
        var ProductId = $("#ProductId").val();
        var ReportType = $("#ReportType").val();
        var LocationType = $("#LocationType").val();


        if (ReportType == "0") {
            $("#divDetail").hide();
            $("#divSummary").show();
        }
        else {
            $("#divDetail").show();
            $("#divSummary").hide();
        }

        waitingDialog.show('Loading Please Wait...');
        var urlGetStockReport = $("#urlGetStockReport").val();

        $.ajax({
            type: 'POST',
            url: urlGetStockReport,
            async: true,
