    function TrInv(WarehouseId, ProductId, Location, BalanceQty) {
        debugger;
        var ProjectId = $("#ProjectId").val();
        $("#hndWarehouseId").val(WarehouseId);
        $("#hndProductId").val(ProductId);
        $("#hndLocationFromValue").val(Location);
        document.getElementById("availableQty").value = BalanceQty;
        document.getElementById("enterQty").value = BalanceQty;
        if (Location === "null" || Location === null || Location === "" || Location === undefined) {
            var mdTil = '<h4 class="modal-title"><strong>Transfer From Pending</strong></h4>';
        }
        else {
            var mdTil = '<h4 class="modal-title"><strong>Transfer From ' + Location + '</strong></h4>';
        }
        //var mdTil = '<h4 class="modal-title"><strong>' + Location ? 'Transfer From ' + Location : 'Transfer From Pending' + '</strong></h4>';
        document.getElementById("mdTitle").innerHTML = mdTil
        console.log(ProjectId, WarehouseId, ProductId, Location);

        $('#ddlLocationTo').empty();
        getToLocation(ProjectId, ProductId, Location);

        @*$("#transferInventoryForlocationModal").modal({
            show: true,
            backdrop: 'static',
            keyboard: false
        });*@
    }

    function getToLocation(ProjectId, ProductId, Location) {
        debugger;
        $('#ddlLocationTo').empty().trigger('chosen:updated');
        waitingDialog.show('Please Wait Loading Contacts...');
        var urlToLocationList = $('#urlToLocationList').val();
        $.ajax({
            type: 'GET',
            data: { "ProjectId": ProjectId, ProductId: ProductId, LocationFromValue: Location },
            url: urlToLocationList,
            success: function (data) {
                debugger;
                $('#ddlLocationTo').empty();
                if (data.LocationList != null) {
                    appendSentinelOptionVal0($('#ddlLocationTo'), "Select Location");
                    $.each(data.LocationList, function (index, item) {
                        $('#ddlLocationTo').append($('<option></option>').val(item.LocationId).html(item.Location));
                    });
                } else if (isMobileBrowser) {
                    appendSentinelOptionVal0($('#ddlLocationTo'), "Select Location");
                }
                $('#ddlLocationTo').trigger('chosen:updated');
                waitingDialog.hide();
                $("#transferInventoryForlocationModal").modal({
                    show: true,
                    backdrop: 'static',
                    keyboard: false
                });
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });

    };

    $('#btnTransferInventory').click(function () {
        debugger;

        var LocationToValue = $("#ddlLocationTo").val();
        if (LocationToValue === '0' || LocationToValue === '') {
            var $toast = toastr["error"]("Please, select to location", "Notification");
            return;
        }
        var availableQty = document.getElementById("availableQty").value;
        if (availableQty === '0') {
            var $toast = toastr["error"]("No available inventory", "Notification");
            return;
        }
        var enterQty = document.getElementById("enterQty").value;
        if (enterQty === '') {
            var $toast = toastr["error"]("Please enter quantity", "Notification");
            return;
        }
        else if (enterQty === '0') {
            var $toast = toastr["error"]("Please enter a valid quantity", "Notification");
            return;
        }
        else if (parseInt(availableQty) < parseInt(enterQty)) {
            var $toast = toastr["error"]("The number of entered quantity cannot be more than the available quantity.", "Notification");
            return;
        }

        var ProjectId = $("#ProjectId").val();
        var ddlWarehouseId = $("#hndWarehouseId").val();
        var ProductId = $("#hndProductId").val();
        var LocationFromValue = $("#hndLocationFromValue").val();
        var transferQty = $("#enterQty").val();
        
        waitingDialog.show('Loading Please Wait...');
        var urlGetTransferInventoryDetail = $("#urlGetTransferInventoryDetail").val();

        $.ajax({
            type: 'POST',
            url: urlGetTransferInventoryDetail,
            async: true,
            data: { projectId: ProjectId, warehouseId: ddlWarehouseId, productId: ProductId, locationFromValue: LocationFromValue, transferQty: transferQty },
            success: function (data) {
                waitingDialog.hide();
                // debugger;
                //console.log("result == " + JSON.stringify(data));
                if (data.success == "false") {
                    var $toast = toastr["error"](data.ErrorMessage, "Notification");
                }
                else {
                    debugger;
                    $("#transferInventoryForlocationModal").modal('hide');

                    $("#transferInventoryDetailModal").modal({
                        show: true,
                        backdrop: 'static',
                        keyboard: true
                    });
                    debugger;
                    InventoryTransferDetailData(data.WarehouseStockReportData, LocationToValue);
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                waitingDialog.hide();
                console.log("error " + textStatus);
                console.log("incoming Text " + jqXHR.responseText);
                var $toast = toastr["error"]("something seems wrong", "Notification");
            }

        })
    });

    function InventoryTransferDetailData(varData, LocationToValue) {
        debugger;
        console.log(varData);

        debugger;
        $('#viewTable').empty();
        $.each(varData, function (index, value) {
            debugger;
            var btnCheck = '<input type="checkbox" id=' + value.serialnumber + ' value=' + value.serialnumber + ' name="id[]"  checked>';
            var objLocation = "";
            if (value.Location === "null" || value.Location === null) {
                var objLocation = "";
            }
            else {
                var objLocation = value.Location;
            }
            
            $('#viewTable').append(
                '<tr>' +
                '<td>' + btnCheck + '</td>' +
                '<td>' + objLocation + '</td>' +
                '<td>' + LocationToValue + '</td>' +
                '<td>' + value.ProductDescription + '</td>' +
                '<td>' + value.PartNumber + '</td>' +
                '<td>' + value.UPCCode + '</td>' +
                '<td>' + value.Make + '</td>' +
                '<td>' + value.MeterType + '</td>' +
                '<td>' + value.MeterSize + '</td>' +
                '<td>' + value.serialnumber + '</td>' +
                '</tr>'
            );
            debugger;
        });
    }
    $("#filter").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#dynamic-table-detail-data > tbody > tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });

    $('#btnCompleteTransfer').click(function () {
        debugger;
        var invList = [];
        $("#dynamic-table-detail-data input:checkbox:checked").map(function () {

            if ($(this).val() != "tblHeaderValue") // Removed this value because this is table header value
            {
                invList.push($(this).val());
            }
        }).get();
        if (invList.length > 0) {
            SaveTransferInventory(invList);
        }
    });

    function SaveTransferInventory(invList) {

        var value = $("#ProjectId option:selected");
        var ddlLocationTo = $("#ddlLocationTo").val();
        var WarehouseId = $("#hndWarehouseId").val();
        var ProductId = $("#hndProductId").val();
        waitingDialog.show('Please Wait...');
        var urlTransferInventory = $('#urlTransferInventory').val();

        $.ajax({
            url: urlTransferInventory,
            data: { "ProjectId": value.val(), warehouseId: WarehouseId, productId: ProductId, ToLocation: ddlLocationTo, TransferInventoryList: invList },
            type: 'POST',
            success: function (data) {
                waitingDialog.hide();
                if (data.Success) {
                    $("#transferInventoryDetailModal").modal('hide');
                    LoadGrid();
                    var $toast = toastr["success"](data.Message, "Success Notification");
                }
                else {
                    var $toast = toastr["error"](data.Message, "Error Notification");
                }
            },
            error: function () {
                var $toast = toastr["error"]("something seems wrong", "Error Notification");
                waitingDialog.hide();
            }
        });
    }

