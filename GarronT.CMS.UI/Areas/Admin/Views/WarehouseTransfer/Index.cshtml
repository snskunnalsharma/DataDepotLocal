@{
    ViewBag.Title = "Warehouse Transfer";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Hidden fields for all AJAX URLs -->
<form id="frmWarehouseTransfer" style="display:none;">
    @Html.Hidden("urlGetProductData", Url.Action("GetProductData", "WarehouseTransfer"))
    @Html.Hidden("urlAddInventry", Url.Action("AddInventry", "WarehouseTransfer"))
    @Html.Hidden("urlEditInventry", Url.Action("EditInventry", "WarehouseTransfer"))
    @Html.Hidden("urlSaveInventryList", Url.Action("SaveInventryList", "WarehouseTransfer"))

    @Html.Hidden("urlIndex", Url.Action("Index", "WarehouseTransfer"))
    @Html.Hidden("urlDeleteInventry", Url.Action("DeleteInventry", "WarehouseTransfer"))
    @Html.Hidden("urlInsertSerialNumber", Url.Action("InsertSerialNumber", "WarehouseTransfer"))
    @Html.Hidden("urlResetAllData", Url.Action("ResetAllData", "WarehouseTransfer"))
    @Html.Hidden("urlViewUploadRecords", Url.Action("ViewUploadRecords", "ViewUploadRecords"))

    @Html.Hidden("urlGetProject", Url.Action("GetProject", "WarehouseTransfer"))
    @Html.Hidden("urlGetWarehouseAndProduct", Url.Action("GetWarehouseAndProduct", "WarehouseTransfer"))
    @Html.Hidden("urlViewUpload", Url.Action("ViewUpload", "WarehouseTransfer"))

    <!-- NEW: Hidden field for WarehouseTransfer Save controller -->
    @Html.Hidden("urlWarehouseTransferSave", Url.Action("SaveWarehouseTransfer", "WarehouseTransfer"))
</form>

