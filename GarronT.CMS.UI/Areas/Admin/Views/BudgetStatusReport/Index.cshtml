@{
    ViewBag.Title = "Budget Status Report";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@Html.Hidden("UrlGetProjectByUtility", Url.Action("GetProject", "BudgetStatusReport"))
@Html.Hidden("UrlGetInstallerByProject", Url.Action("GetInstallerList", "BudgetStatusReport"))
@Html.Hidden("UrlGetBudgetStatusReport", Url.Action("GetBudgetStatusReport", "BudgetStatusReport"))
@Html.Hidden("UrlExportBudgetStatusReport", Url.Action("ExportBudgetStatusReport", "BudgetStatusReport"))
@Html.Hidden("UrlGetYearList", Url.Action("GetYearList", "BudgetStatusReport"))
@Html.Hidden("UrlGetWeekDayRangeList", Url.Action("GetWeekDayRangeList", "BudgetStatusReport"))
<link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" />

<style>
        .budget-filter-row {
            margin-top: 18px;
            margin-bottom: 18px;
            display: flex;
            flex-wrap: nowrap;
            align-items: flex-start;
            gap: 10px;
        }

        .budget-filter-item {
            flex: 1 1 0;
            min-width: 110px;
        }

        .budget-filter-item.filter-project {
            flex: 1.8 1 0;
            min-width: 180px;
        }

        .budget-filter-item.filter-period-type {
            flex: 1.1 1 0;
            min-width: 120px;
        }

        .budget-filter-item.period-week {
            flex: 2 1 0;
            min-width: 200px;
        }

        .budget-filter-item .chosen-container {
            width: 100% !important;
        }

            .budget-filter-row .form-control {
                height: 28px;
                padding: 3px 6px;
                font-size: 12px;
                border-radius: 3px;
            }

        .budget-btn-row {
            text-align: center;
            margin-top: 6px;
            margin-bottom: 25px;
        }

            .budget-btn-row .btn {
                padding: 4px 10px;
                font-size: 12px;
                margin-right: 4px;
            }

        #tblBudgetStatusReport thead th,
        #tblServiceLineReport thead th {
            background: linear-gradient(#1f4e69, #133449);
            color: #ffffff;
            text-align: center;
            font-size: 12px;
            vertical-align: middle;
            font-weight: bold;
        }

        #tblBudgetStatusReport tfoot th,
        #tblServiceLineReport tfoot th {
            text-align: center;
            font-size: 12px;
            vertical-align: middle;
            font-weight: bold;
        }

        #tblBudgetStatusReport tbody td,
        #tblServiceLineReport tbody td {
            text-align: center;
            font-size: 12px;
            vertical-align: middle;
        }

        #tblBudgetStatusReport thead th.text-left,
        #tblBudgetStatusReport tbody td.text-left,
        #tblBudgetStatusReport tfoot th.text-left,
        #tblServiceLineReport thead th.text-left,
        #tblServiceLineReport tbody td.text-left,
        #tblServiceLineReport tfoot th.text-left {
            text-align: left !important;
        }

        #tblBudgetStatusReport thead th.text-right,
        #tblBudgetStatusReport tbody td.text-right,
        #tblBudgetStatusReport tfoot th.text-right,
        #tblServiceLineReport thead th.text-right,
        #tblServiceLineReport tbody td.text-right,
        #tblServiceLineReport tfoot th.text-right {
            text-align: right !important;
        }

        #tblBudgetStatusReport th,
        #tblBudgetStatusReport td,
        #tblServiceLineReport th,
        #tblServiceLineReport td {
            padding-right: 5px !important;
            padding-left: 5px !important;
        }


        .budget-date-box {
            height: 28px;
            padding: 3px 6px;
            font-size: 12px;
            border: 1px solid #aaa;
            border-radius: 3px;
            width: 100%;
        }

        .budget-summary-box {
            margin-top: 70px;
            min-height: 160px;
            border-left: 1px solid #f2f2f2;
            padding-left: 35px;
            font-size: 13px;
            font-weight: bold;
        }

            .budget-summary-box .summary-value {
                display: block;
                margin-bottom: 28px;
                font-size: 15px;
            }

        .label-under-budget {
            background: #5cb85c;
            color: #fff;
            padding: 3px 7px;
            border-radius: 3px;
        }

        .label-near-limit {
            background: #f0ad4e;
            color: #fff;
            padding: 3px 7px;
            border-radius: 3px;
        }

        .label-over-budget {
            background: #d9534f;
            color: #fff;
            padding: 3px 7px;
            border-radius: 3px;
        }

        .label-no-budget {
            background: #777;
            color: #fff;
            padding: 3px 7px;
            border-radius: 3px;
        }

        .ui-datepicker {
            z-index: 99999 !important;
            font-size: 12px !important;
            width: 18em !important;
        }

            .ui-datepicker table {
                width: 100% !important;
                font-size: 12px !important;
            }

            .ui-datepicker td span,
            .ui-datepicker td a {
                text-align: center !important;
                padding: 4px !important;
            }

            .ui-datepicker .ui-datepicker-title select {
                font-size: 12px !important;
                height: 24px !important;
                padding: 1px !important;
            }

        .ui-datepicker-buttonpane button {
            font-size: 12px !important;
            padding: 3px 8px !important;
        }

        /* Budget Status Report datepicker fix */
        .datepicker,
        .datepicker-dropdown,
        .datepicker.datepicker-dropdown {
            width: 220px !important;
            max-width: 220px !important;
            min-width: 220px !important;
            padding: 6px !important;
            z-index: 99999 !important;
        }

            .datepicker table {
                width: 100% !important;
                margin: 0 !important;
            }

                .datepicker table tr td,
                .datepicker table tr th {
                    width: 30px !important;
                    height: 26px !important;
                    padding: 3px !important;
                    text-align: center !important;
                    font-size: 12px !important;
                }

            .datepicker .datepicker-switch {
                text-align: center !important;
                font-size: 13px !important;
            }

            .datepicker .prev,
            .datepicker .next {
                width: 28px !important;
                text-align: center !important;
            }

        .datepicker-months table,
        .datepicker-years table,
        .datepicker-days table {
            width: 100% !important;
        }

        .datepicker-dropdown:before,
        .datepicker-dropdown:after {
            display: none !important;
        }
        /* Force budget report datepicker popup below date textbox */
        .datepicker-dropdown {
            position: absolute !important;
            z-index: 99999 !important;
        }

        .datepicker {
            width: 220px !important;
            max-width: 220px !important;
            min-width: 220px !important;
            padding: 6px !important;
            font-size: 12px !important;
        }

            .datepicker table {
                width: 100% !important;
            }

                .datepicker table tr td,
                .datepicker table tr th {
                    width: 30px !important;
                    height: 26px !important;
                    padding: 3px !important;
                    text-align: center !important;
                    font-size: 12px !important;
                }

        .rep-dyanmc-panel,
        .budget-summary-row {
            max-width: 950px;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        .budget-summary-row {
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .budget-summary-card {
            font-size: 13px;
            color: #333;
            padding: 0;
            min-height: 70px;
        }

        .budget-summary-title {
            font-size: 13px;
            font-weight: normal;
            margin-bottom: 8px;
        }

        .budget-summary-item {
            line-height: 20px;
            margin-bottom: 10px;
        }

        .budget-summary-label {
            font-weight: normal;
            margin-right: 4px;
            display: inline-block;
        }

        .budget-summary-value {
            font-weight: normal;
            display: inline-block;
        }

        .budget-summary-divider {
            display: none;
        }

        .budget-amount-card {
            margin-left: 0;
        }

        .budget-period-card {
            text-align: left;
        }

        .budget-summary-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 18px 28px;
        }

        .budget-summary-block {
            flex: 1 1 220px;
            min-width: 0;
        }

        .budget-summary-block .budget-summary-label {
            display: block;
            margin-bottom: 4px;
            line-height: 1.35;
        }

        .budget-summary-block .budget-summary-value {
            display: block;
            font-size: 15px;
        }

        .budget-split-summary-layout {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: flex-start;
        }

        .budget-split-summary-budgets {
            flex: 1 1 420px;
            min-width: 0;
        }

        .budget-split-summary-period {
            flex: 0 1 220px;
            min-width: 180px;
        }

        #tblBudgetStatusReport tbody td.text-left,
        #tblServiceLineReport tbody td.text-left {
            word-break: break-word;
            white-space: normal;
        }

        .report_table .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        @@media (max-width: 991px) {
            .budget-filter-row {
                flex-wrap: wrap;
            }

            .budget-filter-item {
                flex: 1 1 calc(50% - 10px);
                min-width: 140px;
            }

            .budget-filter-item.filter-project,
            .budget-filter-item.period-week {
                flex: 1 1 100%;
            }

            .rep-dyanmc-panel,
            .budget-summary-row {
                max-width: 100%;
            }

            .budget-split-summary-budgets,
            .budget-split-summary-period {
                flex: 1 1 100%;
            }
        }

        @@media (max-width: 1024px) {
            #budgetStatusReportForm .form-control,
            #budgetStatusReportForm select.chosen-select {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box;
            }

            #budgetStatusReportForm select.chosen-select + .chosen-container {
                display: none !important;
            }

            #budgetStatusReportForm .period-daily-from .chosen-container,
            #budgetStatusReportForm .period-daily-to .chosen-container {
                display: block !important;
                width: 100% !important;
                position: relative !important;
            }

            #budgetStatusReportForm .period-daily-from .chosen-single,
            #budgetStatusReportForm .period-daily-to .chosen-single {
                display: block !important;
                height: 34px !important;
                line-height: 32px !important;
                padding: 0 30px 0 12px !important;
                border: 1px solid #ccc !important;
                border-radius: 4px !important;
                background: linear-gradient(to bottom, #ffffff 0%, #eeeeee 100%) !important;
                box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075) !important;
                text-decoration: none !important;
            }

            #budgetStatusReportForm .period-daily-from .chosen-single span,
            #budgetStatusReportForm .period-daily-to .chosen-single span {
                display: block !important;
                margin-right: 0 !important;
                color: #999 !important;
            }

            #budgetStatusReportForm .period-daily-from.has-date-value .chosen-single span,
            #budgetStatusReportForm .period-daily-to.has-date-value .chosen-single span {
                color: #555 !important;
            }

            #budgetStatusReportForm .period-daily-from .chosen-single div b,
            #budgetStatusReportForm .period-daily-to .chosen-single div b {
                display: block !important;
                width: 0;
                height: 0;
                border-left: 4px solid transparent;
                border-right: 4px solid transparent;
                border-top: 5px solid #888;
                position: absolute;
                right: 10px;
                top: 14px;
            }

            #budgetStatusReportForm .period-daily-from .datepicker,
            #budgetStatusReportForm .period-daily-to .datepicker {
                opacity: 0 !important;
                position: absolute !important;
                top: 0 !important;
                left: 0 !important;
                width: 100% !important;
                height: 34px !important;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
                background: transparent !important;
                cursor: pointer !important;
                z-index: 2 !important;
            }

            #budgetStatusReportForm select.chosen-select.mobile-native-select {
                display: block !important;
                position: static !important;
                width: 100% !important;
                max-width: 100% !important;
                height: 34px !important;
                padding: 6px 30px 6px 12px;
                font-size: 14px;
                line-height: 1.42857143;
                color: #555;
                background: linear-gradient(to bottom, #ffffff 0%, #eeeeee 100%);
                border: 1px solid #ccc;
                border-radius: 4px;
                -webkit-appearance: menulist;
                appearance: menulist;
                box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
                clip: auto !important;
                clip-path: none !important;
                opacity: 1 !important;
                text-overflow: ellipsis;
                overflow: hidden;
                white-space: nowrap;
            }

            #budgetStatusReportForm select.chosen-select.mobile-native-select option {
                color: #555;
            }

            #budgetStatusReportForm select.chosen-select.mobile-native-select option[hidden] {
                display: none;
            }
        }

        @@media (max-width: 767px) {
            .budget-filter-item {
                flex: 1 1 100%;
                min-width: 0;
            }

            .budget-summary-card {
                margin-top: 10px;
            }

            #tblBudgetStatusReport thead th,
            #tblServiceLineReport thead th,
            #tblBudgetStatusReport tbody td,
            #tblServiceLineReport tbody td,
            #tblBudgetStatusReport tfoot th,
            #tblServiceLineReport tfoot th {
                font-size: 11px;
                padding: 4px 3px !important;
            }

            .budget-btn-row .btn {
                display: inline-block;
                width: auto;
                margin: 4px 2px;
            }

            .budget-summary-block {
                flex: 1 1 100%;
            }
        }

        @@media (max-width: 480px) {
            .budget-filter-row {
                gap: 8px;
            }

            .panel.rep_panel .panel-body {
                padding: 10px;
            }
        }

        .text-right {
            text-align: right !important;
        }

        .text-left {
            text-align: left !important;
        }

        .text-center {
            text-align: center !important;
        }
    
</style>

<section id="main-content">
    <section class="wrapper">

        <section class="panel rep_panel">
            <header class="panel-heading rep_header" style="background:#80B2DF; color:#fff; margin-top:35px;">
                Budget Status Report
                <span class="tools pull-right">
                    <a class="fa fa-chevron-down clickdive" href="javascript:;" style="color:#fff; padding-right:10px;"></a>
                </span>
            </header>

            <div class="panel-body">

                <form id="budgetStatusReportForm">

                    <div class="row budget-filter-row">

                        <div class="budget-filter-item filter-utility">
                            @Html.DropDownList("UtilityId", (IEnumerable<SelectListItem>)ViewBag.UtilityListItem, new { @class = "form-control chosen-select", @data_placeholder = "Select Utility", @title = "Select Utility" })
                        </div>

                        <div class="budget-filter-item filter-project">
                            <select data-placeholder="Select Project"
                                    id="ddlProject"
                                    name="ProjectId"
                                    class="form-control chosen-select">
                            </select>
                        </div>

                        <div class="budget-filter-item filter-period-type">
                            <select id="ddlReportPeriodType" name="ReportPeriodType" class="form-control chosen-select" data-placeholder="Report Period">
                                <option value="Monthly" selected>Monthly</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Daily">Daily</option>
                            </select>
                        </div>

                        <div class="budget-filter-item period-filter period-year">
                            <select id="ddlYear" name="Year" class="form-control chosen-select" data-placeholder="Select Year">
                            </select>
                        </div>

                        <div class="budget-filter-item period-filter period-month">
                            <select id="ddlMonth" name="Month" class="form-control chosen-select" data-placeholder="Select Month">
                            </select>
                        </div>

                        <div class="budget-filter-item period-filter period-week" style="display: none;">
                            <select id="ddlWeek" name="Week" class="form-control chosen-select" data-placeholder="Select Week Range">
                            </select>
                        </div>

                        <div class="budget-filter-item period-filter period-daily-from" style="display: none;">
                            <div class="chosen-container chosen-container-single" style="width: 100%; position: relative;">
                                <a class="chosen-single" style="cursor: pointer;">
                                    <span id="spanFromDate" style="color: #999;">From Date</span>
                                    <div><b></b></div>
                                </a>
                                <input type="text"
                                       id="txtFromDate"
                                       name="FromDate"
                                       class="form-control datepicker"
                                       placeholder="From Date"
                                       readonly="readonly"
                                       autocomplete="off"
                                       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 2; border: none; background: transparent; padding: 0; margin: 0;" />
                            </div>
                        </div>

                        <div class="budget-filter-item period-filter period-daily-to" style="display: none;">
                            <div class="chosen-container chosen-container-single" style="width: 100%; position: relative;">
                                <a class="chosen-single" style="cursor: pointer;">
                                    <span id="spanToDate" style="color: #999;">To Date</span>
                                    <div><b></b></div>
                                </a>
                                <input type="text"
                                       id="txtToDate"
                                       name="ToDate"
                                       class="form-control datepicker"
                                       placeholder="To Date"
                                       readonly="readonly"
                                       autocomplete="off"
                                       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 2; border: none; background: transparent; padding: 0; margin: 0;" />
                            </div>
                        </div>

                    </div>

                    <div class="row budget-btn-row">
                        <button id="btnSearch" class="btn btn-success" type="button">Search</button>
                        <button id="btnReset" class="btn btn-danger" type="button">Reset</button>
                        <button id="btnExport" class="btn btn-success" type="button">Export</button>
                    </div>

                </form>

            </div>
        </section>

        <section class="panel dynamic_panel rep-dyanmc-panel">
            <div class="panel-body report_table">
                <div class="table-responsive rep_dyn_table">

                    <table id="tblBudgetStatusReport" class="display table table-bordered table-striped dataTable" style="width: 100% !important;">
                        <thead>
                            <tr>
                                <th style="width: 5%;">SrNo.</th>
                                <th class="text-left">Service Description</th>
                                <th class="text-right" style="width: 12%;">Unit Cost ($)</th>
                                <th class="text-right" style="width: 10%;">Total Count</th>
                                <th class="text-right" style="width: 15%;">Total Cost ($)</th>
                            </tr>
                        </thead>
                        <tfoot style="display: none;">
                            <tr>
                                <th></th>
                                <th class="text-left">Total</th>
                                <th class="text-right"></th>
                                <th class="text-right"></th>
                                <th class="text-right"></th>
                            </tr>
                        </tfoot>
                        <tbody></tbody>
                    </table>

                </div>
            </div>
        </section>

        <!-- Split Mode Summary: Table 1 Summary -->
        <div class="row budget-summary-row" id="rowTable1Summary" style="display: none;">
            <div class="col-xs-12">
                <div class="budget-summary-grid">
                    <div class="budget-summary-block">
                        <span class="budget-summary-label"><b>Project Starting Budget ($)</b></span>
                        <span class="budget-summary-value" id="lblSplitApprovedProjectBudget">0.00</span>
                    </div>
                    <div class="budget-summary-block">
                        <span class="budget-summary-label"><b>Period Used Budget ($)</b></span>
                        <span class="budget-summary-value" id="lblSplitUsedBudget">0.00</span>
                    </div>
                    <div class="budget-summary-block">
                        <span class="budget-summary-label"><b>Ending Project Budget Balance ($)</b></span>
                        <span class="budget-summary-value" id="lblSplitBalanceBudget">0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table 2 Panel (Service Line table) -->
        <section id="panelServiceLineReport" class="panel dynamic_panel rep-dyanmc-panel" style="display: none; margin-top: 20px;">
            <div class="panel-body report_table">
                <div class="table-responsive rep_dyn_table">

                    <table id="tblServiceLineReport" class="display table table-bordered table-striped dataTable" style="width: 100% !important;">
                        <thead>
                            <tr>
                                <th style="width: 5%;">SrNo.</th>
                                <th class="text-left">Service Description</th>
                                <th class="text-right" style="width: 12%;">Unit Cost ($)</th>
                                <th class="text-right" style="width: 10%;">Total Count</th>
                                <th class="text-right" style="width: 15%;">Total Cost ($)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                </div>
            </div>
        </section>

        <div class="row budget-summary-row" id="rowNormalSummary">

            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="budget-summary-card budget-amount-card">
                    <div class="budget-summary-item">
                        <span class="budget-summary-label"><b>Project Starting Budget ($)</b></span>
                        <span class="budget-summary-value" id="lblApprovedProjectBudget">0.00</span>
                    </div>
                    <div class="budget-summary-item">
                        <span class="budget-summary-label"><b>Period Used Budget ($)</b></span>
                        <span class="budget-summary-value" id="lblUsedBudget">0.00</span>
                    </div>
                    <div class="budget-summary-item">
                        <span class="budget-summary-label"><b>Ending Project Budget Balance ($)</b></span>
                        <span class="budget-summary-value" id="lblBalanceBudget">0.00</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="budget-summary-card budget-period-card">
                    <div class="budget-summary-title">
                        <b>Report Period</b> <span id="lblReportPeriodType"></span>
                    </div>
                    <div class="budget-summary-item">
                        <span class="budget-summary-label"><b>From Date</b></span>
                        <span class="budget-summary-value" id="lblFromDate">-</span>
                    </div>
                    <div class="budget-summary-item">
                        <span class="budget-summary-label"><b>To Date</b></span>
                        <span class="budget-summary-value" id="lblToDate">-</span>
                    </div>
                </div>
            </div>

        </div>



        <!-- Split Mode Summary: Table 2 Summary -->
        <div class="row budget-summary-row" id="rowTable2Summary" style="display: none;">
            <div class="col-xs-12">
                <div class="budget-split-summary-layout">
                    <div class="budget-split-summary-budgets">
                        <div class="budget-summary-grid">
                            <div class="budget-summary-block">
                                <span class="budget-summary-label"><b>Service Line Starting Budget ($)</b></span>
                                <span class="budget-summary-value" id="lblServiceLineBudget">0.00</span>
                            </div>
                            <div class="budget-summary-block">
                                <span class="budget-summary-label"><b>Period Used Service Line Budget ($)</b></span>
                                <span class="budget-summary-value" id="lblServiceLineUsedBudget">0.00</span>
                            </div>
                            <div class="budget-summary-block">
                                <span class="budget-summary-label"><b>Ending Service Line Budget Balance ($)</b></span>
                                <span class="budget-summary-value" id="lblServiceLineBalanceBudget">0.00</span>
                            </div>
                        </div>
                    </div>
                    <div class="budget-split-summary-period">
                        <div class="budget-summary-card budget-period-card">
                            <div class="budget-summary-title">
                                <b>Report Period</b> <span id="lblSplitReportPeriodType"></span>
                            </div>
                            <div class="budget-summary-item">
                                <span class="budget-summary-label"><b>From Date</b></span>
                                <span class="budget-summary-value" id="lblSplitFromDate">-</span>
                            </div>
                            <div class="budget-summary-item">
                                <span class="budget-summary-label"><b>To Date</b></span>
                                <span class="budget-summary-value" id="lblSplitToDate">-</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
</section>

<link href="@Url.Content("~/Scripts/js/jquery-ui.css")" rel="stylesheet" />
<link href="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.css")" rel="stylesheet" />
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.jquery.min.js")"></script>
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.proto.min.js")"></script>
<script src="@Url.Content("~/Scripts/js/jquery-ui.js")"></script>

<script>
    var BUDGET_MOBILE_MAX_WIDTH = 1024;
    var budgetChosenInitialized = false;

    function isBudgetMobileView() {
        return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || window.innerWidth <= BUDGET_MOBILE_MAX_WIDTH;
    }

    function getBudgetSelectPlaceholder($select) {
        return $select.data("placeholder") || $select.attr("data-placeholder") || $select.attr("title") || "Select";
    }

    function applyBudgetMobilePlaceholder($select, label) {
        if (!isBudgetMobileView() || !$select || !$select.length) {
            return;
        }

        var placeholderLabel = label || getBudgetSelectPlaceholder($select);
        $select.find('option[value=""]').remove();
        $select.prepend(
            $('<option></option>')
                .val("")
                .text(placeholderLabel)
                .prop({ hidden: true, selected: true })
        );
    }

    function appendBudgetSelectPlaceholder($select, label) {
        if (!$select || !$select.length) {
            return;
        }

        var placeholderLabel = label || getBudgetSelectPlaceholder($select);
        $select.find('option[value=""]').remove();

        if (isBudgetMobileView()) {
            $select.prepend(
                $('<option></option>')
                    .val("")
                    .text(placeholderLabel)
                    .prop({ hidden: true, selected: true })
            );
        } else {
            $select.prepend(
                $('<option></option>')
                    .val("")
                    .text("")
                    .prop({ disabled: true, selected: true })
            );
        }
    }

    function resetBudgetSelectOptions($select, label) {
        $select.empty();
        appendBudgetSelectPlaceholder($select, label);
    }

    function updateBudgetSelectTitles() {
        if (!isBudgetMobileView()) {
            return;
        }

        $("#budgetStatusReportForm .chosen-select.mobile-native-select").each(function () {
            var text = $(this).find("option:selected").text();
            $(this).attr("title", text || "");
        });
    }

    function destroyBudgetChosenSelects() {
        $("#budgetStatusReportForm .chosen-select").each(function () {
            var $el = $(this);
            if ($el.next(".chosen-container").length) {
                $el.chosen("destroy");
            }
        });
        budgetChosenInitialized = false;
    }

    function enableBudgetMobileNativeSelects() {
        $("#budgetStatusReportForm .chosen-select").addClass("mobile-native-select");
        applyBudgetMobilePlaceholder($("#UtilityId"), "Select Utility");
        applyBudgetMobilePlaceholder($("#ddlProject"), "Select Project");
        applyBudgetMobilePlaceholder($("#ddlYear"), "Select Year");
        applyBudgetMobilePlaceholder($("#ddlMonth"), "Select Month");
        applyBudgetMobilePlaceholder($("#ddlWeek"), "Select Week Range");
        updateBudgetSelectTitles();
    }

    function initBudgetSelects() {
        if (isBudgetMobileView()) {
            destroyBudgetChosenSelects();
            enableBudgetMobileNativeSelects();
        } else {
            $("#budgetStatusReportForm .chosen-select").removeClass("mobile-native-select");
            if (!budgetChosenInitialized) {
                $("#budgetStatusReportForm .chosen-select").chosen({
                    no_results_text: "Oops, nothing found!",
                    width: "100%"
                });
                budgetChosenInitialized = true;
            } else {
                refreshBudgetSelects();
            }
        }
    }

    function refreshBudgetSelects(selector) {
        var $targets = selector ? $(selector) : $("#budgetStatusReportForm .chosen-select");

        if (isBudgetMobileView()) {
            $targets.each(function () {
                var $select = $(this);
                if ($select.val() === "" || $select.val() === null) {
                    applyBudgetMobilePlaceholder($select, getBudgetSelectPlaceholder($select));
                }
            });
            updateBudgetSelectTitles();
        } else {
            $targets.trigger("chosen:updated");
            $targets.trigger("liszt:updated");
        }
    }

    $(document).ready(function () {

        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "1500",
            extendedTimeOut: "500",
            showDuration: "200",
            hideDuration: "300"
        };
        $("#Reports").addClass("active");
        $("#subReports").addClass("block");

        $('.sub').find("*").removeClass('active');
        $('#liBudgetStatusReport').addClass("active");

        appendBudgetSelectPlaceholder($("#ddlProject"), "Select Project");
        appendBudgetSelectPlaceholder($("#ddlYear"), "Select Year");
        appendBudgetSelectPlaceholder($("#ddlMonth"), "Select Month");
        appendBudgetSelectPlaceholder($("#ddlWeek"), "Select Week Range");

        initBudgetSelects();
        initMonthList();
        togglePeriodFilters();
        resetPeriodDropdowns();
        setDefaultDates();

        // Override jQuery UI datepicker _updateDatepicker to add custom Ok and Close buttons
        var old_updateDatepicker = $.datepicker._updateDatepicker;
        $.datepicker._updateDatepicker = function (inst) {
            old_updateDatepicker.apply(this, arguments);

            var buttonPane = inst.dpDiv.find(".ui-datepicker-buttonpane");
            if (buttonPane.length > 0) {
                buttonPane.empty();

                // Add Close Button
                $("<button>", {
                    text: "Close",
                    type: "button",
                    class: "ui-datepicker-close ui-state-default ui-priority-secondary ui-corner-all",
                    click: function () {
                        inst.input.datepicker("hide");
                    }
                }).appendTo(buttonPane);

                // Add Today Button
                $("<button>", {
                    text: "Today",
                    type: "button",
                    class: "ui-datepicker-close ui-state-default ui-priority-primary ui-corner-all",
                    click: function () {
                        var today = new Date();
                        inst.input.datepicker("setDate", today);
                        var dateStr = $.datepicker.formatDate("mm/dd/yy", today);
                        var selectHandler = inst.input.datepicker("option", "onSelect");
                        if (selectHandler) {
                            selectHandler.apply(inst.input[0], [dateStr, inst]);
                        }
                        inst.input.datepicker("hide");
                    }
                }).appendTo(buttonPane);
            }
        };

        $(".datepicker").datepicker({
            changeMonth: true,
            changeYear: true,
            showButtonPanel: true,
            dateFormat: "mm/dd/yy",
            beforeShow: function (input, inst) {
                $(input).parent().addClass("chosen-container-active chosen-with-drop");
                setTimeout(function () {
                    var offset = $(input).offset();
                    var height = $(input).outerHeight();

                    inst.dpDiv.css({
                        top: offset.top + height + 2,
                        left: offset.left,
                        zIndex: 99999
                    });
                }, 0);
            },
            onClose: function (dateText, inst) {
                $(this).parent().removeClass("chosen-container-active chosen-with-drop");
            }
        });

        $("#txtFromDate").datepicker("option", "onSelect", function (selectedDate) {
            $("#txtToDate").datepicker("option", "minDate", selectedDate);
            updateDateFieldDisplay("#txtFromDate", selectedDate, "From Date");

            if (!selectedDate || selectedDate === "") {
                clearDatefield("#txtToDate");
            }
        });

        $("#txtToDate").datepicker("option", "onSelect", function (selectedDate) {
            $("#txtFromDate").datepicker("option", "maxDate", selectedDate);
            updateDateFieldDisplay("#txtToDate", selectedDate, "To Date");
        });

        // Hover and Focus events to simulate Chosen dropdown highlighting on the custom date elements
        $("#txtFromDate, #txtToDate").on("focus", function () {
            $(this).parent().addClass("chosen-container-active chosen-with-drop");
        }).on("blur", function () {
            $(this).parent().removeClass("chosen-container-active chosen-with-drop");
        });

        $("#txtFromDate, #txtToDate").hover(
            function () {
                $(this).siblings(".chosen-single").css("border-color", "#999");
            },
            function () {
                $(this).siblings(".chosen-single").css("border-color", "#ccc");
            }
        );

        $("#ddlProject").on("chosen:showing_dropdown", function () {
            var utilityId = $("#UtilityId").val();
            if (!utilityId || utilityId === "0" || utilityId === "") {
                setTimeout(function () {
                    $("#ddlProject").trigger("chosen:close");
                }, 0);
                toastr["warning"]("Select Utility first");
            }
        });

        $("#ddlYear, #ddlMonth, #ddlWeek").on("chosen:showing_dropdown", function () {
            var projectId = $("#ddlProject").val();
            if (!projectId || projectId === "") {
                setTimeout(function () {
                    $(this).trigger("chosen:close");
                }.bind(this), 0);
                toastr["warning"]("Select Project first");
            }
        });

        $("#txtFromDate").on("mousedown focus", function (e) {
            var projectId = $("#ddlProject").val();
            if (!projectId || projectId === "") {
                e.preventDefault();
                e.stopPropagation();
                $(this).blur();
                toastr["warning"]("Select Project first");
                return false;
            }
        });

        $("#txtToDate").on("mousedown focus", function (e) {
            var fromDate = $("#txtFromDate").val();
            if (!fromDate || fromDate === "") {
                e.preventDefault();
                e.stopPropagation();
                $(this).blur();
                toastr["warning"]("Select From Date first");
                return false;
            }
        });

        $("#UtilityId").off("change").on("change", function () {
            var utilityId = $(this).val();

            resetProjectDropdown();
            resetPeriodDropdowns();
            clearDatefield("#txtFromDate");
            clearDatefield("#txtToDate");

            if (utilityId && utilityId !== "0" && utilityId !== "") {
                loadProjectList(utilityId);
            }
        });

        $("#ddlProject").off("change").on("change", function () {
            resetPeriodDropdowns();
            clearDatefield("#txtFromDate");
            clearDatefield("#txtToDate");
            loadYearList($(this).val());
        });

        $("#ddlReportPeriodType").off("change").on("change", function () {
            resetPeriodDropdowns();
            clearDatefield("#txtFromDate");
            clearDatefield("#txtToDate");
            togglePeriodFilters();
            var projectId = $("#ddlProject").val();
            if (projectId) {
                loadYearList(projectId);
            }
        });

        $("#ddlYear").off("change").on("change", function () {
            $("#ddlWeek").find("option:not([value=''])").remove();
            appendBudgetSelectPlaceholder($("#ddlWeek"), "Select Week Range");
            refreshBudgetSelects("#ddlWeek");
            var periodType = $("#ddlReportPeriodType").val();
            if (periodType === "Weekly" && $("#ddlProject").val()) {
                loadWeekList($("#ddlProject").val(), $(this).val());
            }
        });

        resetProjectDropdown();
        bindBudgetStatusReportTable([]);

        $("#btnSearch").click(function () {
            getBudgetStatusReport();
        });

        $("#btnReset").click(function () {
            $("#UtilityId").val("");
            applyBudgetMobilePlaceholder($("#UtilityId"), "Select Utility");
            refreshBudgetSelects("#UtilityId");

            resetProjectDropdown();
            resetPeriodDropdowns();
            $("#ddlReportPeriodType").val("Monthly");
            togglePeriodFilters();

            setDefaultDates();
            clearDatefield("#txtFromDate");
            clearDatefield("#txtToDate");

            bindBudgetStatusReportTable([]);

            if ($.fn.DataTable.isDataTable("#tblServiceLineReport")) {
                $("#tblServiceLineReport").DataTable().destroy();
            }
            $("#tblServiceLineReport tbody").empty();
            $("#panelServiceLineReport").hide();
            $("#rowTable1Summary").hide();
            $("#rowTable2Summary").hide();
            $("#rowNormalSummary").show();

            resetBudgetSummary();
            refreshBudgetSelects("#ddlReportPeriodType");
        });

        $("#btnExport").click(function () {
            exportBudgetStatusReport();
        });

        $("#budgetStatusReportForm .chosen-select").on("change", updateBudgetSelectTitles);

        $(window).on("resize", function () {
            clearTimeout(window.budgetSelectResizeTimer);
            window.budgetSelectResizeTimer = setTimeout(function () {
                var isMobile = isBudgetMobileView();
                var wasMobile = $("#budgetStatusReportForm .chosen-select").first().hasClass("mobile-native-select");
                if (isMobile !== wasMobile) {
                    budgetChosenInitialized = false;
                    initBudgetSelects();
                }
            }, 200);
        });
    });

    function clearDatefield(selector) {
        var $input = $(selector);
        $input.val("");
        if (selector === "#txtFromDate") {
            $("#spanFromDate").text("From Date").css("color", "#999");
            $(".period-daily-from").removeClass("has-date-value");
            $("#lblFromDate").text("-");
            if ($("#txtFromDate").hasClass("hasDatepicker")) {
                $("#txtFromDate").datepicker("option", "maxDate", null);
            }
        } else if (selector === "#txtToDate") {
            $("#spanToDate").text("To Date").css("color", "#999");
            $(".period-daily-to").removeClass("has-date-value");
            $("#lblToDate").text("-");
            if ($("#txtToDate").hasClass("hasDatepicker")) {
                $("#txtToDate").datepicker("option", "minDate", null);
            }
        }
    }

    function updateDateFieldDisplay(inputSelector, selectedDate, placeholderText, wrapperClass) {
        var displayText = selectedDate || placeholderText;
        var hasValue = !!selectedDate;

        if (inputSelector === "#txtFromDate") {
            $("#spanFromDate").text(displayText).css("color", hasValue ? "#333" : "#999");
            $(".period-daily-from").toggleClass("has-date-value", hasValue);
            $("#lblFromDate").text(selectedDate || "-");
        } else if (inputSelector === "#txtToDate") {
            $("#spanToDate").text(displayText).css("color", hasValue ? "#333" : "#999");
            $(".period-daily-to").toggleClass("has-date-value", hasValue);
            $("#lblToDate").text(selectedDate || "-");
        }
    }

    function initMonthList() {
        var months = [
            { id: 1, name: "January" }, { id: 2, name: "February" }, { id: 3, name: "March" },
            { id: 4, name: "April" }, { id: 5, name: "May" }, { id: 6, name: "June" },
            { id: 7, name: "July" }, { id: 8, name: "August" }, { id: 9, name: "September" },
            { id: 10, name: "October" }, { id: 11, name: "November" }, { id: 12, name: "December" }
        ];

        $("#ddlMonth").find("option:not([value=''])").remove();
        $.each(months, function (index, item) {
            $("#ddlMonth").append($("<option></option>").val(item.id).text(item.name));
        });
        appendBudgetSelectPlaceholder($("#ddlMonth"), "Select Month");
        refreshBudgetSelects("#ddlMonth");
    }

    function togglePeriodFilters() {
        var periodType = $("#ddlReportPeriodType").val() || "Monthly";

        $(".period-filter").hide();

        if (periodType === "Monthly") {
            $(".period-year").show();
            $(".period-month").show();
        } else if (periodType === "Weekly") {
            $(".period-year").show();
            $(".period-week").show();
        } else if (periodType === "Daily") {
            $(".period-daily-from").show();
            $(".period-daily-to").show();
            updateDateFieldDisplay("#txtFromDate", $("#txtFromDate").val(), "From Date");
            updateDateFieldDisplay("#txtToDate", $("#txtToDate").val(), "To Date");
        }

        refreshBudgetSelects("#ddlYear");
        refreshBudgetSelects("#ddlMonth");
        refreshBudgetSelects("#ddlWeek");
    }

    function resetPeriodDropdowns() {
        $("#ddlYear").find("option:not([value=''])").remove();
        $("#ddlWeek").find("option:not([value=''])").remove();
        appendBudgetSelectPlaceholder($("#ddlYear"), "Select Year");
        appendBudgetSelectPlaceholder($("#ddlWeek"), "Select Week Range");
        appendBudgetSelectPlaceholder($("#ddlMonth"), "Select Month");
        refreshBudgetSelects("#ddlYear");
        refreshBudgetSelects("#ddlMonth");
        refreshBudgetSelects("#ddlWeek");
    }

    function loadYearList(projectId) {
        if (!projectId) {
            resetPeriodDropdowns();
            return;
        }

        var url = $("#UrlGetYearList").val();
        resetBudgetSelectOptions($("#ddlYear"), "Select Year");
        refreshBudgetSelects("#ddlYear");

        $.ajax({
            url: url,
            type: "GET",
            data: { projectId: projectId },
            success: function (response) {
                if (response && response.success === false) {
                    toastr["error"](response.returnMessage || "Unable to load year list.", "Error");
                    return;
                }

                $("#ddlYear").find("option:not([value=''])").remove();
                if (response && response.length > 0) {
                    $.each(response, function (index, item) {
                        $("#ddlYear").append(
                            $("<option></option>")
                                .val(item.YearId || item.yearId)
                                .text(item.YearName || item.yearName)
                        );
                    });
                }
                appendBudgetSelectPlaceholder($("#ddlYear"), "Select Year");
                refreshBudgetSelects("#ddlYear");
            },
            error: function () {
                toastr["error"]("Unable to load year list.", "Error");
            }
        });
    }

    function loadWeekList(projectId, year) {
        if (!projectId || !year) {
            return;
        }

        var url = $("#UrlGetWeekDayRangeList").val();
        resetBudgetSelectOptions($("#ddlWeek"), "Select Week Range");
        refreshBudgetSelects("#ddlWeek");

        $.ajax({
            url: url,
            type: "GET",
            data: { year: year, projectId: projectId },
            success: function (response) {
                if (response && response.success === false) {
                    toastr["error"](response.returnMessage || "Unable to load week list.", "Error");
                    return;
                }

                $("#ddlWeek").find("option:not([value=''])").remove();
                if (response && response.length > 0) {
                    $.each(response, function (index, item) {
                        $("#ddlWeek").append(
                            $("<option></option>")
                                .val(item.WeekRangeDate)
                                .text(item.DisplayWeekRangeDate)
                        );
                    });
                }
                appendBudgetSelectPlaceholder($("#ddlWeek"), "Select Week Range");
                refreshBudgetSelects("#ddlWeek");
            },
            error: function () {
                toastr["error"]("Unable to load week list.", "Error");
            }
        });
    }

    function formatDateValue(dateObj) {
        var month = dateObj.getMonth() + 1;
        var day = dateObj.getDate();
        var year = dateObj.getFullYear();
        return (month < 10 ? "0" : "") + month + "/" + (day < 10 ? "0" : "") + day + "/" + year;
    }

    function parseWeekRange(weekRangeValue) {
        if (!weekRangeValue) {
            return null;
        }

        var parts = weekRangeValue.split(",");
        if (parts.length < 2) {
            return null;
        }

        var fromDate = new Date(parts[0].trim().split(" ")[0]);
        var toDate = new Date(parts[1].trim().split(" ")[0]);

        if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
            return null;
        }

        return {
            fromDate: formatDateValue(fromDate),
            toDate: formatDateValue(toDate)
        };
    }

    function resolveReportDates() {
        var periodType = $("#ddlReportPeriodType").val() || "Monthly";
        var year = parseInt($("#ddlYear").val(), 10);
        var month = parseInt($("#ddlMonth").val(), 10);
        var fromDate = "";
        var toDate = "";

        if (periodType === "Monthly") {
            if (!year || !month) {
                toastr["warning"]("Select Year and Month.");
                return null;
            }
            fromDate = formatDateValue(new Date(year, month - 1, 1));
            toDate = formatDateValue(new Date(year, month, 0));
        } else if (periodType === "Weekly") {
            if (!year || !$("#ddlWeek").val()) {
                toastr["warning"]("Select Year and Week Range.");
                return null;
            }
            var weekDates = parseWeekRange($("#ddlWeek").val());
            if (!weekDates) {
                toastr["warning"]("Invalid week range selected.");
                return null;
            }
            fromDate = weekDates.fromDate;
            toDate = weekDates.toDate;
        } else if (periodType === "Daily") {
            fromDate = $("#txtFromDate").val();
            toDate = $("#txtToDate").val();
            if (!fromDate || !toDate) {
                toastr["warning"]("Select From Date and To Date.");
                return null;
            }
        }

        $("#txtFromDate").val(fromDate);
        $("#txtToDate").val(toDate);
        return {
            fromDate: fromDate,
            toDate: toDate,
            reportPeriodType: periodType
        };
    }

    function validateSearchFilters() {
        if (!$("#UtilityId").val()) {
            toastr["warning"]("Select Utility.");
            return false;
        }
        if (!$("#ddlProject").val()) {
            toastr["warning"]("Select Project.");
            return false;
        }
        return true;
    }

    function updateReportSummary(response) {
        var fromDate = response.FromDate || $("#txtFromDate").val() || "-";
        var toDate = response.ToDate || $("#txtToDate").val() || "-";
        var periodLabel = "(" + (response.ReportPeriodType || $("#ddlReportPeriodType").val() || "Monthly") + ")";

        $("#lblFromDate").text(fromDate);
        $("#lblToDate").text(toDate);
        $("#lblSplitFromDate").text(fromDate);
        $("#lblSplitToDate").text(toDate);
        $("#lblReportPeriodType").text(periodLabel);
        $("#lblSplitReportPeriodType").text(periodLabel);
    }

    function setDefaultDates() {
        $("#txtFromDate").val("");
        $("#txtToDate").val("");

        $("#lblFromDate").text("-");
        $("#lblToDate").text("-");

        $("#spanFromDate").text("From Date").css("color", "#999");
        $("#spanToDate").text("To Date").css("color", "#999");
        $(".period-daily-from, .period-daily-to").removeClass("has-date-value");

        try {
            $("#txtFromDate").datepicker("option", "maxDate", null);
            $("#txtToDate").datepicker("option", "minDate", null);
        } catch (e) { }
    }

    function loadProjectList(utilityId) {
        var url = $("#UrlGetProjectByUtility").val();

        resetBudgetSelectOptions($("#ddlProject"), "Select Project");
        $("#ddlProject").prop("disabled", true);
        refreshBudgetSelects("#ddlProject");

        $.ajax({
            url: url,
            type: "GET",
            data: {
                UtilityId: utilityId
            },
            dataType: "json",
            success: function (response) {
                console.log("Project response:", response);

                $("#ddlProject").find("option:not([value=''])").remove();

                if (typeof response === "string" || !$.isArray(response)) {
                    if (response && response.success === false) {
                        toastr["error"](response.returnMessage || "Unable to load project list.", "Error");
                    } else {
                        toastr["error"]("Unable to load project list. You may not have access permission — please re-login or contact admin.", "Error");
                    }
                    $("#ddlProject").prop("disabled", true);
                    appendBudgetSelectPlaceholder($("#ddlProject"), "Select Project");
                    refreshBudgetSelects("#ddlProject");
                    return;
                }

                if (response.length > 0) {
                    $.each(response, function (index, item) {
                        $("#ddlProject").append(
                            $("<option></option>")
                                .val(item.ProjectId || item.ProjectID || item.projectId)
                                .text(item.ProjectName || item.ProjectCityState || item.ProjectCityName)
                        );
                    });

                    $("#ddlProject").prop("disabled", false);
                } else {
                    $("#ddlProject").prop("disabled", true);
                    toastr["warning"]("No project found for selected utility.", "Notification");
                }

                appendBudgetSelectPlaceholder($("#ddlProject"), "Select Project");
                refreshBudgetSelects("#ddlProject");
            },
            error: function (xhr) {
                console.log("Project AJAX error:", xhr.status, xhr.responseText);
                resetProjectDropdown();
                if (xhr && xhr.responseText && xhr.responseText.indexOf("Unauthorised") >= 0) {
                    toastr["error"]("You do not have access permission for Budget Status Report project list. Please contact admin.", "Error");
                } else {
                    toastr["error"]("Unable to load project list.", "Error");
                }
            }
        });
    }

    function loadInstallerList(projectId) {
        var url = $("#UrlGetInstallerByProject").val();

        $("#ddlInstaller").empty();
        $("#ddlInstaller").append($("<option value=''></option>"));
        $("#ddlInstaller").prop("disabled", true);
        updateChosen("#ddlInstaller");

        if (!projectId || projectId === "0" || projectId === "") {
            return;
        }

        $.ajax({
            url: url,
            type: "GET",
            data: {
                projectId: projectId
            },
            success: function (response) {
                console.log("Installer response:", response);

                $("#ddlInstaller").empty();
                $("#ddlInstaller").append($("<option value=''></option>"));

                if (response && response.success === false) {
                    toastr["error"](response.returnMessage || "Unable to load installer list.", "Error");
                    $("#ddlInstaller").prop("disabled", true);
                    updateChosen("#ddlInstaller");
                    return;
                }

                if (response && response.length > 0) {
                    $.each(response, function (index, item) {
                        $("#ddlInstaller").append(
                            $("<option></option>")
                                .val(item.UserId || item.UserID || item.userId)
                                .text(item.UserName || item.FullName || item.Name || item.userName)
                        );
                    });

                    $("#ddlInstaller").prop("disabled", false);
                } else {
                    $("#ddlInstaller").prop("disabled", true);
                    toastr["warning"]("No installer found for selected project.", "Notification");
                }

                updateChosen("#ddlInstaller");
            },
            error: function (xhr) {
                console.log("Installer AJAX error:", xhr.status, xhr.responseText);
                resetInstallerDropdown();
                toastr["error"]("Unable to load installer list.", "Error");
            }
        });
    }

    function getBudgetStatusReport() {
        if (!validateSearchFilters()) {
            return;
        }

        var reportDates = resolveReportDates();
        if (!reportDates) {
            return;
        }

        var url = $("#UrlGetBudgetStatusReport").val();

        waitingDialog.show('Loading Please Wait...');

        $.ajax({
            url: url,
            type: "POST",
            data: {
                projectId: $("#ddlProject").val(),
                installerId: null,
                fromDate: reportDates.fromDate,
                toDate: reportDates.toDate,
                reportPeriodType: reportDates.reportPeriodType
            },
            success: function (response) {
                waitingDialog.hide();
                if (response.success === false) {
                    toastr["error"](response.returnMessage || "Unable to load report.", "Error");
                    bindBudgetStatusReportTable([]);
                    if ($.fn.DataTable.isDataTable("#tblServiceLineReport")) {
                        $("#tblServiceLineReport").DataTable().destroy();
                    }
                    $("#tblServiceLineReport tbody").empty();
                    $("#panelServiceLineReport").hide();
                    $("#rowTable1Summary").hide();
                    $("#rowTable2Summary").hide();
                    $("#rowNormalSummary").show();
                    resetBudgetSummary();
                    return;
                }

                var hasServiceLine =
                    (response.ServiceLineData && response.ServiceLineData.length > 0) ||
                    parseFloat(response.TotalConfiguredServiceLineBudget || 0) > 0;
                var approvedBudget = parseFloat(response.ApprovedProjectBudget || 0);
                var usedBudget = parseFloat(response.UsedBudget || 0);
                var balanceBudget = parseFloat(response.BalanceBudget || 0);
                var serviceLineBudget = parseFloat(response.ServiceLineBudget || 0);
                var serviceLineUsedBudget = parseFloat(response.ServiceLineUsedBudget || 0);
                var serviceLineBalanceBudget = parseFloat(response.ServiceLineBalanceBudget || 0);

                updateReportSummary(response);

                if (hasServiceLine) {
                    $("#rowNormalSummary").hide();
                    $("#panelServiceLineReport").show();
                    $("#rowTable1Summary").show();
                    $("#rowTable2Summary").show();

                    bindBudgetStatusReportTable(response.data || []);
                    bindServiceLineTable(response.ServiceLineData);

                    $("#lblSplitApprovedProjectBudget").text(formatCurrency(approvedBudget));
                    $("#lblSplitUsedBudget").text(formatCurrency(usedBudget));
                    $("#lblSplitBalanceBudget").text(formatCurrency(balanceBudget));
                    $("#lblServiceLineBudget").text(formatCurrency(serviceLineBudget));
                    $("#lblServiceLineUsedBudget").text(formatCurrency(serviceLineUsedBudget));
                    $("#lblServiceLineBalanceBudget").text(formatCurrency(serviceLineBalanceBudget));
                } else {
                    if ($.fn.DataTable.isDataTable("#tblServiceLineReport")) {
                        $("#tblServiceLineReport").DataTable().destroy();
                    }
                    $("#tblServiceLineReport tbody").empty();
                    $("#panelServiceLineReport").hide();
                    $("#rowTable1Summary").hide();
                    $("#rowTable2Summary").hide();
                    $("#rowNormalSummary").show();

                    bindBudgetStatusReportTable(response.data || []);

                    $("#lblApprovedProjectBudget").text(formatCurrency(approvedBudget));
                    $("#lblUsedBudget").text(formatCurrency(usedBudget));
                    $("#lblBalanceBudget").text(formatCurrency(balanceBudget));
                }
            },
            error: function () {
                waitingDialog.hide();
                toastr["error"]("Something went wrong while loading report.", "Error");
                bindBudgetStatusReportTable([]);
                if ($.fn.DataTable.isDataTable("#tblServiceLineReport")) {
                    $("#tblServiceLineReport").DataTable().destroy();
                }
                $("#tblServiceLineReport tbody").empty();
                $("#panelServiceLineReport").hide();
                $("#rowTable1Summary").hide();
                $("#rowTable2Summary").hide();
                $("#rowNormalSummary").show();
                resetBudgetSummary();
            }
        });
    }

    function bindBudgetStatusReportTable(data) {
        if ($.fn.DataTable.isDataTable("#tblBudgetStatusReport")) {
            $("#tblBudgetStatusReport").DataTable().destroy();
        }

        $("#tblBudgetStatusReport tbody").empty();

        var table = $("#tblBudgetStatusReport").DataTable({
            data: data,
            searching: false,
            paging: false,
            ordering: false,
            info: false,
            autoWidth: false,
            columns: [
                {
                    data: null,
                    className: "text-center",
                    width: "5%",
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                {
                    data: "ServiceDescription",
                    className: "text-left",
                    defaultContent: ""
                },
                {
                    data: "UnitCost",
                    className: "text-right",
                    width: "12%",
                    render: function (value) {
                        return formatCurrency(value);
                    }
                },
                {
                    data: "TotalCount",
                    className: "text-right",
                    width: "10%",
                    render: function (value) {
                        return formatCount(value);
                    }
                },
                {
                    data: "TotalCost",
                    className: "text-right",
                    width: "15%",
                    render: function (value) {
                        return formatCurrency(value);
                    }
                }
            ],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api();
                var footer = $(api.table().footer());

                if (!data || data.length === 0) {
                    footer.hide();
                    return;
                }

                footer.show();

                var totalUnitCost = data.reduce(function (sum, row) {
                    return sum + parseFloat(row.UnitCost || 0);
                }, 0);

                $(api.column(2).footer())
                    .html(formatCurrency(totalUnitCost))
                    .css("text-align", "right");

                var totalCount = data.reduce(function (sum, row) {
                    return sum + parseInt(row.TotalCount || 0, 10);
                }, 0);

                $(api.column(3).footer())
                    .html(formatCount(totalCount))
                    .css("text-align", "right");

                var totalCost = data.reduce(function (sum, row) {
                    return sum + parseFloat(row.TotalCost || 0);
                }, 0);

                $(api.column(4).footer())
                    .html(formatCurrency(totalCost))
                    .css("text-align", "right");
            }
        });

        var footer = $(table.table().footer());

        if (!data || data.length === 0) {
            footer.hide();
        } else {
            footer.show();
        }
    }

    function bindServiceLineTable(data) {
        if ($.fn.DataTable.isDataTable("#tblServiceLineReport")) {
            $("#tblServiceLineReport").DataTable().destroy();
        }

        $("#tblServiceLineReport tbody").empty();

        var table = $("#tblServiceLineReport").DataTable({
            data: data,
            searching: false,
            paging: false,
            ordering: false,
            info: false,
            autoWidth: false,
            columns: [
                {
                    data: null,
                    className: "text-center",
                    width: "5%",
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                {
                    data: "ServiceDescription",
                    className: "text-left",
                    defaultContent: ""
                },
                {
                    data: "UnitCost",
                    className: "text-right",
                    width: "12%",
                    render: function (value) {
                        return formatCurrency(value);
                    }
                },
                {
                    data: "TotalCount",
                    className: "text-right",
                    width: "10%",
                    render: function (value) {
                        return formatCount(value);
                    }
                },
                {
                    data: "TotalCost",
                    className: "text-right",
                    width: "15%",
                    render: function (value) {
                        return formatCurrency(value);
                    }
                }
            ]
        });
    }

    function exportBudgetStatusReport() {
        if (!validateSearchFilters()) {
            return;
        }

        var reportDates = resolveReportDates();
        if (!reportDates) {
            return;
        }

        var url = $("#UrlExportBudgetStatusReport").val();

        var queryString =
            "?projectId=" + encodeURIComponent($("#ddlProject").val() || "") +
            "&installerId=" +
            "&fromDate=" + encodeURIComponent(reportDates.fromDate) +
            "&toDate=" + encodeURIComponent(reportDates.toDate);

        window.location.href = url + queryString;
    }

    // Format utility helpers
    function formatMoney(value) {
        value = parseFloat(value || 0);
        return value.toFixed(2);
    }
    
    function updateChosen(selector) {
        refreshBudgetSelects(selector);
    }

    function resetProjectDropdown() {
        resetBudgetSelectOptions($("#ddlProject"), "Select Project");
        $("#ddlProject").prop("disabled", true);
        refreshBudgetSelects("#ddlProject");
    }

    function formatCurrency(value) {
        value = String(value || 0).replace(/\$/g, "").replace(/,/g, "");
        value = parseFloat(value || 0);

        return value.toLocaleString("en-US", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    // Count formatting helper
    function formatCount(value) {
        value = String(value || 0).replace(/,/g, "");
        value = parseInt(value || 0, 10);

        return value.toLocaleString("en-US", {
            maximumFractionDigits: 0
        });
    }

    function resetBudgetSummary() {
        $("#lblApprovedProjectBudget").text("0.00");
        $("#lblUsedBudget").text("0.00");
        $("#lblBalanceBudget").text("0.00");
        $("#lblSplitApprovedProjectBudget").text("0.00");
        $("#lblSplitUsedBudget").text("0.00");
        $("#lblSplitBalanceBudget").text("0.00");
        $("#lblServiceLineBudget").text("0.00");
        $("#lblServiceLineUsedBudget").text("0.00");
        $("#lblServiceLineBalanceBudget").text("0.00");
        $("#lblFromDate").text("-");
        $("#lblToDate").text("-");
        $("#lblSplitFromDate").text("-");
        $("#lblSplitToDate").text("-");
        $("#lblReportPeriodType").text("");
        $("#lblSplitReportPeriodType").text("");
    }
</script>