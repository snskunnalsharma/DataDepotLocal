<!-- page start-->
<section id="main-content">
    <section class="wrapper instal-dat-hist">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12" id="m">
                <section class="panel">
                    <header class="panel-heading">
                        <b>Skip History Report</b>
                    </header>
                    <div class="row" style="">
                        <div class="col-lg-12">
                            <div class="container-fluid con_fluid_new" style="padding:0px">
                                <div class="panel-body">
                                    <div class="row" style="margin-bottom: 5px;">
                                        <div class="form-group">
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 reasgn_bx1">
                                                <select id="ddlProjectStatus" data-placeholder="Select Project Status" class="form-control chosen-select ">
                                                    <option value="0"></option>
                                                    <option value="Active">Active</option>
                                                    <option value="Complete">Completed</option>
                                                </select>
                                            </div>

                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 reasgn_bx2">
                                                <select id="ddlProject" data-placeholder="Select Project" class="form-control chosen-select "></select>
                                            </div>

                                            <div class="col-lg-3 col-sm-6 col-xs-12 div-rep-date">
                                                <div class="form-group col-lg-6 col-sm-6 col-xs-5 rep_date">
                                                    <input type="text" name="FromDates" id="datepicker1" readonly="readonly" class="form-control rep_date_inp">
                                                </div>
                                                <div class="form-group col-lg-6 col-sm-6 col-xs-5 rep_date rep_todate ">
                                                    <input type="text" name="ToDates" id="datepicker2" readonly="readonly" class="rep_todate_inp form-control">
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 reasgn_bx1">
                                                <select id="ddlSkipReason" data-placeholder="Select Skip Reason" class="form-control chosen-select ">
                                                    <option value="0"></option>
                                                    <option value="3">All Skip</option>
                                                    <option value="1">Current Skip</option>
                                                    <option value="2">Past Skip</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" style="margin-bottom: 5px;">
                                        <div class="form-group">
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 reasgn_bx3">
                                                <select id="ddlInstaller" data-placeholder="Select Installer" class="form-control chosen-select"></select>
                                            </div>

                                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 reasgn-bx4" style="margin-top:10px;width:220px;margin-left:126px">
                                                <button id="btnSearch" class="btn btn-warning reasgn-srch-btn" type="button" style="background-color:green;border-color:green;">Search</button>
                                                <button id="btnReset" class="btn btn-warning reasgn-res-btn" type="button" style="background-color:red;border-color:grey;">Reset</button>
                                                <button id="btnExport" class="btn btn-warning reasgn-srch-btn" type="button" style="background-color:green;border-color:green;">Export</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-responsive col-lg-12 rep_dyn_table" style="padding:0px">
                                        <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                            <thead>
                                                <tr>
                                                    <th width="12%">Visited Date</th>
                                                    <th width="10%">Project Name</th>
                                                    <th width="8%">Installer Name</th>
                                                    <th width="10%">Account</th>
                                                    <th width="15%">Street</th>
                                                    <th width="7%">Cycle</th>
                                                    <th width="5%">Route</th>
                                                    <th width="13%">Skipped Reason</th>
                                                    <th width="15%">Skip Comment</th>
                                                    <th width="5%">Action</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>

<!-- Model for Skip Accopunt History Detail -->
@*<div class="modal fade modal-dialog-center" id="skipAccountHistoryDetailModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">*@
<div class="modal fade" id="skipAccountHistoryDetailModal" role="dialog" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md rep-mod vertical-scroll" style="width: 75%; height: 550px; overflow: scroll; overflow: auto;margin-top:180px">
        <div class="modal-content-wrap">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title"><strong>Skip Account History Detail</strong></h4>
                </div>
                <div class="modal-body">
                    <div class="panel-body">
                        <div class="table-responsive  rep_dyn_table" id="inventryReceiveDiv112">
                            <div class="iconic-input">
                                <div class="col-lg-12 col-md-6 col-xs-12  nopadding_header">
                                    <p style="float: right;">
                                        <i class="fa fa-search"></i>
