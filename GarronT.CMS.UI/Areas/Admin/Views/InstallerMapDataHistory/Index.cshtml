@{
    ViewBag.Title = "Skip History Report";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@Html.Hidden("urlGetInstallerMapList", Url.Action("GetInstMapHistoryList", "InstallerMapDataHistory"))
@Html.Hidden("urlGetProject", Url.Action("GetPoject", "InstallerMapDataHistory"))
@Html.Hidden("urlGetInstallerList", Url.Action("GetInstallerList", "InstallerMapDataHistory"))


@Html.Hidden("urlStoreSkippedID", Url.Action("StoreSkippedID", "InstallerMapDataHistory"))
@Html.Hidden("urlViewMultiSkippedRecords", Url.Action("ViewMultiSkippedRecords", "InstallerMapDataHistory"))
@Html.Hidden("urlGetSkipAccountDetail", Url.Action("GetSkipAccountDetail", "InstallerMapDataHistory"))
@Html.Hidden("urlExportSkipAccountHistory", Url.Action("ExportSkipAccountHistory", "InstallerMapDataHistory"))
@Html.Hidden("urlMessageStatus", Url.Action("MessageStatus", "InstallerMapDataHistory"))
<style>
    .instal-dat-hist {
        margin-top: 50px;
    }
    td.details-control {
        background: url('http://www.datatables.net/examples/resources/details_open.png') no-repeat center center;
        cursor: pointer;
    }

    tr.shown td.details-control {
        background: url('http://www.datatables.net/examples/resources/details_close.png') no-repeat center center;
    }
</style>
<style>
    .disabledli {
        pointer-events: none;
        opacity: 0.4;
    }

    .disable_a_href {
        pointer-events: none;
    }

    .chosen-results .ui-selected {
        background-color: #3875d7;
        background-image: -webkit-gradient(linear, 50% 0%, 50% 100%, color-stop(20%, #3875d7), color-stop(90%, #2a62bc));
        background-image: -webkit-linear-gradient(#3875d7 20%, #2a62bc 90%);
        background-image: -moz-linear-gradient(#3875d7 20%, #2a62bc 90%);
        background-image: -o-linear-gradient(#3875d7 20%, #2a62bc 90%);
        background-image: linear-gradient(#3875d7 20%, #2a62bc 90%);
        color: #fff;
    }

    .chosen-results .ui-selecting {
        background-color: #3875d7;
        background-image: -webkit-gradient(linear, 50% 0%, 50% 100%, color-stop(20%, #3875d7), color-stop(90%, #2a62bc));
        background-image: -webkit-linear-gradient(#3875d7 20%, #2a62bc 90%);
        background-image: -moz-linear-gradient(#3875d7 20%, #2a62bc 90%);
        background-image: -o-linear-gradient(#3875d7 20%, #2a62bc 90%);
        background-image: linear-gradient(#3875d7 20%, #2a62bc 90%);
        color: #fff;
    }

    .chosen-results {
        list-style-type: none;
        margin: 0;
        padding: 0;
        width: 100%;
    }

        .chosen-results li {
            margin-bottom: 1px;
            padding: 5px;
        }

    .addrFilter {
        padding: 5px;
        margin: 0px;
    }

    .ddlHeader {
        color: #444;
    }


    ul.source, ul.target, ul.colName {
        min-height: 500px;
        margin: 0px 25px 10px 0px;
        padding: 2px;
        border-width: 1px;
        border-style: solid;
        -webkit-border-radius: 3px;
        -moz-border-radius: 3px;
        border-radius: 3px;
        list-style-type: none;
        list-style-position: inside;
        /*width: 20em;*/
    }

    ul.source {
        border-color: #f8e0b1;
    }

    ul.target, ul.colName {
        border-color: #add38d;
    }

    .source li, .target li, .colName li {
        margin: 2px;
        padding: 8px 0px !important;
        -webkit-border-radius: 4px;
        -moz-border-radius: 4px;
        border-radius: 4px;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
        /*height: 2.5em;*/
    }

    .source li {
        background-color: #fcf8e3;
        border: 1px solid #fbeed5;
        color: #c09853;
    }

    .target li, .colName li {
        background-color: #ebf5e6;
        border: 1px solid #d6e9c6;
        color: #468847;
    }

    .sortable-dragging {
        border-color: #ccc !important;
        background-color: #fafafa !important;
        color: #bbb !important;
    }

    .sortable-placeholder {
        height: 40px;
    }

    .source .sortable-placeholder {
        border: 2px dashed #f8e0b1 !important;
        background-color: #fefcf5 !important;
    }

    .target .sortable-placeholder {
        border: 2px dashed #add38d !important;
        background-color: #f6fbf4 !important;
    }

    .toast-top-center {
        margin-top: -50px;
    }

    .sideBySide {
        margin-top: 14px;
    }

    .exp-src {
        text-align: center;
    }

    .exp-rep {
        text-align: center;
    }
</style>

