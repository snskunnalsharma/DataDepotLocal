    function openReturnToWarehouseModal(rowData) {
        if (!rowData) {
            toastr["error"]("Unable to read inventory row.", "Notification");
            return;
        }

        var projectId = $("#ProjectId").val();
        if (!projectId || projectId === "0") {
            toastr["error"]("Please select a project.", "Notification");
            return;
        }

        var inHand = parseInt(rowData.InHandQty || 0, 10);
        if (isNaN(inHand) || inHand <= 0) {
            toastr["error"]("No in-hand inventory available to return.", "Notification");
            return;
        }

        var serial = (rowData.SerialNumber || "").toString().trim();
        var isSerial = serial !== "";

        $("#returnUserId").val(rowData.UserId);
        $("#returnProductId").val(rowData.FKProductId);
        $("#returnSerialNumber").val(serial);
        $("#returnMaxQty").val(inHand);
        $("#returnInstallerName").text(rowData.UserName || "-");
        $("#returnProductName").text(rowData.ProductName || "-");
        $("#returnSerialDisplay").text(serial || "-");
        $("#returnQty").val(isSerial ? 1 : inHand);
        $("#returnQty").attr("max", inHand);
        $("#returnQtyHelp").text("Max in-hand quantity: " + inHand);

        if (isSerial) {
            $("#returnSerialGroup").show();
            $("#returnQtyGroup").hide();
        } else {
            $("#returnSerialGroup").hide();
            $("#returnQtyGroup").show();
        }

        var $warehouse = $("#returnWarehouseId");
        $warehouse.empty().append($("<option></option>").val("").text("Select Warehouse"));

        waitingDialog.show("Loading warehouses...");
        $.ajax({
            type: "GET",
            url: $("#urlGetWarehouseByProject").val(),
            data: { projectId: projectId },
            success: function (warehouses) {
                waitingDialog.hide();
                if (warehouses && warehouses.length) {
                    $.each(warehouses, function (index, item) {
                        $warehouse.append($("<option></option>").val(item.WarehouseId).text(item.WarehouseName));
                    });
                }
                $("#returnToWarehouseModal").modal("show");
            },
            error: function () {
                waitingDialog.hide();
                toastr["error"]("Unable to load warehouses.", "Notification");
            }
        });
    }

    $("#btnConfirmReturnToWarehouse").click(function () {
        var projectId = $("#ProjectId").val();
        var warehouseId = $("#returnWarehouseId").val();
        var userId = $("#returnUserId").val();
        var productId = $("#returnProductId").val();
        var serialNumber = $("#returnSerialNumber").val();
        var maxQty = parseInt($("#returnMaxQty").val() || 0, 10);
        var qty = parseInt($("#returnQty").val() || 0, 10);
        var isSerial = (serialNumber || "").trim() !== "";

        if (!warehouseId) {
            toastr["error"]("Please select a warehouse.", "Notification");
            return;
        }

        if (isSerial) {
            qty = 1;
        } else if (isNaN(qty) || qty <= 0) {
            toastr["error"]("Please enter a valid quantity.", "Notification");
            return;
        } else if (qty > maxQty) {
            toastr["error"]("Quantity cannot be more than in-hand quantity (" + maxQty + ").", "Notification");
            return;
        }

        waitingDialog.show("Returning inventory...");
        $.ajax({
            type: "POST",
            url: $("#urlReturnToWarehouse").val(),
