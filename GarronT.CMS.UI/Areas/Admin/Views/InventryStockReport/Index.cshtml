        }
    }
    .match-green {
        background: #d4edda !important;
    }
    /* green */
    .notmatch-yellow {
        background: #fff3cd !important;
    }
    /* yellow */

    #returnToWarehouseModal .modal-dialog,
    #returnUnusedInventoryModal .modal-dialog {
        margin-top: 80px;
        max-width: 520px;
    }
    #returnToWarehouseModal .modal-content,
    #returnUnusedInventoryModal .modal-content {
        border: 0;
        border-radius: 8px;
        box-shadow: 0 8px 28px rgba(31, 78, 105, 0.22);
        overflow: hidden;
        font-family: 'Open Sans', sans-serif;
    }
    #returnToWarehouseModal .modal-header,
    #returnUnusedInventoryModal .modal-header {
        background: #80B2DF;
        color: #fff;
        border: 0;
        padding: 14px 18px;
    }
    #returnToWarehouseModal .modal-title,
    #returnUnusedInventoryModal .modal-title {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.2px;
    }
    #returnToWarehouseModal .modal-header .close,
    #returnUnusedInventoryModal .modal-header .close {
        color: #fff;
        opacity: 1;
        text-shadow: none;
        font-size: 24px;
        margin-top: 2px;
    }
    #returnToWarehouseModal .modal-body,
    #returnUnusedInventoryModal .modal-body {
        padding: 18px 20px 8px;
        background: #f7fbff;
    }
    #returnToWarehouseModal .return-note,
    #returnUnusedInventoryModal .return-note {
        background: #fff;
        border: 1px solid #d5e6f5;
        border-left: 4px solid #80B2DF;
        border-radius: 4px;
        padding: 8px 12px;
        color: #4e5050;
        font-size: 12px;
        margin-bottom: 14px;
    }
    #returnToWarehouseModal .return-info-card,
    #returnUnusedInventoryModal .return-info-card {
        background: #fff;
        border: 1px solid #d5e6f5;
        border-radius: 6px;
        padding: 10px 12px;
        margin-bottom: 14px;
    }
    #returnToWarehouseModal .return-info-row,
    #returnUnusedInventoryModal .return-info-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 0;
        border-bottom: 1px dashed #e4eef6;
        font-size: 13px;
    }
    #returnToWarehouseModal .return-info-row:last-child,
    #returnUnusedInventoryModal .return-info-row:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }
    #returnToWarehouseModal .return-info-row label,
    #returnUnusedInventoryModal .return-info-row label {
        margin: 0;
        color: #5f6368;
        font-weight: 600;
        min-width: 130px;
    }
    #returnToWarehouseModal .return-info-row span,
    #returnUnusedInventoryModal .return-info-row span {
        color: #2c3e50;
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }
    #returnToWarehouseModal .form-group label,
    #returnUnusedInventoryModal .form-group label {
        font-size: 12px;
        font-weight: 600;
        color: #5f6368;
        margin-bottom: 5px;
    }
    #returnToWarehouseModal .form-control,
    #returnUnusedInventoryModal .form-control {
        height: 36px;
        border: 1px solid #cfdce6;
        border-radius: 4px;
        box-shadow: none;
        font-size: 13px;
        background: #fff;
    }
    #returnToWarehouseModal .form-control:focus,
    #returnUnusedInventoryModal .form-control:focus {
        border-color: #80B2DF;
        box-shadow: 0 0 0 2px rgba(128, 178, 223, 0.25);
        background: #fff;
    }
    #returnToWarehouseModal #returnQtyHelp {
        display: block;
        margin-top: 5px;
        color: #E8693C;
        font-weight: 600;
        font-size: 12px;
    }
    #returnUnusedInventoryModal .modal-dialog {
        max-width: 760px;
        width: 92%;
    }
    #bulkUnusedUserList {
        max-height: 280px;
        overflow-y: auto;
        margin-top: 8px;
        font-size: 12px;
        color: #4e5050;
    }
    .bulk-user-block {
        border: 1px solid #d5e6f5;
        border-radius: 6px;
        margin-bottom: 10px;
        overflow: hidden;
        background: #fff;
    }
    .bulk-user-title {
        background: #eaf4fb;
        color: #1f4e69;
        font-weight: 700;
        padding: 7px 10px;
    }
    .bulk-section-title {
        background: #f4f9fc;
        color: #5f6368;
        font-weight: 700;
        padding: 5px 10px;
        border-top: 1px solid #d5e6f5;
    }
    .bulk-item-table {
        width: 100%;
        margin: 0;
    }
    .bulk-item-table th,
    .bulk-item-table td {
        padding: 6px 8px;
        border-top: 1px solid #eef4f8;
        vertical-align: middle;
    }
    .bulk-item-table th {
        background: #fafcfe;
        color: #5f6368;
        font-weight: 600;
    }
    .bulk-qty-input {
        width: 78px;
        height: 28px;
        text-align: center;
        border: 1px solid #cfdce6;
        border-radius: 4px;
    }
    .bulk-remove-serial {
        display: inline-block;
        width: 22px;
        height: 22px;
        line-height: 20px;
        text-align: center;
        border-radius: 50%;
        background: #d9534f;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        padding: 0;
    }
    .bulk-remove-serial:hover {
        background: #c9302c;
        color: #fff;
        text-decoration: none;
    }
    #returnToWarehouseModal .modal-footer,
    #returnUnusedInventoryModal .modal-footer {
        background: #fff;
        border-top: 1px solid #d5e6f5;
        padding: 12px 18px 16px;
        text-align: right;
    }
    #returnToWarehouseModal .modal-footer .btn,
    #returnUnusedInventoryModal .modal-footer .btn {
        min-width: 110px;
        font-weight: 600;
        border-radius: 4px;
        padding: 6px 14px;
    }

    #dynamic-table .date-time-col,
    #dynamic-table-Summary .date-time-col {
        min-width: 110px;
        white-space: normal;
        line-height: 1.35;
        text-align: left;
        vertical-align: middle;
    }

    /* Mobile-only: make controls a bit more compact */
    @@media (max-width: 480px) {
        #main-content .panel-body .form-control,
        #main-content .panel-body select,
        #main-content .panel-body input[type="text"],
        #main-content .panel-body button.btn {
            font-size: 13px !important;
        }

        /* Datepicker input text size */
        #txtFromDate,
        #txtToDate {
            font-size: 13px !important;
        }

        /* Fix DataTables length/search overlap on small screens */
        #main-content .dataTables_wrapper .dataTables_length,
        #main-content .dataTables_wrapper .dataTables_filter {
            float: none !important;
            width: 100% !important;
            text-align: left !important;
            display: block !important;
            clear: both !important;
        }

        #main-content .dataTables_wrapper .dataTables_filter {
            margin-top: 6px !important;
        }

        #main-content .dataTables_wrapper .dataTables_filter input {
            width: 100% !important;
            box-sizing: border-box !important;
        }
    }

