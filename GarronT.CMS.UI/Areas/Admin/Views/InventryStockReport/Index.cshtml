            toggleCompletedInventoryUI();
        }, 0);
        var projectId = $("#ProjectId").val();

        // ---------- EXISTING CODE (DO NOT REMOVE) ----------
        $('#ProductId').empty().trigger('chosen:updated');
        $('#InstallerId').empty().trigger('chosen:updated');

        waitingDialog.show('Please Wait...');
        var urlGetInstallerByProjectId = $("#urlGetInstallerByProjectId").val();

        $.ajax({
            type: 'GET',
            data: { ProjectId: projectId },
            async: true,
            url: urlGetInstallerByProjectId,
            success: function (data) {

                waitingDialog.hide();

                if (data.statusMessage.Success) {

                    // Installer dropdown
                    $('#InstallerId').empty();
                    var count = data.installerList.length;

                    if (count > 0) {
                        var $ins0 = $('<option></option>').val('0').text(isMobileBrowser ? "Select Installer/Manager" : "All Installers/Managers");
                        if (isMobileBrowser) {
                            $ins0.prop({ hidden: true, selected: true });
                        }
                        $('#InstallerId').append($ins0);
                        $.each(data.installerList, function (index, item) {
                            $('#InstallerId').append(
                                $('<option></option>').val(item.UserId).html(item.UserName)
                            );
                        });
                    }
                    $('#InstallerId').trigger('chosen:updated');

                    // Product dropdown
                    $('#ProductId').empty();
                    if (data.ProductList != null) {
                        appendProjectProductSentinel($('#ProductId'), "Select Product");
                        $.each(data.ProductList, function (index, item) {
                            $('#ProductId').append(
                                $('<option></option>').val(item.Id).html(item.FieldValue)
                            );
                        });
                    }
                    $('#ProductId').trigger('chosen:updated');
                    toggleCompletedInventoryUI();

                } else {
                    toastr.error(data.Message, "Notification !");
                }
            },
            error: function (jqXHR, textStatus) {
                waitingDialog.hide();
                console.log("error " + textStatus);
                toastr.error("something seems wrong", "Notification");
            }
        });
        // ----------------------------------------------------
    });


    let completedInventoryList = [];
    let completedInventoryItems = [];   // [{ productName, serialNumber }]
   

    let lastCompareGreen = [];
    let lastCompareYellow = [];
    let lastCompareRed = [];

    $("#btnUploadCompletedInventory").click(function () {

        var file = $("#completedInventoryFile")[0].files[0];

        if (!file) {
            toastr.error("Please select Excel or CSV file");
            return;
        }

        var formData = new FormData();
        formData.append("file", file);
        formData.append("projectId", $("#ProjectId").val());

        waitingDialog.show("Uploading...");

        $.ajax({
            url: '/Admin/InventryStockReport/UploadCompletedInventory',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                waitingDialog.hide();

                if (res.success) {
                    toastr.success("File uploaded successfully");
                    LoadDatatable();
                } else {
                    toastr.error(res.message);
                }
            },
            error: function () {
                waitingDialog.hide();
                toastr.error("Upload failed");
            }
        });
    });

    $("#completedInventoryFile").on("change", function () {
        if (this.files.length > 0) {
            $("#btnSubmitCompletedInventory").show();
        } else {
            $("#btnSubmitCompletedInventory").hide();
        }
    });

    function normalizeSerial(v) {
        if (!v) return "";
        return v.toString().trim().replace(/\s+/g, "").toUpperCase();
    }

    function normalizeProduct(v) {
        if (!v) return "";
        return v.toString().trim().replace(/\s+/g, " ").toUpperCase();
    }

    function saveMissingInventory(projectId) {
        if (!lastCompareRed || lastCompareRed.length === 0) return;

        $.ajax({
            url: '/Admin/InventryStockReport/SaveMissingInventory',
            type: 'POST',
            data: {
                projectId: projectId,
                redJson: JSON.stringify(lastCompareRed)
            },
            success: function (res) {
                if (res && res.success) {
                    toastr.success("Missing inventory saved");
                } else {
                    toastr.error((res && res.message) ? res.message : "Failed to save missing inventory", "Notification !");
                }
            },
            error: function () {
                toastr.error("Server error while saving missing inventory", "Notification !");
            }
        });
    }

    function runCompletedInventoryCompare() {
        var projectId = $("#ProjectId").val();
        $.ajax({
            url: '/Admin/InventryStockReport/GetCompletedInventoryForCompare',
            type: 'POST',
            data: { projectId: projectId },
            success: function (res) {
                waitingDialog.hide();

                if (!res.success) {
                    toastr.error(res.message);
                    return;
                }

                completedInventoryItems = (res.inventoryList || []).map(function (x) {
                    return {
                        productName: x.productName || "",
                        serialNumber: normalizeSerial(x.serialNumber),
                        technicianName: x.technicianName || "",
                        installerEmail: x.installerEmail || ""
                    };
                }).filter(function (x) {
                    return x.serialNumber;
                });

                completedInventoryList = completedInventoryItems.map(function (x) {
                    return x.serialNumber;
                });

                completedSerialSet = new Set(completedInventoryList);

                applyCorrectComparison();
                saveMissingInventory(projectId);
                $("#btnInstallInventory").show();
                toastr.success("Compare completed successfully");
            },
            error: function () {
                waitingDialog.hide();
                toastr.error("Compare failed");
            }
        });
    }

    $("#btnSubmitCompletedInventory").click(function () {

        var projectId = $("#ProjectId").val();
        var pid = parseInt(projectId, 10);
        if (pid !== 10135 && pid !== 10136) {
            toastr.error("Allowed only for Projects 10135 and 10136");
            return;
        }

        // Color marking is applied on detail serial table; auto-switch if needed.
        if ($("#ReportType").val() !== "1") {
            $("#ReportType").val("1").trigger("chosen:updated");
            LoadDatatable();
            setTimeout(function () {
                waitingDialog.show("Comparing...");
                runCompletedInventoryCompare();
            }, 1200);
            return;
        }

        waitingDialog.show("Comparing...");
        runCompletedInventoryCompare();
    });

    function showCompareResultPopup() {
        $.confirm({
            title: '<b style="font-size:16px; color:#007bff;">Compare Result</b>',
            boxWidth: '325px',   // 🔥 chota popup
            useBootstrap: false,

            content:
                "<div style='font-size:14px; line-height:1.8; padding:10px;'>" +

                "<div style='margin-bottom:10px; padding:6px; background:#d4edda; border-radius:5px; box-shadow:0 2px 6px rgba(0,0,0,0.1);'>" +
                "<strong style='color:#155724;'>Matched (Green):</strong> " +
                "<strong style='color:#155724;'>" + lastCompareGreen.length + "</strong>" +
                "</div>" +

                "<div style='margin-bottom:10px; padding:6px; background:#fff3cd; border-radius:5px; box-shadow:0 2px 6px rgba(0,0,0,0.1);'>" +
                "<strong style='color:#856404;'>Inventory Unused (Yellow):</strong> " +
                "<strong style='color:#856404;'>" + lastCompareYellow.length + "</strong>" +
                "</div>" +

                "<div style='margin-bottom:10px; padding:6px; background:#cfe2ff; border-radius:5px; box-shadow:0 2px 6px rgba(0,0,0,0.1);'>" +
                "<strong style='color:#084298;'>Installed Not In Inventory (Blue):</strong> " +
                "<strong style='color:#084298;'>" + lastCompareRed.length + "</strong>" +
                "</div>" +

                "</div>",

            buttons: {
                close: {
                    text: "CLOSE",
                    btnClass: "btn-default"
                }
            },

            onOpen: function () {
                this.$buttons.find('button').css({
                    'font-size': '13px',
                    'padding': '5px 0',
                    'width': '100px',
                    'text-align': 'center'
                });
            }
        });
    }

    $('#dynamic-table').on('draw.dt', function () {
        if (completedSerialSet && completedSerialSet.size > 0) {
            highlightMatchedRows();
        }
    });

    function getAllSystemSerials() {
        var dt = $('#dynamic-table').DataTable();
        var systemSet = new Set();

        dt.rows({ search: 'applied' }).every(function () {
            var d = this.data();
            var s = normalizeSerial(d.SerialNumber);
            if (s) systemSet.add(s);
        });

        return systemSet;
    }
    function normalizeSerial(s) {
        if (!s) return "";

        s = s.toString().trim().replace(/\s+/g, "");

        if (/^\d+$/.test(s)) {
            s = s.padStart(8, '0'); // 🔥 SAME LOGIC
        }

        return s.toUpperCase();
    }
    function getProductNameBySerial(serial) {
        serial = normalizeSerial(serial);

        var found = completedInventoryItems.find(function (x) {
            return x.serialNumber === serial;
        });

        return found ? (found.productName || "") : "";
    }

    function getProductNameFromTable(serial) {
        serial = normalizeSerial(serial);

        var dt = $('#dynamic-table').DataTable();
        var product = "";
        var technician = "";

        dt.rows({ search: 'applied' }).every(function () {
            var d = this.data();
            if (normalizeSerial(d.SerialNumber) === serial) {
                product = d.ProductName || "";
                technician = d.UserName || "";
            }
        });

        return {
            productName: product,
            technicianName: technician
        };
    }

    function applyCorrectComparison() {

        var systemSerialSet = getAllSystemSerials();

        lastCompareGreen = [];
        lastCompareYellow = [];
        lastCompareRed = [];

        completedSerialSet.forEach(function (s) {
            if (systemSerialSet.has(s)) {
                lastCompareGreen.push(s);
            } else {
                var item = completedInventoryItems.find(function (x) {
                    return x.serialNumber === s;
                });

                lastCompareRed.push({
                    ProductName: item ? item.productName : "",
                    SerialNumber: s,
                    TechnicianName: item ? item.technicianName : "",
                    InstallerEmail: item ? item.installerEmail : ""
                });
            }
        });

        systemSerialSet.forEach(function (s) {
            if (!completedSerialSet.has(s)) {
                var systemRow = getProductNameFromTable(s);
                lastCompareYellow.push({
                    ProductName: systemRow.productName,
                    SerialNumber: s,
                    TechnicianName: systemRow.technicianName
                });
            }
        });

        $("#btnDownloadMatchedCsv").show();
        highlightRows();
        showCompareResultPopup();
    }

    function highlightMatchedRows() {

        var dt = $('#dynamic-table').DataTable();

        dt.rows({ page: 'current' }).every(function () {
            var rowData = this.data();
            var serial = normalizeSerial(rowData.SerialNumber);
            var $tr = $(this.node());

            $tr.removeClass('match-green notmatch-yellow');

            if (!completedSerialSet || completedSerialSet.size === 0) return;

            if (completedSerialSet.has(serial)) {
                $tr.addClass('match-green');
            } else {
                $tr.addClass('notmatch-yellow');
            }
        });
    }

    function highlightRows() {

        var dt = $('#dynamic-table').DataTable();

        dt.rows().every(function () {

            var d = this.data();
            var $row = $(this.node());

            $row.removeClass('match-green notmatch-yellow');
            $row.css("background-color", "");

            var serial = normalizeSerial(d.SerialNumber);

            if (serial) {
                if (completedSerialSet.has(serial)) {
                    $row.addClass('match-green');
                } else {
                    $row.addClass('notmatch-yellow');
                }
                return;
            }
        });
    }

        $("#btnDownloadMatchedCsv").off("click").on("click", function () {

        var greenItems = buildGreenItemsForExcel();
        var hasGreen = greenItems && greenItems.length > 0;
        var hasYellow = lastCompareYellow && lastCompareYellow.length > 0;
        var hasRed = lastCompareRed && lastCompareRed.length > 0;

        if (!hasGreen && !hasYellow && !hasRed) {
            toastr.error("No comparison data to download");
            return;
        }

        var form = $('<form method="POST" action="/Admin/InventryStockReport/DownloadComparisonExcel"></form>');
        form.append($('<input type="hidden" name="projectId">').val($("#ProjectId").val()));
        form.append($('<input type="hidden" name="greenJson">').val(JSON.stringify(greenItems)));
        form.append($('<input type="hidden" name="yellowJson">').val(JSON.stringify(lastCompareYellow || [])));
        form.append($('<input type="hidden" name="redJson">').val(JSON.stringify(lastCompareRed)));
        form.append($('<input type="hidden" name="sendEmail">').val("false"));
        $('body').append(form);
        form.submit();
        form.remove();
    });

    function resetReportState() {

        if ($.fn.DataTable.isDataTable('#dynamic-table')) {
            $('#dynamic-table').DataTable().destroy();
            $('#dynamic-table tbody').empty();
        }

        if ($.fn.DataTable.isDataTable('#dynamic-table-Summary')) {
            $('#dynamic-table-Summary').DataTable().destroy();
            $('#dynamic-table-Summary tbody').empty();
        }

        // Hide DataTables pagination/search/length controls while no data is loaded.
        $("#dynamic-table_wrapper").hide();
        $("#dynamic-table-Summary_wrapper").hide();

        $("#divDetail").hide();
        $("#divSummary").show();
        toggleCompletedInventoryUI();
        $("#completedInventoryFile").val('');

        $("#btnSubmitCompletedInventory").hide();
        $("#btnDownloadMatchedCsv").hide();
        $("#btnInstallInventory").hide();

        completedInventoryList = [];
        completedInventoryItems = [];
        completedSerialSet = new Set();
        lastCompareGreen = [];
        lastCompareYellow = [];
        lastCompareRed = [];
    }

    function InstallInventory() {

        if (!lastCompareGreen || lastCompareGreen.length === 0) {
            toastr.error("No matched inventory to install");
            return;
        }

        function applyLocalInstallToGrid(serials) {
            try {
                var dt = $('#dynamic-table').DataTable();
                if (!dt) return;

                var toInstall = new Set((serials || []).map(function (s) { return normalizeSerial(s); }));
                if (toInstall.size === 0) return;

                dt.rows().every(function () {
                    var d = this.data();
                    var s = normalizeSerial(d.SerialNumber);
                    if (!s) return;

                    if (toInstall.has(s)) {
                        // move in-hand -> installed in UI without removing row
                        d.InstalledQty = 1;
                        d.InHandQty = 0;
                        this.data(d);
                    }
                });

                dt.draw(false);
                highlightRows();
            } catch (e) {
                // fallback: if anything goes wrong, old behavior would reload
                console.log("applyLocalInstallToGrid failed", e);
            }
        }

        $.confirm({
            title: "Confirm",
            content: "Install matched inventory?",
            buttons: {
                yes: function () {
                    var installingSerials = completedInventoryItems
                        .filter(x => lastCompareGreen.includes(x.serialNumber))
                        .map(x => x.serialNumber);

                    $.ajax({
                        url: '/Admin/InventryStockReport/InstallMatchedInventory',
                        type: 'POST',
                        data: {
                            projectId: $("#ProjectId").val(),
                            serialList: JSON.stringify(
                                completedInventoryItems.filter(x => lastCompareGreen.includes(x.serialNumber))
                            )
                        },
                        success: function (res) {
                            if (res.success) {
                                var msg = "Inventory installed. Installed: " + (res.installed || 0)
                                    + ", Skipped: " + (res.skipped || 0)
                                    + ", Errors: " + (res.errors || 0);
                                toastr.success(msg);
                                if (res.errors && res.errorList && res.errorList.length) {
                                    console.log("Install errors:", res.errorList);
                                }
                                // Do NOT reload report after install; reload can hide rows if proc filters in-hand=0.
                                // Instead update the existing grid rows in-place.
                                applyLocalInstallToGrid(installingSerials);
                            } else {
                                toastr.error(res.message);
                            }
                        },
                        error: function (xhr) {
                            console.log(xhr.responseText);
                            toastr.error("Server error");
                        }
                    });
                },
                cancel: function () { }
            }
        });
    }

    function getProductNameFromTable(serial) {
        var dt = $('#dynamic-table').DataTable();
        var product = "";
        var technician = "";
        var normalized = normalizeSerial(serial);

        dt.rows().every(function () {
            var d = this.data();
            if (normalizeSerial(d.SerialNumber) === normalized) {
                product = d.ProductName || "";
                technician = d.UserName || "";
            }
        });

        return {
            productName: product,
            technicianName: technician
        };
    }

    function getTechnicianBySerial(serial) {
        serial = normalizeSerial(serial);

        var found = completedInventoryItems.find(function (x) {
            return x.serialNumber === serial;
        });

        return found ? (found.technicianName || "") : "";
    }

    /** Matched rows for comparison Excel: ProductName & TechnicianName from grid (DataTable), same shape as server CompletedInventorySerialItem */
    function buildGreenItemsForExcel() {
        var list = [];
        (lastCompareGreen || []).forEach(function (s) {
            var norm = normalizeSerial(s);
            var fromTable = getProductNameFromTable(norm);
            var item = completedInventoryItems.find(function (x) {
                return x.serialNumber === norm;
            });
            list.push({
                ProductName: (fromTable.productName || "").trim() || (item ? item.productName : ""),
                SerialNumber: norm || (s ? String(s) : ""),
                TechnicianName: (fromTable.technicianName || "").trim() || (item ? item.technicianName : ""),
                InstallerEmail: item ? item.installerEmail : ""
            });
        });
        return list;
    }
</script>