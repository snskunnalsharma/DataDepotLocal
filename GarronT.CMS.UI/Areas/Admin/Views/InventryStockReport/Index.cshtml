       // resetReportState();

        $("#ReportType").val("1").trigger("chosen:updated");
        $("#divDetail").show();
        $("#divSummary").hide();
        $('#dynamic-table').DataTable().clear().draw();
        $('#dynamic-table-Summary').DataTable().clear().draw();
        $("#dynamic-table_wrapper").show();
        $("#dynamic-table-Summary_wrapper").show();

