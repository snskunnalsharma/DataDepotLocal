    // Mobile native <select>: a normal first-row "Select …" prompt appears inside the opened list (bad UX).
    // HTML5: option[hidden] is kept for the closed-box label but should not appear in the dropdown list.
    // Do NOT use disabled on the sentinel: jQuery .val() often skips disabled selected options and breaks filters.
    function applyMobileNativePlaceholder($select, sentinelValue, label) {
        if (!isMobileBrowser || !$select || !$select.length) return;
        var v = String(sentinelValue);
        var $opt = $select.find("option").filter(function () { return String($(this).val()) === v; });
        if ($opt.length === 0) {
            $opt = $('<option></option>').val(v).text(label);
            $select.prepend($opt);
        } else {
            $opt.first().text(label);
            $opt.first().prependTo($select);
            $opt = $opt.first();
        }
        $select.find("option").prop("selected", false);
        $opt.prop({ hidden: true, selected: true });
    }

    function appendProjectProductSentinel($select, labelIfMobile) {
        var $o = $('<option></option>').val('0');
        if (isMobileBrowser) {
            $o.text(labelIfMobile).prop({ hidden: true, selected: true });
        } else {
            $o.html('');
        }
        $select.append($o);
    }

