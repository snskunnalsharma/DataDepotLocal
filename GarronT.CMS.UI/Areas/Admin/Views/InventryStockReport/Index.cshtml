                } else {
                    toastr["error"]((result && result.message) ? result.message : "Unable to return inventory.", "Notification");
                }
            },
            error: function () {
                waitingDialog.hide();
                toastr["error"]("Unable to return inventory to warehouse.", "Notification");
            }
        });
    });

