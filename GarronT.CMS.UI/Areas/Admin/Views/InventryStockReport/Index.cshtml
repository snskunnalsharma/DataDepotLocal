        if (!isMobileBrowser) {
            // Desktop (Chosen): keep the first "0" option text empty so Chosen shows placeholder_text_single
            // without duplicating "Select …" as a real list row.
            $("#InstallerId").empty().append($('<option></option>').val('0').html(''));

            $("#UtilityId").chosen({ placeholder_text_single: "Select Utility", no_results_text: "Oops, nothing found!" });
            $('#UtilityId').trigger('chosen:updated');

            $("#ProjectId").chosen({ placeholder_text_single: "Select Project", no_results_text: "Oops, nothing found!" });
            $('#ProjectId').trigger('chosen:updated');

            $("#InstallerId").chosen({ placeholder_text_single: "Select Installer/Manager", no_results_text: "Oops, nothing found!" });
            $('#InstallerId').val("0").attr("selected", "selected").trigger('chosen:updated');

