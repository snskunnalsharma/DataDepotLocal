    function getInventryDateAndTimeSortValue(full) {
        if (!full) return 0;
        var raw = full.CreatedOn;
        if (raw) {
            if (typeof raw === "string") {
                var m = /\/Date\((-?\d+)(?:[+-]\d+)?\)\//.exec(raw);
                if (m) return parseInt(m[1], 10);
                var d = new Date(raw);
                if (!isNaN(d.getTime())) return d.getTime();
            } else {
                var d2 = new Date(raw);
                if (!isNaN(d2.getTime())) return d2.getTime();
            }
        }
        if (full.DateAndTime) {
            var plain = String(full.DateAndTime).replace(/<br\s*\/?>/gi, " ").trim();
            var d3 = new Date(plain);
            if (!isNaN(d3.getTime())) return d3.getTime();
        }
        return 0;
    }

    function formatInventryDateAndTimeCell(data, full) {
        if (data) {
            if (data.indexOf('<br') >= 0) return data;
            var parts = data.split(' ');
            if (parts.length >= 2) {
                return parts[0] + '<br/>' + parts.slice(1).join(' ');
            }
            return data;
        }
        var raw = full && full.CreatedOn;
        if (!raw) return "";
        var d = null;
        if (typeof raw === "string") {
            var m = /\/Date\((-?\d+)(?:[+-]\d+)?\)\//.exec(raw);
            if (m) {
                d = new Date(parseInt(m[1], 10));
            } else {
                d = new Date(raw);
            }
        } else {
            d = new Date(raw);
        }
        if (!d || isNaN(d.getTime())) return "";
        var mm = ("0" + (d.getMonth() + 1)).slice(-2);
        var dd = ("0" + d.getDate()).slice(-2);
        var yyyy = d.getFullYear();
        var hh = ("0" + d.getHours()).slice(-2);
        var mi = ("0" + d.getMinutes()).slice(-2);
        var ss = ("0" + d.getSeconds()).slice(-2);
        return mm + "/" + dd + "/" + yyyy + "<br/>" + hh + ":" + mi + ":" + ss;
    }

