    function toggleCompletedInventoryUI() {
        // Use numeric comparison to avoid string/format mismatches from dropdown values.
        var projectId = $("#ProjectId").val();
        var pid = parseInt(projectId, 10);
        var isInventoryCompareProject = (pid === 10135 || pid === 10136);

        if (isInventoryCompareProject) {
            $("#divCompleteUpload").show();
        } else {
            $("#divCompleteUpload").hide();
            $("#completedInventoryFile").val('');
            $("#btnSubmitCompletedInventory").hide();
            $("#btnDownloadMatchedCsv").hide();
            $("#btnInstallInventory").hide();
        }
    }

