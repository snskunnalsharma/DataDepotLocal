<link href="~/Scripts/js/jquery-ui.css" rel="stylesheet" />
<script src="~/Scripts/js/jquery-ui.js"></script>

<script type="text/javascript">
    var completedSerialSet = new Set();      // uploaded file serials
    var lastCompareMatched = [];            // matched serials
    var lastCompareUnmatched = [];          // unmatched serials (optional)
    var isMobileBrowser = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

    // Mobile native <select>: a normal first-row "Select …" prompt appears inside the opened list (bad UX).
    // HTML5: option[hidden] is kept for the closed-box label but should not appear in the dropdown list.
    // Do NOT use disabled on the sentinel: jQuery .val() often skips disabled selected options and breaks filters.
    function applyMobileNativePlaceholder($select, sentinelValue, label) {
        if (!isMobileBrowser || !$select || !$select.length) return;
        var v = String(sentinelValue);
        var $opt = $select.find("option").filter(function () { return String($(this).val()) === v; });
        if ($opt.length === 0) {
            $opt = $('<option></option>').val(v).text(label);
            $select.prepend($opt);
        } else {
            $opt.first().text(label);
            $opt.first().prependTo($select);
            $opt = $opt.first();
        }
        $select.find("option").prop("selected", false);
        $opt.prop({ hidden: true, selected: true });
    }

    function appendProjectProductSentinel($select, labelIfMobile) {
        var $o = $('<option></option>').val('0');
        if (isMobileBrowser) {
            $o.text(labelIfMobile).prop({ hidden: true, selected: true });
        } else {
            $o.html('');
        }
        $select.append($o);
    }

    $(document).ready(function () {


        $("#InventoryReports").addClass('active');
        $("#subReports").addClass('block');

        $('.sub').find("*").removeClass('active');
        $('#liInventoryStockReport').addClass("active");

        if (!isMobileBrowser) {
            // Desktop (Chosen): keep the first "0" option text empty so Chosen shows placeholder_text_single
            // without duplicating "Select …" as a real list row.
            $("#InstallerId").empty().append($('<option></option>').val('0').html(''));

            $("#UtilityId").chosen({ placeholder_text_single: "Select Utility", no_results_text: "Oops, nothing found!" });
            $('#UtilityId').trigger('chosen:updated');

            $("#ProjectId").chosen({ placeholder_text_single: "Select Project", no_results_text: "Oops, nothing found!" });
            $('#ProjectId').trigger('chosen:updated');

            $("#InstallerId").chosen({ placeholder_text_single: "Select Installer/Manager", no_results_text: "Oops, nothing found!" });
            $('#InstallerId').val("0").attr("selected", "selected").trigger('chosen:updated');

            $("#ProductId").chosen({ placeholder_text_single: "Select Product", no_results_text: "Oops, nothing found!" });
            $('#ProductId').trigger('chosen:updated');

            $("#ReportType").chosen();
            $('#ReportType').val("0").attr("selected", "selected").trigger('chosen:updated');
        } else {
            // Mobile: remove any server-provided blank options so native selects don't show "empty rows"
            $("#UtilityId option").filter(function () {
                return $.trim($(this).text()) === "";
            }).remove();

            // Mobile (native): show visible prompt text on the sentinel "0" rows (without affecting desktop Chosen).
            applyMobileNativePlaceholder($("#UtilityId"), "0", "Select Utility");
            applyMobileNativePlaceholder($("#ProjectId"), "0", "Select Project");
            applyMobileNativePlaceholder($("#ProductId"), "0", "Select Product");

            $("#InstallerId").empty().append(
                $('<option></option>').val('0').text('Select Installer/Manager').prop({ hidden: true, selected: true })
            );
        }

        $('#dynamic-table').DataTable({ "language": { "emptyTable": "No Data To Show" }, "sDom": '<"col-lg-12 drp-rec"lf><"col-lg-12 rep-shw-ent"ip>rt<ip><"clear">', });
        $('#dynamic-table-Summary').DataTable({ "language": { "emptyTable": "No Data To Show" }, "sDom": '<"col-lg-12 drp-rec"lf><"col-lg-12 rep-shw-ent"ip>rt<ip><"clear">', });
        $("#divDetail").hide();
        $("#divSummary").show();

        var todayDate = new Date();



        $("#txtFromDate").datepicker({
            changeMonth: true,
            changeYear: true,
            //minDate: prjFromDate,
            //maxDate: prjToDate,
            onSelect: function () {
                var date = $("#txtFromDate").val();
                if ($.trim(date) != "") {
                    var newDate1 = new Date(date);
                    $("#txtToDate").datepicker('option', 'minDate', newDate1);
                }

            },
            dateFormat: 'M-dd-yy',
        }).datepicker("setDate", todayDate);


        $("#txtToDate").datepicker({
            changeMonth: true,
            changeYear: true,
            //minDate: prjFromDate,
            //maxDate: prjToDate,
            onSelect: function () {
                var date = $("#txtToDate").val();
                if ($.trim(date) != "") {
                    var newDate1 = new Date(date);
