            }
        });
        // ----------------------------------------------------
    });


    let completedInventoryList = [];
    let completedInventoryItems = [];   // [{ productName, serialNumber }]
   

    let lastCompareGreen = [];
    let lastCompareYellow = [];
    let lastCompareRed = [];

    $("#btnUploadCompletedInventory").click(function () {

        var file = $("#completedInventoryFile")[0].files[0];

        if (!file) {
            toastr.error("Please select Excel or CSV file");
            return;
        }

        var formData = new FormData();
        formData.append("file", file);
        formData.append("projectId", $("#ProjectId").val());

        waitingDialog.show("Uploading...");

        $.ajax({
            url: '/Admin/InventryStockReport/UploadCompletedInventory',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                waitingDialog.hide();

                if (res.success) {
                    toastr.success("File uploaded successfully");
                    LoadDatatable();
                } else {
                    toastr.error(res.message);
                }
            },
            error: function () {
                waitingDialog.hide();
                toastr.error("Upload failed");
            }
        });
