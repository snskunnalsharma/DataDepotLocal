    function collectBulkReturnItems() {
        var items = [];
        var invalid = "";
        $("#bulkUnusedUserList .bulk-return-item").each(function () {
            var $row = $(this);
            var type = $row.attr("data-type");
            var userId = parseInt($row.attr("data-userid") || "0", 10);
            var productId = parseInt($row.attr("data-productid") || "0", 10);
            var productName = $row.attr("data-productname") || "";
            var serial = ($row.attr("data-serial") || "").trim();
            var maxQty = parseInt($row.attr("data-maxqty") || "0", 10);
            var qty = type === "serial" ? 1 : parseInt($row.find(".bulk-qty-input").val() || "0", 10);

            if (type === "consumable") {
                if (isNaN(qty) || qty < 0) {
                    invalid = "Please enter a valid consumable quantity.";
                    return false;
                }
                if (qty > maxQty) {
                    invalid = "Consumable quantity cannot be more than in-hand quantity.";
                    return false;
                }
                if (qty === 0) {
                    return;
                }
            }

            items.push({
                UserId: userId,
                ProductId: productId,
                ProductName: productName,
                SerialNumber: serial,
                Qty: qty
            });
        });
        return { items: items, invalid: invalid };
    }

