    function escapeHtml(value) {
        return $("<div/>").text(value == null ? "" : String(value)).html();
    }

    function buildUnusedInventoryHtml(users) {
        var html = "";
        (users || []).forEach(function (u) {
            html += '<div class="bulk-user-block">';
            html += '<div class="bulk-user-title">' + escapeHtml(u.UserName || "User") + ' <span style="font-weight:600;color:#5f6368;">(' + (u.ItemCount || 0) + ' items, qty ' + (u.Qty || 0) + ')</span></div>';

            html += '<div class="bulk-section-title">Serial Wise</div>';
            if (u.SerialItems && u.SerialItems.length) {
                html += '<table class="bulk-item-table bulk-serial-table"><thead><tr><th>Product</th><th>Serial Number</th><th style="width:60px;">Qty</th><th style="width:50px;"></th></tr></thead><tbody>';
                u.SerialItems.forEach(function (item) {
                    html += '<tr class="bulk-return-item" data-type="serial" data-userid="' + item.UserId + '" data-productid="' + item.ProductId + '" data-productname="' + escapeHtml(item.ProductName || "") + '" data-serial="' + escapeHtml(item.SerialNumber || "") + '" data-maxqty="1">';
                    html += '<td>' + escapeHtml(item.ProductName || "") + '</td>';
                    html += '<td>' + escapeHtml(item.SerialNumber || "") + '</td>';
                    html += '<td>1</td>';
                    html += '<td><button type="button" class="bulk-remove-serial" title="Do not return this serial">&times;</button></td></tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<div style="padding:6px 10px;color:#888;">No serial inventory</div>';
            }

            html += '<div class="bulk-section-title">Consumable</div>';
            if (u.ConsumableItems && u.ConsumableItems.length) {
                html += '<table class="bulk-item-table"><thead><tr><th>Product</th><th style="width:120px;">Return Qty</th><th style="width:90px;">In Hand</th></tr></thead><tbody>';
                u.ConsumableItems.forEach(function (item) {
                    html += '<tr class="bulk-return-item" data-type="consumable" data-userid="' + item.UserId + '" data-productid="' + item.ProductId + '" data-productname="' + escapeHtml(item.ProductName || "") + '" data-serial="" data-maxqty="' + (item.MaxQty || 0) + '">';
                    html += '<td>' + escapeHtml(item.ProductName || "") + '</td>';
                    html += '<td><input type="number" class="bulk-qty-input" min="0" max="' + (item.MaxQty || 0) + '" value="' + (item.Qty || 0) + '" /></td>';
                    html += '<td>' + (item.MaxQty || 0) + '</td></tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<div style="padding:6px 10px;color:#888;">No consumable inventory</div>';
            }

            html += '</div>';
        });
        return html;
    }

    $("#bulkUnusedUserList").on("click", ".bulk-remove-serial", function () {
        var $row = $(this).closest("tr");
        var $table = $row.closest("table");
