<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel">
                    <header class="panel-heading"> <b>Customer Management</b> </header>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-xs-4 add_newbtn"> <a class="btn btn-success" id="btnAddCLient" data-toggle="modal" data-backdrop="static"> Add New <i class="fa fa-plus"></i> </a> </div>

                            @*<div class="col-lg-8 col-md-8 col-xs-8 show_deactive deactivated_records cli_deactv_rec">*@

                            <div class="col-lg-8 col-md-8 col-xs-8 show_deactive deactivated_records ">
                                <input type="checkbox" name="showDeactivate" id="chkShowDeactivate" />
                                Show Deactivated Records
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                <thead>
                                    <tr>
                                        <th width="35%">Customer Name</th>
                                        <th width="20%">City</th>
                                        <th width="15%">Phone Number</th>
                                        <th width="20%">Mobile Number</th>
                                        <th width="10%">Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>

<!-- Modal for Add /Edit Dialog -->
<div class="modal fade modal-dialog-center" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog ">
        <div class="modal-content-wrap">
            <div class="modal-content modal-lg clnt-mdlg">
                <div class="modal-header">
                    <button type="button" class="close" id="btnClose" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Add New Customer</h4>
                </div>
                <div class="modal-body client-mod-bdy">
                    <form id="form3" class="cmxform form-horizontal tasi-form">
                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label cus-nm" style="white-space:nowrap;">Customer Name <span style="color:red">*</span></label>
                            <div class="col-lg-10 col-xs-12 col-sm-10 clnt-err">
                                <input type="hidden" name="ClientId" id="txtClientId" />
                                <input type="text" name="ClientName" id="txtClientName" class="inputclass form-control  cust-inp" />
                            </div>
                        </div>
                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label ">Address 1 <span style="color:red">*</span></label>
                            <div class="col-lg-4  col-xs-12 col-sm-4 addrs-fld">
                                <input type="text" name="Address1" id="txtAddress1" class="inputclass form-control " maxlength="200" />
                            </div>

                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label addr-cus2">Address 2</label>
                            <div class="col-lg-4 col-xs-12 col-sm-4 addrs-fld">
                                <input type="text" id="txtAddress2" name="Address2" class="inputclass form-control " maxlength="200" />
                            </div>

                        </div>
                        <div class="form-group">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label ">Address 3 </label>

                            <div class="col-lg-4 col-xs-12 col-sm-4 addrs-fld ">
                                <input type="text" id="txtAddress3" name="Address3" class="inputclass form-control " maxlength="200" />
                            </div>

                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label drp-lab">State</label>
                            <div class="col-lg-4 col-xs-12 col-sm-4  drp-fld ">
                                <input type="hidden" name="State" id="txtStateID" />
                                <select id="ddlState" data-placeholder="Select State" name="StateID" class="form-control chosen-select "></select>
                            </div>

                        </div>
                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label ">City </label>


                            <div class="col-lg-4 col-xs-12 col-sm-4 drp-fld ">
                                <input type="hidden" name="City" id="txtCityID" />
                                <select id="ddlCity" data-placeholder="Select City" name="CityId" class="form-control chosen-select"></select>
                            </div>


                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label pncde-lab">Pin Code </label>
                            <div class="col-lg-4 col-xs-12 col-sm-4 addrs-fld">
                                <input type="text" id="txtPinCode" name="Pincode" maxlength="6" class="inputclass form-control numericOnly client_pin_inp" />
                            </div>

                        </div>
                        <div class="form-group">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label ">Mobile No.</label>

                            <div class="col-lg-4 col-xs-12 col-sm-4 mob-err addrs-fld">
                                <input type="text" id="txtMobile" name="MobileNumber" maxlength="15" class="inputclass form-control numericOnly client_mobi_inp" />
                            </div>


                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label pncde-lab">Phone No.</label>
                            <div class="col-lg-4 col-xs-12 col-sm-4 phn-err addrs-fld">

                                <input id="txtPhone" name="PhoneNumber" value="" type="text" class="inputclass form-control numericOnly client_phn_inp" onkeyup="javascript:return mask(this.value,this,'1,5,9','-');" onblur="javascript:return mask(this.value,this,'1,5,9','-');" maxlength="14">
                            </div>

                        </div>
                        <div class="form-group ">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label">Email Id.</label>

                            <div class="col-lg-4 col-xs-12 col-sm-4 addrs-fld">
                                <input type="text" name="ClientEmailId" id="txtClientEmailId1" class="inputclass form-control client_emailid_inp" />
                            </div>
                            <div class="col-lg-6 col-xs-0 col-sm-0 ">
                            </div>
                        </div>
                    </form>
                    <form id="form4" class="cmxform form-horizontal tasi-form">
                        <div class="form-group">
                            <div class="col-lg-12  col-xs-8 col-sm-12 ">
                                <h5>Contact Person Details:</h5>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="name" class="col-lg-2 col-sm-2 col-xs-12 control-label">FirstName</label>

                            <div class="col-lg-4 col-xs-12 col-sm-4 addrs-fld">
