<style type="text/css">
    .stepwizard-step p {
        margin-top: 10px;
    }

    .stepwizard-row {
        display: table-row;
    }

    .stepwizard {
        display: table;
        width: 100%;
        position: relative;
        background: #c0d7e5;
    }

    .stepwizard-step button[disabled] {
        opacity: 1 !important;
        filter: alpha(opacity=100) !important;
    }

    .stepwizard-row:before {
        top: 32px;
        bottom: 0;
        position: absolute;
        content: " ";
        width: 100%;
        height: 1px;
        background-color: #ccc;
        z-index: 0;
    }

    .stepwizard-step {
        display: table-cell;
        text-align: center;
        position: relative;
        width: 20%;
    }

    .btn-circle {
        width: 30px;
        height: 30px;
        text-align: center;
        padding: 6px 0;
        font-size: 12px;
        line-height: 1.428571429;
        border-radius: 15px;
    }

    .multiselect {
        width: 180px;
        padding: 3px;
    }
</style>
<div>
    <div class="form-group col-lg-6">
        <label for="name" class="col-lg-3">Project Name<span style="color:red">*</span></label>

        <select name="ddlProjectdropdown" id="ddlProject" class="col-lg-9"></select>

    </div>

    <div class="form-group col-lg-6">
        <label for="name" class="col-lg-3">Form Name<span style="color:red">*</span></label>

        <div class="col-lg-9">
            <input type="text" name="NewFormName" id="txtNewFormName" class=" form-control" />
        </div>



    </div>
    <div class="form-group col-lg-7">

        <label for="name" class="col-lg-2 labelwidth ">From Date<span style="color:red">*</span></label>

        <div class="col-lg-3" style="    padding-left:0px;">
            <input type="text" name="FromDate" id="txtFromDate" class=" form-control" />
        </div>

        <label for="name" class="col-lg-2">To Date<span style="color:red">*</span></label>

        <div class="col-lg-3">
            <input type="text" name="ToDate" id="txtToDate" class="inputclass form-control" />
        </div>
    </div>

    <div class="form-group col-lg-5">
        <br /><br />
    </div>

    <div class="form-group" style="margin-top:10px;">
        <header class="panel-heading">
            <b>
                Design form for mobile application.
            </b>
        </header>



        <div class="col-lg-2" style="min-height: 150px; border: 1px solid #ccc; padding-left: 0px; padding-right: 0px;
                                                        margin-left: 6px; padding-left: 0px; margin-top: 7px; margin-bottom: 10px;">
            <div>
                <div class="row" style="margin-right: 0px; margin-left: 0px; height: 37px;">
                    <div id="divCustmizedContainer">
                        <div class="panel panel-default">

                            <div class="panel-heading">
                                <b class="panel-title" style="font-weight:700; padding-left:6px;">Section </b>
                                <div class="btn-group pull-right" style="top: -5px; margin-right: 5px;">
                                    <button type="submit" id="btnAddCustomized" title="Add New Section" class="btn btn-default btn-sm btn-flied">
                                        <i class="fa fa-plus-square" style="font-size: 14px;color: #47a447;"></i>
                                    </button>
                                    <button type="submit" id="btnDeleteCustomized" title="Delete Section" class="btn btn-default btn-sm btn-flied">
                                        <i class="fa fa-times" style="font-size: 14px;color: #d2322d;"></i>
                                    </button>
                                    <button type="submit" id="btnCopyCustomized" title="Copy Section" class="btn btn-default btn-sm btn-flied">
                                        <i class="fa fa-clipboard" style="font-size: 14px;"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="fieldChooser" class="col-lg-5" style="width:43%;">



            @*Source Fields  min-height: 380px; max-height: 380px;*@

            <div id="sourceFields" style="float: left; width: 48%; float: left; margin: 5px; overflow-y: scroll !important; min-height: 300px; border: 1px solid #ccc; ">
                <header class=" panel-heading" style="background-color: #6cbff7; color: #fff;">
                    <b>
                        Source Fields.
                    </b>
                </header>
            </div>

            @*Drag and drop the source fields in below box.*@


            <div id="destinationFields" style="float: right; width: 49%; float: left; margin: 5px 2px; min-height: 300px; overflow-y: scroll !important; border: 1px solid #ccc; ">
                <header class="panel-heading" style="background-color: #6cbff7; color:#fff;">
                    <b>
                        Field For Current Section.
                    </b>
                </header>
            </div>

        </div>

        <div class="col-lg-4" style="min-height: 300px; border: 1px solid #ccc; padding-left: 0px; padding-right: 0px; float: left;
         margin-left: 6px; padding-left: 0px; margin-top: 7px; margin-bottom: 10px;">
            <div>
                <div class="row" style="margin-right: 0px; margin-left: 0px;">

                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <b class="panel-title" style="font-weight:700; padding-left:6px;">Set Field</b>
                            <div class="btn-group " style="top: -5px; margin-right: 5px;" id="childPartialDiv">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="form-group">
    <div class="col-lg-12" style="text-align:right">
        <button id="btnSubmitForm" class="btn btn-success" type="button">Submit</button>
        <button id="btnBackForm" class="btn btn-success" type="button">Back</button>
    </div>
</div>


<div class="modal fade modal-dialog-center" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content-wrap">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Set Section Name</h4>
                </div>
                <div class="modal-body">
                    <div class="panel-body">
                        <form id="form3" class="cmxform form-horizontal tasi-form">
                            <div class="form-group">
                                <label for="name" class="col-lg-3">Section Name <span style="color:red">*</span></label>
                                <div class="col-lg-3">
                                    <input type="hidden" id="txtDivName" />
                                    <input type="text" name="sectionName" id="txtsectionName" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSaveSection" class="btn btn-success" type="button">Save</button>
                    <button id="btnCancelSection" class="btn btn-danger" type="button">Cancel</button>
                    <button id="btnResetSection" class="btn btn-default" type="button">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>



<link href="~/Scripts/js/style_management.css" rel="stylesheet" />
<link href="~/Scripts/js/jquery-ui.css" rel="stylesheet" />
<script src="~/Scripts/js/jquery-ui.js"></script>
<script src="~/Scripts/js/fieldChooser.js"></script>


