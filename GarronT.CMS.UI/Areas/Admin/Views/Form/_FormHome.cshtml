<div class="adv-table">
    <div class="row">
        <div class="col-lg-4 col-md-4 col-xs-4 add_newbtn">
            <a class="btn btn-success" id="btnAddForm" data-toggle="modal" data-backdrop="static">
                Add New <i class="fa fa-plus"></i>
            </a>
        </div>
        <div class="col-lg-8 col-md-8 col-xs-8 show_deactive deactivated_records">
            <input type="checkbox" name="showDeactivate" id="chkShowDeactivate" />Show Deactivated Records
        </div>
    </div>
    <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
        <thead>
            <tr>
                <th width="15%">City</th>
                <th width="20%">Client Name</th>
                <th width="15%">Project Name</th>
                <th width="15%">Form Name</th>
                <th width="12%">From Date</th>
                <th width="12%">To Date</th>
                <th width="23%">Action</th>
            </tr>
        </thead>


    </table>
</div>

<!-- Modal for Add /Edit Dialog -->
<!-- modal -->
<!-- Modal for deactivation -->
<div class="modal fade modal-dialog-center" id="confirmDeactivatedialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content-wrap">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Default Modal Title</h4>
                </div>
                <div class="modal-body">

                    <input type="hidden" id="deactivationID" />
                    <p>Are you sure to deactivate this record ?</p>

                </div>
                <div class="modal-footer">
                    <button id="btnDeactivateYes" class="btn btn-success" type="button">Yes</button>
                    <button class="btn btn-danger" id="btnDeactivatNo" type="button">No</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- modal -->
<!-- Modal for confirmActivatedialog -->
<div class="modal fade modal-dialog-center" id="confirmActivatedialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content-wrap">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Default Modal Title</h4>
                </div>
                <div class="modal-body">


                    <input type="hidden" id="activationID" />
                    <p>Are you sure to Activate this record ?</p>


                </div>
                <div class="modal-footer">
                    <button id="btnActivateYes" class="btn btn-success" type="button">Yes</button>
                    <button class="btn btn-danger" id="btnActivatNo" type="button">No</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
           
        
        var actualDate = new Date();
        var newDate = new Date(actualDate.getFullYear(), actualDate.getMonth() - 1, actualDate.getDate());
        $("#btnAddForm").click(function () {
            debugger;
            $("#divLandingPage").empty();

            var urlgetFormPartial = $('#getFormPartial').val();
            $.ajax({
                url: urlgetFormPartial,
                type: "GET",
                async: false,
                success: function (data) {
                    $("#divLandingPage").append(data);
                }
            });


            $('#txtFromDate').datepicker({
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                dateFormat: 'dd MM yy',
            }).datepicker("setDate", newDate);


            $('#txtToDate').datepicker({
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                dateFormat: 'dd MM yy',
            }).datepicker("setDate", actualDate);


            
            var urlStateData = $('#GetProjectList').val();
            $.ajax({
                type: 'POST',
                url: urlStateData,
                success: function (data) {

                    $('#ddlProject').empty();

                    $.each(data, function (index, item) {
                        if (index == 0) {
                            $('#ddlProject').append(
                              $('<option></option>').val('0').html("--Select Project--"));

                        }


                        $('#ddlProject').append(
                               $('<option></option>').val(item.ProjectId).html(item.ProjectName)
                         );
                    });
                         
                },
                error: function () {
                    alert("something seems wrong");
                }
            });

        })


    });




</script>