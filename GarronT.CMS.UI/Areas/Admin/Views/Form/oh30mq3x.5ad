                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">LONGITUDE</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">OLD METER NUMBER</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">OLD METER SIZE</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">OLD METER TYPE</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">OLD METER RADIO NUMBER</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">OLD METER LAST READING</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">NEW METER NUMBER</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">NEW METER REGISTER NUMBER</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">NEW METER RADIO</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">NEW METER SIZE</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">NEW METER TYPE</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">SERVICES</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">COMMENTS</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">Customer Pin</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">Customer GEO Location</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">Customer Name</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">Customer Address</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">Customer Pin</div>
                <div style="min-width: 200px !important; margin-bottom: 0px; float:none;">Customer GEO Location</div>


            </div>


        </div>
    </div>
</div>






<div class="form-group">
    <div class="col-lg-9" style="text-align:right">
        <button id="btnSubmitForm" class="btn btn-success" type="button">Submit</button>
        <button id="btnBackForm" class="btn btn-success" type="button">Back</button>
        @*<a class="btn btn-success" id="btnBack" data-toggle="modal" data-backdrop="static">Back</a>*@
    </div>
</div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnBackForm").click(function () {
            debugger;
            $("#divLandingPage").empty();

            var urlgetRowPartial12 = $('#getPreviousRecordsPartial').val();
            $.ajax({
                url: urlgetRowPartial12,
                type: "GET",
                async: false,
                success: function (data) {
                    $("#divLandingPage").append(data);
                }
            });


        })
        var $sourceFields = $("#sourceFields");
        var $destinationFields = $("#destinationFields");
        var $chooser = $("#fieldChooser").fieldChooser(sourceFields, destinationFields);
        var navListItems = $('div.setup-panel div a'),
                allWells = $('.setup-content'),
                allNextBtn = $('.nextBtn');

        allWells.hide();

        navListItems.click(function (e) {
            e.preventDefault();
            var $target = $($(this).attr('href')),
                    $item = $(this);

            if (!$item.hasClass('disabled')) {
                navListItems.removeClass('btn-primary').addClass('btn-default');
                $item.addClass('btn-primary');
                allWells.hide();
                $target.show();
                $target.find('input:eq(0)').focus();
            }
        });

        allNextBtn.click(function () {
            var curStep = $(this).closest(".setup-content"),
                curStepBtn = curStep.attr("id"),
                nextStepWizard = $('div.setup-panel div a[href="#' + curStepBtn + '"]').parent().next().children("a"),
                curInputs = curStep.find("input[type='text'],input[type='url'],textarea[textarea]"),
                isValid = true;

            $(".form-group").removeClass("has-error");
            for (var i = 0; i < curInputs.length; i++) {
                if (!curInputs[i].validity.valid) {
                    isValid = false;
                    $(curInputs[i]).closest(".form-group").addClass("has-error");
                }
            }

            if (isValid)
                nextStepWizard.removeAttr('disabled').trigger('click');
        });

        $('div.setup-panel div a.btn-primary').trigger('click');
    });
</script>

<link href="~/Scripts/js/style_management.css" rel="stylesheet" />
