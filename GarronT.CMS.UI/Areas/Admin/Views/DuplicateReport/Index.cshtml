@{
    ViewBag.Title = "Duplicate Report";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}



@Html.Hidden("urlGetProject", Url.Action("GetPoject", "DuplicateReport"))
@Html.Hidden("urlGetInstallerList", Url.Action("GetCurrentInstallerList", "DuplicateReport"))
@Html.Hidden("urlGetDuplicateRecords", Url.Action("GetDuplicateRecords", "DuplicateReport"))
@Html.Hidden("urlExportDuplicateRecords", Url.Action("ExportDuplicateRecordsExcel", "DuplicateReport"))
<style>
    @@media (min-width:375px) {
        .dataTables_length > label {
            white-space: normal;
            width: auto;
        }
    }

    .btn-lg{
        margin-right:0px;
    }
    .btn default:hover{
        border-color:none;
    }
    .btn.focus, .btn:focus, .btn:hover{
            border: 0px solid white;
    }
    .rep-shw-ent {
        margin-top: -18px;
        margin-bottom: -18px;
        padding: 0px
    }
    @@media only screen and (min-width:480px)and (max-width:530px) {
        .wrapper {
            margin-top:0%;
        }
    }
     @@media only screen and (max-width: 420px) and (min-width: 360px){

    .header {
        height: 8% !important;
    }
}
</style>
@*<div id="loading">
    <div id="loadingcontent">
        <p id="loadingspinner">
            Searching things...
        </p>
    </div>
</div>*@



<div id="loading"> <div id="loadingcontent"> <p id="loadingspinner"> Searching things... </p> </div> </div>



<section id="main-content">
    @*<section class="wrapper dup-rep-wrapper">*@
    <section class="wrapper ">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12" id="m">

                <section class="panel" style="">
                    @*<header class="panel-heading dup-panel-heading">*@
                    <header class="panel-heading">
                        <b> Duplicate Report<label id="lblProjectName"></label> </b>
                    </header>
                    @*<div class="row" style="">
                        <div class="col-lg-12">
                            <section class="panel">
                                <div class="container-fluid con_fluid_new">*@
                               
                                    <div class="panel-body">

                                        @*<div class="form-group">*@
                                        <div class="row">
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 dup_box1 ">
                                                <select id="ddlProjectStatus" data-placeholder="Select Project Status" class="form-control chosen-select ">
                                                    <option value="0"></option>
                                                    <option value="1">Active</option>
                                                    <option value="2">Completed</option>
                                                </select>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 dup_box2 ">

                                                <select id="ddlProject" data-placeholder="Select Project" class="form-control chosen-select "></select>
                                            </div>

                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 dup_box3">
                                                <select id="ddlInstaller" data-placeholder="Select Installer" class="form-control chosen-select"></select>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 dup_box4">
                                                <select id="ddlSearchFilter" data-placeholder="Select Field" class="form-control chosen-select ">
                                                    <option value="0"></option>
                                                    <option value="1">New Meter Number</option>
                                                    <option value="2">New Meter Radio Number</option>
                                                </select>
                                            </div>

                                        </div>
                                        @*<div class="form-group">*@
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12  col-sm-12 col-xs-12 dup_box5 text-center">
                                                <button id="btnSubmit" class="btn btn-success btn-lg " type="button">Submit</button>
                                                <button id="btnExport" class="btn btn-warning btn-lg " type="button">Export</button>
                                                <button id="btnReset" class="btn default btn-lg " type="button">Reset</button>
                                            </div>
                                        </div>

                                        @*<div class="form-group">*@
                                            <div class="table-responsive  rep_dyn_table">
                                                <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                                    <thead>
                                                        <tr>
                                                            <th width="5%">Account</th>
                                                            <th width="15%">Customer Name</th>
                                                            <th width="15%">Street</th>
                                                            <th width="10%">Installer</th>
                                                            <th width="15%">Visit Date</th>
                                                            <th width="10%">Old Meter Number</th>
                                                            <th width="10%">Old Meter Radio</th>
                                                            <th width="10%">New Meter Number</th>
                                                            <th width="10%">New Meter Radio</th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                            </div>
                                        @*</div>*@


                                    </div>
                                @*</div>
                            </section>
                        </div>
                    </div>*@

                </section>
            </div>

        </div>
    </section>


</section>



<link href="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.css")" rel="stylesheet" />
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.jquery.min.js")"></script>
<script src="@Url.Content("~/Content/MSTS/admin/chosenddl/chosen.proto.min.js")"></script>
<script src='@Url.Content("~/Scripts/Admin/DuplicateReport.js")'></script>

