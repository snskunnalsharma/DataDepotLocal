<body style='font-family:calibri;padding:0px; margin:0px auto; '>
    <div style="margin:0 auto;   width:100%; z-index: 1;">

        <div id="divsectionData" style="margin: 0px 20px;">
            @{
                var ss = Model;
                var listitem = ss.GroupBy(o => o.sectionName).ToList();

                var Servicecount = 0;
                var AdditionalServicecount = 0;
                var otherfieldcount = 0;

                System.Text.StringBuilder serviceString = new System.Text.StringBuilder();
                System.Text.StringBuilder AdditionalServiceString = new System.Text.StringBuilder();
                System.Text.StringBuilder otherfieldString = new System.Text.StringBuilder();
                String LatImagesrc = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + "/images/blueT.png";

                String MapPinsrc = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]);
                List<GarronT.CMS.Model.BO.CaptureGeoLocation> mapPinsList = new GarronT.CMS.Model.DAL.MobileDAL().GetGeoCaptureFields(@ViewBag.FormID);

                var showMap = @ViewBag.showMap;

                <h3 style="text-align: center;padding-left: 33px;color:#0094ff">@ViewBag.FormName</h3>
                <div id="abc" class="row" style="width:92.5%;">
                    @*<div class="col-lg-12 headername" style="text-align:right;">
                        <span class="headerTitle">Project Name- </span>@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@ViewBag.ProjectName.ToLower()))
                        </div>*@
                    <div class="col-lg-12 headername" style="text-align:right;">
                        <span class="headerTitle">Installer Name- </span>@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@ViewBag.InstallerName.ToLower()))
                    </div>
                    <div class="col-lg-12 headername" style="text-align:right;">
                        <span class="headerTitle">Service Date- </span>@ViewBag.ProjectDate
                    </div>

                </div>

                int _TotalItemCount = 0;
                <div class="table-responsive pdf-table-responsive">
                    @foreach (var item11 in listitem)
                    {
                        string sectionName = @item11.Select(o => o.sectionName).FirstOrDefault();

                        var Fieldsinsection = @item11.Select(o => o.FieldName).ToList();

                        <span class="sectionname">@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@sectionName.ToLower()))</span>
                        _TotalItemCount = 0;

                        <table border="0" style='font-family:calibri; border-radius:5px;margin-left:34px;width:90%;border-collapse:collapse;'>


                            @foreach (var item in item11)
                            {
                                _TotalItemCount++;


                                if (item.FieldName.ToLower() == "services")
                                {

                                    List<GarronT.CMS.Model.BO.ServicesModel> listService = new List<GarronT.CMS.Model.BO.ServicesModel>();
                                    //get the list of services along with images

                                    listService = new GarronT.CMS.Model.DAL.ReportDAL().getServicesWithImages(item.FieldValues, item.IDS, false);

                                    if (listService != null && listService.Count > 0)
                                    {

                                        int _selectedServiceCount = 0;
                                        foreach (GarronT.CMS.Model.BO.ServicesModel obj in listService)
                                        {
                                            _selectedServiceCount++;

                                            <tr style="page-break-inside:avoid;border:1px solid #000;">

                                                <td width='25%' class='FieldNametd' style='vertical-align:top;'> <span>@obj.Service</span></td>


                                                @if (obj.lisServiceAttachment != null)
                                                {
                                                    <td @*width='75%'*@ colspan="3" style="padding:5px;border-right: 1px solid #000 !important;">

                                                        @foreach (GarronT.CMS.Model.BO.ServiceAttachmentModel objServiceAttachment in obj.lisServiceAttachment)
                                                        {
                                                            if (objServiceAttachment.IsAudioVideoImage == 3)
                                                            {
                                                                String fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + objServiceAttachment.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                                                <img src='@fileName' height="180" width='210' />


                                                            }
                                                            else if (objServiceAttachment.IsAudioVideoImage == 2)
                                                            {
                                                                String fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + objServiceAttachment.strFilePath.Replace(@"..\", "").Replace(@"~\", "");


                                                                <a target="_new" href="@fileName" class="btn btn-link">Video</a>
                                                            }
                                                            else if (objServiceAttachment.IsAudioVideoImage == 1)
                                                            {
                                                                String fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + objServiceAttachment.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                                                <audio controls style="width:43px;">
                                                                    <source src="@fileName" type="audio/mp4">

                                                                    Your browser does not support the audio tag.
                                                                </audio>
                                                                @*<a target="_new" href="@fileName" class="btn btn-link">Audio</a>*@
                                                            }
                                                        }
                                                        @if (@item.Fieldlatitude != "")
                                                        {
                                                            <br />
                                                            var _path = mapPinsList.Where(a => a.FieldName == item.FieldName).Select(a => a.strImagePath).FirstOrDefault();
                                                            if (!string.IsNullOrEmpty(_path))
                                                            {
                                                                var mapimageurl = MapPinsrc + _path.ToString();
                                                                <img src='@mapimageurl' height='25' width='20' />


                                                                //<img src='@LatImagesrc' height='25' width='20' />

                                                                <span style='font-size:13px;'> @item.Fieldlatitude , @item.Fieldlongitude </span>
                                                            }
                                                        }
                                                    </td>
                                                }


                                            </tr>

                                            Servicecount = 0;
                                            serviceString.Remove(0, serviceString.Length);

                                        }
                                    }

                                }
                                else if (item.FieldName.ToLower() == "ADDITIONAL SERVICES".ToLower())
                                {

                                    List<GarronT.CMS.Model.BO.ServicesModel> listService = new List<GarronT.CMS.Model.BO.ServicesModel>();
                                    //get the list of services along with images
                                    listService = new GarronT.CMS.Model.DAL.ReportDAL().getServicesWithImages(item.FieldValues, item.IDS, false);
                                    if (listService != null && listService.Count > 0)
                                    {
                                        int _selectedServiceCount = 0;
                                        foreach (GarronT.CMS.Model.BO.ServicesModel obj in listService)
                                        {
                                            _selectedServiceCount++;

                                            <tr style="page-break-inside:avoid;border:1px solid #000;">
                                                @*@Html.Raw(AdditionalServiceString)*@

                                                <td width='25%' class='FieldNametd' style='vertical-align:top;'>
                                                    <span>@obj.Service</span>
                                                </td>

                                                <td width='75%' style="padding:5px;border-right: 1px solid #000 !important;" colspan="3">
                                                    @foreach (GarronT.CMS.Model.BO.ServiceAttachmentModel objServiceAttachment in obj.lisServiceAttachment)
                                                    {
                                                        if (objServiceAttachment.IsAudioVideoImage == 3)
                                                        {
                                                            String aditionalFileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + objServiceAttachment.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                                            <img src='@aditionalFileName' height="180" width='210' />


                                                        }
                                                        else if (objServiceAttachment.IsAudioVideoImage == 2)
                                                        {
                                                            String fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + objServiceAttachment.strFilePath.Replace(@"..\", "").Replace(@"~\", "");

                                                            <a target="_new" href="@fileName" class="btn btn-link">Video</a>

                                                        }
                                                        else if (objServiceAttachment.IsAudioVideoImage == 1)
                                                        {
                                                            String fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + objServiceAttachment.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                                            <audio controls @*style="width:43px;"*@>
                                                                <source src="@fileName" type="audio/mp4">
                                                                Your browser does not support the audio tag.
                                                            </audio>
                                                            @*<a target="_new" href="@fileName" class="btn btn-link">Audio</a>*@
                                                        }
                                                    }
                                                    @if (@item.Fieldlatitude != "")
                                                    {
                                                        <br />
                                                        var mapimageurl = MapPinsrc + mapPinsList.Where(a => a.FieldName == item.FieldName).Select(a => a.strImagePath).FirstOrDefault().ToString();
                                                        <img src='@mapimageurl' height='25' width='20' />
                                                        //<img src='@LatImagesrc' height='25' width='20' />
                                                        <span style='font-size:13px;'> @item.Fieldlatitude , @item.Fieldlongitude </span>
                                                    }
                                                </td>

                                            </tr>

                                            AdditionalServicecount = 0;
                                            AdditionalServiceString.Remove(0, AdditionalServiceString.Length);
                                        }
                                    }

                                }
                                else
                                {


                                    if (otherfieldcount == 0)
                                    {
                                        if (item.FieldName.ToLower() == "gps location" || item.FieldName.ToLower() == "LOCATION/GPS".ToLower())
                                        {
                                            if (item.Fieldlatitude != "")
                                            {
                                                var center = "center=" + item.Fieldlatitude + "," + item.Fieldlongitude + "";
                                                var lastlist = "&markers=" + item.Fieldlatitude + "," + item.Fieldlongitude + "";
                                                var center1 = item.Fieldlatitude + "," + item.Fieldlongitude;

                                                var locationPath = new GarronT.CMS.Model.DAL.ReportDAL().getLocationImage(item.IDS);
                                                if (!string.IsNullOrEmpty(locationPath))
                                                {
                                                    locationPath = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + locationPath.Replace(@"..\", "").Replace(@"~\", "");
                                                }
                                                else
                                                {
                                                    locationPath = "";
                                                }
                                                var link = "https://maps.googleapis.com/maps/api/staticmap?" + center + "&zoom=15" + lastlist + "&size=1236x493&sensor=FALSE&visual_refresh=true";
                                                otherfieldString.Append("<td width='25%' class='FieldNametd'>" + System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@item.FieldName.ToLower())) + "</td>");
                                                otherfieldString.Append("<td width='25%' class='FieldValuestd'>");


                                                otherfieldString.Append(" <img src='" + @locationPath + "' height='180' width='210' />");
                                                otherfieldString.Append(" <a href=\"https://maps.google.com/maps?q=" + @center1 + "\" target='_blank'>Map</a>");
                                                if (@item.isLaLongCaptureRequired == true && @item.Fieldlatitude != "")
                                                {
                                                    otherfieldString.Append("</br>");
                                                    // otherfieldString.Append("<img  src='" + @LatImagesrc + "' height='25' width='20' />");
                                                    otherfieldString.Append("<span style='font-size:13px;'>" + ((item.Fieldlatitude.Length > 14) ? (item.Fieldlatitude.Substring(0, 13)) : item.Fieldlatitude) + ", " + ((item.Fieldlongitude.Length > 14) ? (item.Fieldlongitude.Substring(0, 13)) : item.Fieldlongitude) + "</span>");
                                                }
                                                if (@item.isTimeStampCaptureRequired == true && !string.IsNullOrEmpty(@item.captureTimeStamp))
                                                {
                                                    otherfieldString.Append("<br>");
                                                    otherfieldString.Append("<span style='font-size:13px;'>" + DateTime.Parse(item.captureTimeStamp.ToString()).ToString("MMM-dd-yyyy hh:mm tt") + "</span>");
                                                }
                                                otherfieldString.Append("</td>");
                                            }
                                        }
                                        else
                                        {

                                            otherfieldString.Append("<td width='25%' class='FieldNametd'>" + System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@item.FieldName.ToLower())) + "</td>");
                                            if (@item.strFilePath != null)
                                            {
                                                otherfieldString.Append("<td width='25%' class='FieldValuestd'>");

                                                string[] strPathList = item.strFilePath.Split(',');
                                                foreach (var strPath in strPathList)
                                                {
                                                    var strpatharr = strPath.Split(';');
                                                    if (strpatharr.Length > 1 && strpatharr != null)
                                                    {
                                                        var isimageaudiovideo = strpatharr[0];

                                                        var strFilePath = strpatharr[1];

                                                        if (isimageaudiovideo == "3")
                                                        {
                                                            String aditionalFileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                                            //<img src='@aditionalFileName' height="150" width='180' />

                                                            otherfieldString.Append("<img src='" + @aditionalFileName + "' height='180' width='210' />");
                                                            otherfieldString.Append("</br>");
                                                        }
                                                    }

                                                }
                                                otherfieldString.Append("</td");
                                            }
                                            else
                                            {
                                                if (@item.FieldName.ToLower() == "work completed")
                                                {
                                                    otherfieldString.Append("<td width='25%' class='FieldValuestd'>" + (@item.FieldValues.ToLower() == "true" ? "Yes" : "No"));
                                                }
                                                else
                                                {
                                                    otherfieldString.Append("<td width='25%' class='FieldValuestd'>" + @item.FieldValues);
                                                }
                                            }
                                            if (@item.isLaLongCaptureRequired == true && @item.Fieldlatitude != "")
                                            {
                                                var mapimageurl = @MapPinsrc + @mapPinsList.Where(a => a.FieldName == item.FieldName).Select(a => a.strImagePath).FirstOrDefault().ToString();
                                                otherfieldString.Append("</br>");
                                                otherfieldString.Append("<img src='" + @mapimageurl + "' height='25' width='20' />");
                                                //otherfieldString.Append("<img src='" + @LatImagesrc + "' height='25' width='20' />");
                                                otherfieldString.Append("<span style='font-size:13px;'>" + ((item.Fieldlatitude.Length > 14) ? (item.Fieldlatitude.Substring(0, 13)) : item.Fieldlatitude) + ", " + ((item.Fieldlongitude.Length > 14) ? (item.Fieldlongitude.Substring(0, 13)) : item.Fieldlongitude) + "</span>");
                                            }
                                            if (@item.isTimeStampCaptureRequired == true && !string.IsNullOrEmpty(@item.captureTimeStamp))
                                            {
                                                otherfieldString.Append("<br>");
                                                otherfieldString.Append("<span style='font-size:13px;'>" + DateTime.Parse(item.captureTimeStamp.ToString()).ToString("MMM-dd-yyyy hh:mm tt") + "</span>");
                                            }

                                            otherfieldString.Append("</td>");


                                        }

                                        otherfieldcount++;
                                        if (item11.ToList().Count == _TotalItemCount)
                                        {
                                            <tr style="page-break-inside:avoid;border:1px solid #000;">
                                                @Html.Raw(otherfieldString)

                                                <td width='25%' class='FieldNametd'>&nbsp;&nbsp;</td>

                                                <td width='25%' class='FieldValuestd'>&nbsp;&nbsp;</td>
                                            </tr>

                                            otherfieldcount = 0;
                                            otherfieldString.Remove(0, otherfieldString.Length);
                                        }


                                    }
                                    else if (otherfieldcount == 1)
                                    {
                                        System.Text.StringBuilder otherfieldString1 = new System.Text.StringBuilder();
                                        <tr style="page-break-inside:avoid;border:1px solid #000;">

                                            @Html.Raw(otherfieldString)

                                            @if (item.FieldName.ToLower() == "gps location" || item.FieldName.ToLower() == "LOCATION/GPS".ToLower())
                                            {
                                                if (@item.Fieldlatitude != "")
                                                {
                                                    var center = "center=" + item.Fieldlatitude + "," + item.Fieldlongitude + "";
                                                    var lastlist = "&markers=" + item.Fieldlatitude + "," + item.Fieldlongitude + "";

                                                    var demo = "https://maps.googleapis.com/maps/api/staticmap?key=" + Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["googleapiKey"]) + center + " &zoom=13&size=200x200&maptype=roadmap" + lastlist + "&sensor=false";
                                                    var link = "https://maps.googleapis.com/maps/api/staticmap?" + center + "&zoom=15" + lastlist + "&size=1236x493&sensor=FALSE&visual_refresh=true";
                                                    var center1 = item.Fieldlatitude + "," + item.Fieldlongitude;

                                                    var locationPath = new GarronT.CMS.Model.DAL.ReportDAL().getLocationImage(item.IDS);
                                                    if (!string.IsNullOrEmpty(locationPath))
                                                    {
                                                        locationPath = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + locationPath.Replace(@"..\", "").Replace(@"~\", "");
                                                    }
                                                    else
                                                    {
                                                        locationPath = "";
                                                    }

                                                    <td width='25%' class='FieldNametd'>@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@item.FieldName.ToLower())) </td>
                                                    <td width='25%' class='FieldValuestd'>
                                                        <img src='@locationPath' height='180' width='210' />
                                                        <a href='https://maps.google.com/maps?q=@center1' target='_blank'>Map</a>
                                                        @if (item.Fieldlatitude != "")
                                                        {
                                                            <br />
                                                            var _path = mapPinsList.Where(a => a.FieldName == item.FieldName).Select(a => a.strImagePath).FirstOrDefault();
                                                            if (!string.IsNullOrEmpty(_path))
                                                            {
                                                                var mapimageurl = MapPinsrc + _path;
                                                                <img src='@mapimageurl' height='25' width='20' />
                                                                //<img src='@LatImagesrc' height='25' width='20' />
                                                                <span style='font-size:13px;'> @((item.Fieldlatitude.Length > 14) ? (item.Fieldlatitude.Substring(0, 13)) : item.Fieldlatitude) , @((item.Fieldlongitude.Length > 14) ? (item.Fieldlongitude.Substring(0, 13)) : item.Fieldlongitude) </span>

                                                            }
                                                        }
                                                        @if (item.isTimeStampCaptureRequired == true && !string.IsNullOrEmpty(item.captureTimeStamp))
                                                        {
                                                            <br />
                                                            <span style='font-size:13px;'>  @DateTime.Parse(item.captureTimeStamp.ToString()).ToString("MMM-dd-yyyy hh:mm tt")   </span>
                                                        }
                                                    </td>

                                                }
                                            }
                                            else
                                            {

                                                <td width='25%' class='FieldNametd'>@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@item.FieldName.ToLower())) </td>
                                                if (@item.strFilePath != null)
                                                {
                                                    otherfieldString1.Append("<td width='25%' class='FieldValuestd'>");

                                                    string[] strPathList = item.strFilePath.Split(',');
                                                    foreach (var strPath in strPathList)
                                                    {
                                                        var strpatharr = strPath.Split(';');
                                                        if (strpatharr.Length > 1 && strpatharr != null)
                                                        {
                                                            var isimageaudiovideo = strpatharr[0];

                                                            var strFilePath = strpatharr[1];

                                                            if (isimageaudiovideo == "3")
                                                            {
                                                                String aditionalFileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + strFilePath.Replace(@"..\", "").Replace(@"~\", "");


                                                                otherfieldString1.Append("<img src='" + @aditionalFileName + "' height='180' width='210' />");
                                                                otherfieldString1.Append("</br>");
                                                            }
                                                        }

                                                    }
                                                    otherfieldString1.Append("</td");
                                                }
                                                else
                                                {
                                                    if (@item.FieldName.ToLower() == "work completed")
                                                    {
                                                        otherfieldString1.Append("<td width='25%' class='FieldValuestd'>" + (@item.FieldValues.ToLower() == "true" ? "Yes" : "No"));
                                                    }
                                                    else
                                                    {
                                                        otherfieldString1.Append("<td width='25%' class='FieldValuestd'>" + @item.FieldValues);
                                                    }
                                                }
                                                if (@item.isLaLongCaptureRequired == true && @item.Fieldlatitude != "")
                                                {
                                                    otherfieldString1.Append("</br>");
                                                    var mapimageurl = @MapPinsrc + @mapPinsList.Where(a => a.FieldName == item.FieldName).Select(a => a.strImagePath).FirstOrDefault().ToString();
                                                    otherfieldString1.Append("<img src='" + @mapimageurl + "' height='25' width='20' />");
                                                    //otherfieldString1.Append("<img src='" + @LatImagesrc + "' height='25' width='20' />");
                                                    otherfieldString1.Append("<span style='font-size:13px;'>" + ((item.Fieldlatitude.Length > 14) ? (item.Fieldlatitude.Substring(0, 13)) : item.Fieldlatitude) + ", " + ((item.Fieldlongitude.Length > 14) ? (item.Fieldlongitude.Substring(0, 13)) : item.Fieldlongitude) + "</span>");
                                                }

                                                if (@item.isTimeStampCaptureRequired == true && !string.IsNullOrEmpty(@item.captureTimeStamp))
                                                {
                                                    otherfieldString1.Append("</br>");
                                                    otherfieldString1.Append("<span style='font-size:13px;'>" + DateTime.Parse(item.captureTimeStamp.ToString()).ToString("MMM-dd-yyyy hh:mm tt") + "</span>");
                                                }
                                                @Html.Raw(otherfieldString1)
                                            }

                                        </tr>

                                        otherfieldcount = 0;
                                        otherfieldString.Remove(0, otherfieldString.Length);
                                    }
                                }
                            }
                        </table>


                    }
                    @{

                        if (showMap)
                        {
                            var MultipleMapPinsPath = "";
                            var allmapPin = new GarronT.CMS.Model.DAL.ReportDAL().getMultipleMapPins(@ViewBag.UploadID, @ViewBag.FormID);
                            if (!string.IsNullOrEmpty(allmapPin))
                            {
                                MultipleMapPinsPath = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + allmapPin.Replace(@"..\", "").Replace(@"~\", "");
                            }
                            else
                            {
                                MultipleMapPinsPath = "";
                            }
                            if (!string.IsNullOrEmpty(allmapPin))
                            {
                                <span class="sectionname">Map</span>
                                <table border="0" style='font-family:calibri; border-radius:5px;margin-left:34px;width:90%;border-collapse:collapse;'>
                                    <tr style="page-break-inside:avoid;border:1px solid #000;">

                                        <td width='25%' class='FieldNametd' style='vertical-align:top;'> <span>Map</span></td>
                                        <td colspan="3" style="padding:5px;border-right: 1px solid #000 !important;">
                                            <img src="@MultipleMapPinsPath" height="400" width="600">
                                        </td>
                                    </tr>
                                </table>
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>

</body>
