@model GarronT.CMS.Model.BO.ReportSkipRTUModel

@{
    ViewBag.Title = "";
    Layout = "";
}
<script src="~/Content/MSTS/admin/js/jquery.js"></script>
<link href="~/Content/MSTS/admin/admin/css/bootstrap.css" rel="stylesheet" />
<link href="~/Content/MSTS/admin/css/bootstrap.min.css" rel="stylesheet" />



<style>












    .fieldname {
        text-align: left;
        width: 20%;
        padding: 5px;
        font-family: Arial;
        font-size: 14px;
    }

    .fieldData {
        width: 80%;
        padding: 5px;
    }

    .formname {
        font-family: Arial;
        font-size: 18px;
        color: #0094ff;
    }

    .sectionname {
        padding-left: 36px;
        color: #0094ff;
        font-size: 17px;
    }

    .headerTitle {
        font-size: 14px;
    }

    .FieldNametd {
        padding: 5px;
        border-right: 1px solid #000;
        /*background-color: #fbd3b5;*/
        color: #000000;
        font-size: 13px;
        font-weight: bold;
    }

    .FieldValuestd {
        padding: 5px;
        border-right: 1px solid #000;
        color: #000000;
        font-size: 13px;
    }
    .pdf-video-btn{
            margin-top: 0px;`
            margin-left: auto;
            width: 9%;
    }
        @@media (max-width:320px) {
        .pdf-video-btn {
             width: 20%;
        }
    }
        @@media only screen and (min-width:321px)and (max-width:359px){
         .pdf-video-btn {
              width: 20%;
        }
     }
        @@media only screen and (min-width: 360px) and (max-width:410px){
         .pdf-video-btn {
              width: 20%;
        }
    }
        @@media only screen and (min-width: 411px) and (max-width:429px) {
         .pdf-video-btn {
              width: 20%;
        }
    }
        @@media only screen and (min-width:430px)and (max-width:479px) {
         .pdf-video-btn {
              width: 20%;
        }
    }
        @@media only screen and (min-width:480px)and (max-width:530px) and (orientation:landscape) {
         .pdf-video-btn {
              width: 20%;
        }
    }
        @@media only screen and (min-width:480px)and (max-width:530px) and (orientation:portrait) {
         .pdf-video-btn {
              width: 20%;
        }
    }
        @@media only screen and (min-width:531px)and (max-width:567px) {
            .pdf-video-btn {
              width: 20%;
            }
        }
         @@media only screen and (min-width:568px)and (max-width:599px) {
            .pdf-video-btn {
              width: 20%;
            }
        }
        @@media only screen and (min-width:600px)and (max-width:640px) and (orientation:landscape) {
         .pdf-video-btn {
              width: 20%;
         }
      }
        @@media only screen and (min-width:600px)and (max-width:640px) and (orientation:portrait) {
         .pdf-video-btn {
              width: 20%;
        }
      }
        @@media only screen and (min-width:641px) and (max-width:710px)  {
             .pdf-video-btn {
                  width: 20%;
              }
        }
        @@media only screen and (min-width:711px) and (max-width:767px)  {
             .pdf-video-btn {
                  width: 20%;
              }
        }
        @@media only screen and (min-width:768px) and (max-width:799px)  {
         .pdf-video-btn {
              width: 20%;
        }
    }
        @@media only screen and (min-width:800px) and (max-width:840px)  {
         .pdf-video-btn {
              width: 15%;
        }
    }







</style>

<body style='font-family:calibri;padding:20px 0px; margin:0px auto; '>
    <div style="margin:0 auto;   width:100%; z-index: 1;">

        <div id="divsectionData" style="margin: 0px 20px;">
            @{
                <h3 style="text-align: center;padding-left: 33px;color:#0094ff">@ViewBag.ProjectName</h3>
                @*<div id="abc" class="row" style="width:92.5%;">
                    <div class="col-lg-12 headername" style="text-align:right;">
                        <span class="headerTitle">Installer Name- </span>@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@ViewBag.InstallerName.ToLower()))
                    </div>
                    <div class="col-lg-12 headername" style="text-align:right;">
                        <span class="headerTitle">Service Date- </span>@ViewBag.ProjectDate
                    </div>
                </div>*@

                <table border="0" style='font-family:calibri; border-radius:5px;margin-left:34px;width:90%;border-collapse:collapse;'>
                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Installer Name</td>

                        <td width='25%' class='FieldValuestd'>@System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase((@ViewBag.InstallerName.ToLower()))</td>

                        <td width='25%' class='FieldNametd'>Service Date</td>

                        <td width='25%' class='FieldValuestd'>@ViewBag.ProjectDate</td>
                    </tr>

                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Account</td>

                        <td width='25%' class='FieldValuestd'>@Model.Account</td>

                        <td width='25%' class='FieldNametd'>Address</td>

                        <td width='25%' class='FieldValuestd'>@Model.Street</td>
                    </tr>

                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Form Name</td>

                        <td width='25%' class='FieldValuestd'>@Model.FormName</td>

                        <td width='25%' class='FieldNametd'>Cycle</td>

                        <td width='25%' class='FieldValuestd'>@Model.Cycle</td>
                    </tr>

                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Route</td>

                        <td width='25%' class='FieldValuestd'>@Model.Route</td>

                        <td width='25%' class='FieldNametd'>Installer</td>

                        <td width='25%' class='FieldValuestd'>@Model.FirstName</td>
                    </tr>

                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Status</td>

                        <td width='25%' class='FieldValuestd' style="color:red;font:bold !important">@Model.CategoryType</td>

                        <td width='25%' class='FieldNametd'>Visit Date Time</td>

                        <td width='25%' class='FieldValuestd'>@Model.Dates</td>
                    </tr>

                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Reason</td>

                        <td width='25%' class='FieldValuestd'>@Model.SkipReason</td>

                        <td width='25%' class='FieldNametd'>Comment</td>

                        <td width='25%' class='FieldValuestd'>@Model.SkipComment</td>
                    </tr>

                    <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Location/GPS</td>
                        <td width='75%' style="padding:5px;border-right: 1px solid #000 !important;" colspan="3" class='FieldValuestd'>

                            @{
                                String LatImagesrc = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + "/images/blueT.png";
                                if (@Model.CategoryType.ToLower() == "skip" || @Model.CategoryType.ToLower() == "SKIP" || @Model.CategoryType.ToLower() == "rtu" || @Model.CategoryType.ToLower() == "RTU")
                                {
                                    System.Text.StringBuilder otherfieldString = new System.Text.StringBuilder();

                                    GarronT.CMS.Model.BO.SkipRtuAttachmentModel AttachementList =
                                    new GarronT.CMS.Model.DAL.ReportDAL().getGPSLocationImages(Model.ID, Model.InstallerId, Model.FormId);
                                    GarronT.CMS.Model.BO.SkipRtuAttachmentModel objCloudeAttachementList1 =
                                    new GarronT.CMS.Model.DAL.ReportDAL().getCloudGPSLocationImages(Model.ID, Model.InstallerId, Model.FormId);
                                    bool status = false;
                                    String aditionalFileName = String.Empty;
                                    if (objCloudeAttachementList1.strCloudUrl != null && objCloudeAttachementList1.IsAudioVideoImage == 3)
                                    {
                                        aditionalFileName = objCloudeAttachementList1.strCloudUrl;
                                        status = true;
                                    }
                                    else if (AttachementList.strFilePath != null && AttachementList.IsAudioVideoImage == 3)
                                    {
                                        aditionalFileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + AttachementList.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                        status = true;
                                    }
                                    if (status)
                                    {

                                        var center = "center=" + @Model.Latitude + "," + @Model.Longitude + "";
                                        var lastlist = "&markers=" + @Model.Latitude + "," + @Model.Longitude + "";
                                        var center1 = @Model.Latitude + "," + @Model.Longitude;
                                        var link = "https://maps.googleapis.com/maps/api/staticmap?" + center + "&zoom=15" + lastlist + "&size=1236x493&sensor=FALSE&visual_refresh=true";
                                        <img src='@aditionalFileName' height="180" width='210' />
                                        <a href='https://maps.google.com/maps?q=@center1' target='_blank'>Map</a>

                                        <br />
                                        <img src='@LatImagesrc' height='13' width='13' />
                                        <span style='font-size:14px;'> @((@Model.Latitude.Length > 14) ? (@Model.Latitude.Substring(0, 13)) : @Model.Latitude) , @((@Model.Longitude.Length > 14) ? (@Model.Longitude.Substring(0, 13)) : @Model.Longitude) </span>
                                        <br />
                                        <span style='font-size:14px;'>@Model.Dates</span>
                                    }
                                }
                                }
                                    
                                }
                        </td>

                        <tr style="page-break-inside:avoid;border:1px solid #000;">
                        <td width='25%' class='FieldNametd'>Media</td>
                        <td width='75%' style="padding:5px;border-right: 1px solid #000 !important;" colspan="3" class='FieldValuestd'>
                            @{
                                List<GarronT.CMS.Model.BO.SkipRtuAttachmentModel> objAttachementList =
                                                                                    new GarronT.CMS.Model.DAL.ReportDAL().getSkipRtuImages(Model.ID, Model.InstallerId, Model.FormId);
                                if (objAttachementList != null && objAttachementList.Count > 0)
                                {
                                    foreach (GarronT.CMS.Model.BO.SkipRtuAttachmentModel obj1 in objAttachementList)
                                    {
                                        if (obj1.IsAudioVideoImage == 2)
                                        {
                                            String fileName = String.Empty;
                                            if (obj1.strCloudUrl != null && obj1.strCloudUrl != "")
                                            {
                                                fileName = obj1.strCloudUrl;
                                            }
                                            else
                                            {
                                                fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + obj1.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                            }
                                            <a target="_new" href="@fileName" class="btn btn-info pdf-video-btn">Video</a>
                                        }
                                        else if (obj1.IsAudioVideoImage == 1)
                                        {
                                            String fileName = String.Empty;
                                            if (obj1.strCloudUrl != null && obj1.strCloudUrl != "")
                                            {
                                                fileName = obj1.strCloudUrl;
                                            }
                                            else
                                            {
                                                fileName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["WebURL"]) + obj1.strFilePath.Replace(@"..\", "").Replace(@"~\", "");
                                                @*<audio controls  style="width:43px;">
                                                <source src="@fileName" type="audio/mp4">
                                                Your browser does not support the audio tag.
                                                </audio>*@
                                            }
                                             <a target="_new" href="@fileName" class="btn btn-link">Audio</a>
                                        }
                                    }
                                }
                        }
                        </td>
                    </tr>
                </table>
                }
        </div>
    </div>
</body>
