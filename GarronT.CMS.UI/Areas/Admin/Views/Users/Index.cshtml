<!-- page start-->


<section id="main-content">
    <section class="wrapper">
        <!-- page start-->
        <div class="row">
            <div class="col-sm-12">
                <section class="panel">
                    <header class="panel-heading">
                        <b>User Master </b>
                    </header>
                    <div class="panel-body">
                        <div class="adv-table">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-xs-4 add_newbtn">

                                    <a class="btn btn-warning" data-backdrop="static" id="btnAddUser">
                                        <span class="icon">
                                            <i class="fa fa-plus"></i>
                                        </span>
                                        <span>Add New</span>
                                    </a>
                                </div>
                                <div class="col-lg-8 col-md-8 col-xs-8 show_deactive deactivated_records">
                                    <input type="checkbox" name="showDeactivate" id="chkShowDeactivate" />Show Deactivated Records
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="dynamic-table" class="display table table-bordered table-striped dataTable" aria-describedby="dynamic-table_info">
                                    <thead>
                                        <tr>
                                            <th width="20%">Login Id</th>
                                            <th width="25%">Name</th>
                                            <th width="20%">Role</th>
                                            <th width="15%">Email ID</th>
                                            <th width="10%">Mobile No</th>
                                            <th width="10%">Action</th>
                                        </tr>
                                    </thead>

                                </table>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</section>
<!-- Modal for Add /Edit Dialog -->
<div class="modal fade modal-dialog-center" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content-wrap">
            <div class="modal-content edt_usr_modal">
                <div class="modal-header usr_header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Add New User</h4>
                </div>
                <div class="modal-body usr_modal_body">
                    <div class="panel-body">
                        <form id="form3" class="cmxform form-horizontal tasi-form">
                            <fieldset>
                                <legend>Personal Information</legend>
                                <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_nm">
                                    @*<label for="name" class="col-lg-2">Name <span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6 col-xs-12 ">
                                        <label for="name" class="edt_nm">Name <span style="color:red">*</span></label>
                                        <input type="text" name="UserFullName" id="txtUserFullName" maxlength="201" class="nm_txt" />
                                    </div>
                                    @*<label for="name" class="col-lg-3">Login Id <span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6 col-xs-12 ">
                                        <label for="name" class="edt_log">Login Id <span style="color:red">*</span></label>
                                        <input type="hidden" name="UserId" id="txtUserId" />
                                        <input type="text" name="LogInId" id="txtLogInId" maxlength="200" class="log_txt" />
                                    </div>
                                </div>
                                <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_pswd">
                                    @*<label for="name" class="col-lg-2">Password <span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6 col-xs-12">
                                        <label for="name" class="edt_pswd">Password <span style="color:red">*</span></label>

                                        <input type="password" name="password" id="txtPassword" maxlength="50" class="pswd_txt" />
                                    </div>
                                    @*<label for="name" class="col-lg-3">Re-enter Password <span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6 col-xs-12 rent_pswd">
                                        <label for="name" class="edt_repswd">Re-enter Password <span style="color:red">*</span></label>
                                        <input type="password" name="Confirmpassword" id="txtConfirmPassword" maxlength="50" class="repswd_txt" />
                                    </div>
                                </div>
                                <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_addr">
                                    @*<label for="name" class="col-lg-2">Address </label>*@
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_addr">Address </label>
                                        <input type="text" name="Address" id="txtUserAddress" maxlength="200" class="adddr_txt" />
                                    </div>
                                    @*<label for="name" class="col-lg-3">Email Id<span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_email">Email Id<span style="color:red">*</span></label>
                                        <input type="text" name="Email" id="txtEmail" class="mail_txt" />
                                    </div>

                                </div>


                                <div class="form-group col-lg-12 col-sm-12 col-xs-12">

                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_State">State</label>
                                        <select data-placeholder="Select State" id="ddlState" style="width:100%" name="StateID" class=" form-control chosen-select"></select>

                                    </div>
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_City">City </label>
                                        <select data-placeholder="Select City" id="ddlCity" name="CityID" class="  chosen-select"></select>
                                    </div>
                                </div>

                                <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_City">
                                    @*<label for="name" class="col-lg-2">Address </label>*@
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_Zip">Zip </label>
                                        <input type="text" name="ZipCode" id="txtZip" maxlength="6" minlength="6" class="Zip_txt Numeric-Only" />
                                    </div>
                                    @*<label for="name" class="col-lg-3">Email Id<span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_Gender">Gender</label>
                                        <select data-placeholder="Select Gender" id="ddlGender" name="Gender" class="Gender_txt chosen-select">
                                            <option value=""></option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        </select>
                                    </div>

                                </div>

                                <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">
                                    @*<label for="name" class="col-lg-2">Mobile No. <span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_mob">Mobile No. <span style="color:red">*</span></label>
                                        <input type="text" name="MobileNo" id="txtMobileNo" maxlength="15" class="mob_txt Numeric-Only" />
                                    </div>
                                    @*<label for="name" class="col-lg-3">Role <span style="color:red">*</span></label>*@
                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_HomePhone">Home Phone No.</label>
                                        <input type="text" name="HomePhoneNumber" id="txtHomePhoneNumber" maxlength="200" class="HomePhone_txt Numeric-Only" />
                                    </div>
                                </div>
                                <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">

                                    <div class="col-lg-6 col-sm-6">
                                        <label for="name" class="edt_rle">Role <span style="color:red">*</span></label>
                                        <input type="hidden" name="PrimaryRoleId" id="txtPrimaryRoleId" class="rle_txt" />
                                        <select id="ddlPrimaryRole" name="PrimaryRole" class="role_drp_btn" style="display:none; text-align:left" multiple="multiple"></select>
                                    </div>
                                </div>



                            </fieldset>
                            <br />
                            <div id="installerDiv" style="padding: 0px 5px 0px 5px;">
                                <fieldset>
                                    <legend>Vehicle Information</legend>
                                    <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">
                                        @*<label for="name" class="col-lg-2">Mobile No. <span style="color:red">*</span></label>*@
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Make">Make</label>
                                            <input type="text" name="VehicleMake" id="txtMake" maxlength="200" class="Make_txt" />
                                        </div>
                                        @*<label for="name" class="col-lg-3">Role <span style="color:red">*</span></label>*@
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Model">Model</label>
                                            <input type="text" name="VehicleModel" id="txtModel" maxlength="200" class="Model_txt" />
                                        </div>
                                    </div>

                                    <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Year">Year</label>
                                            <input type="text" name="VehicleYear" id="txtYear" maxlength="200" class="Year_txt" />
                                        </div>
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_LicensePlateNumber">License Plate Number</label>
                                            <input type="text" name="VehicleLicensePlateNumber" id="txtLicensePlateNumber" maxlength="200" class="LicensePlateNumber_txt" />
                                        </div>
                                    </div>

                                    <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Vehicle">Vehicle</label>
                                            <input type="text" name="Vehicle" id="txtVehicle" maxlength="200" class="Vehicle_txt" />
                                        </div>
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Color">Color</label>
                                            <input type="text" name="VehicleColor" id="txtColor" maxlength="200" class="Color_txt" />
                                        </div>


                                    </div>

                                    <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_ImageofVehicle">Image of Vehicle</label>
                                            <input type="text" name="ImageofVehicle" id="txtImageofVehicle" maxlength="200" class="ImageofVehicle_txt" />
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                            <div id="EmploymentDetailsDiv" style="padding: 0px 5px 0px 5px;">
                                <fieldset>
                                    <legend>Employment Details</legend>
                                    <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">

                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Make">Job Type</label>
                                            <input type="text" name="JobType" id="txtJobType" maxlength="200" class="" />
                                        </div>


                                    </div>
                                    <div class="form-group col-lg-12 col-sm-12 col-xs-12 usr_mob">
                                        <div class="col-lg-6 col-sm-6">
                                            <label for="name" class="edt_Make">Services</label>
                                        </div>
                                    </div>
                                    <div id="servicesDiv"></div>

                                </fieldset>
                            </div>

                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSave" class="btn btn-success" type="button">Save</button>
                    <button class="btn btn-danger" id="btnCancel" type="button">Cancel</button>
                    <button class="btn btn-default" id="btnReset" type="button">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>
