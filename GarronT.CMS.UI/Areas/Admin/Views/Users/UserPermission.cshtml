<section id="main-content">
    <section class="wrapper">
        <!-- page start-->

        <section class="panel">
            <header class="panel-heading">
                <b>Rights</b>

            </header>
            <div class="panel-body">

                @{
                    var vievmodel = Model;
                    var updatepermission = vievmodel.UpdatePermission;
                    var updatemessage = vievmodel.UpdateMessage;
                    if (updatepermission == false)
                    {


                        <legend>
                            <h4>
                                Permissions
                            </h4>
                        </legend>


                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4 col-xxs-12 xxs-mbot2">
                                <input type="hidden" name="userId" id="txtUserId" value="@ViewBag.UserId" />
                                <input type="button" class="btn btn-success" value="Update Permission" id="btnUpdate" />
                                <a class="btn btn-success" target="_self" id="btnback" href="@Url.Action("Index", "Users", new { area = "Admin" })">
                                    Back
                                </a>
                            </div>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8 col-xxs-12 text-right">
                                <span class="permission-icon-info">
                                    <i class="fa fa-eye"></i> View
                                    &nbsp;&nbsp;<i class="fa fa-plus"></i>  Add
                                    &nbsp;&nbsp;<i class="fa fa-pencil"></i>  Edit
                                    &nbsp;&nbsp; <i class="fa fa-trash" aria-hidden="true"></i> Delete
                                </span>
                            </div>
                        </div>
                        <div class="row">
                            <div style="text-align:center">
                                User Name- @ViewBag.userName
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 col-xxs-3"></div>
                            <div class="col-lg-6 col-md-8 col-sm-10 col-xs-10 col-xxs-12">
                                <div class="table-responsive">
                                    <table id="PermissionTable" style="" class="table table-advance table-condensed table-hover table-bordered ">


                                        <thead>
                                        <th>
                                            Permission
                                        </th>
                                        @{

                        var obj = (GarronT.CMS.Model.BO.UserAspNetPermissionVM)Model;
                        foreach (GarronT.CMS.Model.AspNetRole role in obj.AspNetRoleList.Where(a => a.IsSysAdmin != true).ToList())
                        {
                            <th style="text-align:center">
                                <div class="RName">@role.Name</div>

                                <table class="table-bordered">
                                    <thead>
                                    <th style="width:3%;text-align:center;"><i class="fa fa-eye"></i></th>
                                    <th style="width:3%;text-align:center;"><i class="fa fa-plus"></i></th>
                                    <th style="width:3%;text-align:center;"><i class="fa fa-pencil"></i></th>
                                    <th style="width:5%;text-align:center;"><i class="fa fa-trash"></i></th>
                                    </thead>

                                </table>
                            </th>
                        }

                                        }

                                        </thead>
                                        @foreach (GarronT.CMS.Model.AspNetPermission item in Model.AspNetPermissionList)
                                        {

