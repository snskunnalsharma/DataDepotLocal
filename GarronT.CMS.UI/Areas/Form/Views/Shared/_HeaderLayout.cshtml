<header class="header white-bg">
    <div class="header_box">
        <div class="sidebar-toggle-box">
            <div class="fa fa-bars tooltips" data-placement="right" data-original-title="Toggle Navigation"></div>
        </div>
        <!--logo start-->
        <a href="@Url.Action("Index", "Home", new { area = "" }) " class=" logo"><img src=@Url.Content("~/images/logo.png")></a>

        @if (@User.IsInRole("Super Admin"))
        {
            <a href="@Url.Action("Index", "Home", new { area = "" }) " class=" logo"><img src=@Url.Content("~/images/logo.png")></a>
        }

        @if (@User.IsInRole("Company Admin"))
        {
            //<span style="color:#fff;font-size:14px;" class="a_demo"><b>Modules :- @Session["ModuleType"]</b></span>


            <a href="@Url.Action("dashboard", "Home", new { area = "Companyadmin" }) " class=" logo" style="width:140px; height:60px;"><img src="@Session["CompanyLogo"]" style="height:40px !important; width:280px;" /></a>
        }


        <!--logo end-->
        <div class="nauser login dropdown startv notify-row" id="top_menu">

        </div>
    </div>
    <div class="top-nav">
        <div class="heading_top">



        </div>


      




        <!--search & user info start-->
        <ul class="nav pull-right top-menu" style="margin-top:5px; margin-right: 23px;">
      
            <li class="dropdown">



                <a data-toggle="dropdown" class="dropdown-toggle" href="#">


                    @*<i class="fa fa-user"></i> <span class="username">@User.Identity.Name.ToString()</span>*@<i class="fa fa-user"></i><span class="username"></span>
                    Hi, <span class="username"> @Convert.ToString(User.Identity.Name)</span>
                    <b class="caret"></b>
                    @*Jhon Doue*@
                </a>
                <ul class="dropdown-menu extended logout">
                    <div class="log-arrow-up"></div>
                    <li><a href="#"><i class=" fa fa-suitcase"></i>Profile</a></li>
                    <li><a href="#"><i class="fa fa-cog"></i> Settings</a></li>
                    @*<li><a href="#"><i class="fa fa-bell-o"></i> Notification</a></li>*@
                    <li><a href="#"><i class="fa fa-bell-o"></i></a></li>
                    <li><a href="@Url.Action("logoff", "Login" , new { @area="Global" })"><i class="fa fa-key"></i> Log Out</a></li>
                </ul>
            </li>


            <!-- user login dropdown end -->
        </ul>
        <!--search & user info end-->



       
          




        <div class="form-inline_top">

            <div class="form-group ">
                <label style="color:#fff;">Status </label>

                <select name="Client" id="MasterClient" class="form-control">
                    <option value="1">--Select Status--</option>
                    <option value="2">Active</option>
                    <option value="3">Completed</option>
                </select>
            </div>


            <div class="form-group ">

                <label style="color:#fff;"> Current City</label>

                <select name="Client" id="MasterClient" class="form-control">
                    <option value="0">--Select--</option>
                    <option value="1">ABBOTT, Texas</option>
                    <option value="2">ALEDO, Texas</option>
                    <option value="3">ATLANTA, Texas</option>
                    <option value="4">BELMONT, Texas</option>
                    <option value="5">BIVINS, Texas</option>
                    <option value="6">BOWIE, Texas</option>
                    <option value="7">CUSHING, Texas</option>
                    <option value="8">FLINT, Texas</option>
                    <option value="9">LINN, Texas</option>
                </select>
            </div>


            <div class="form-group ">

                <label style="color:#fff;">
                    Project
                </label>

                <select name="Client" id="MasterClient" class="form-control">
                    <option value="0">--Select--</option>
                    <option value="1">Sample Project 1</option>
                    <option value="2">Sample Project 2</option>
                    <option value="3">Sample Project 3</option>
                </select>
            </div>

        </div>


           
    </div>
</header>
